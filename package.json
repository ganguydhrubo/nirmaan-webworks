{
  "name": "atittle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/validate-release.mjs && astro check && tsc -p tsconfig.client.json && astro build",
    "build:preview": "node scripts/validate-release.mjs --preview && astro check && tsc -p tsconfig.client.json && astro build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "astro": "astro",
    "check": "astro check && tsc -p tsconfig.client.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply atittle_leads --local",
    "db:migrate:remote": "wrangler d1 migrations apply atittle_leads --remote",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.10",
    "astro": "^7.3.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "eslint": "^9.20.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260911.1": true
  }
}
