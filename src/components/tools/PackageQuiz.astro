---
interface Props {
  id?: string;
  class?: string;
}

const { id = "package-quiz", class: className = "" } = Astro.props;
---

<section id={id} class:list={["package-quiz-section relative overflow-hidden py-14 sm:py-20 bg-ink-50 border-t border-ink-200", className]}>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8" data-quiz-root>
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 rounded-full bg-brand-100 border border-brand-300 px-3.5 py-1.5 text-xs font-semibold text-brand-800 mb-3 tracking-wide uppercase">
        <span class="inline-block w-2 h-2 rounded-full bg-brand-600"></span>
        45-Second Scope Matcher
      </div>
      <h2 class="font-display text-2xl sm:text-4xl font-semibold tracking-tight text-ink-950">
        Which package fits your business?
      </h2>
      <p class="mt-3 text-sm sm:text-base text-ink-700 leading-relaxed max-w-xl mx-auto">
        No sales calls or hidden surprises. Answer 4 quick questions to get an instant scope breakdown and transparent rupee estimate.
      </p>
    </div>

    <!-- Quiz Card -->
    <div class="rounded-2xl border border-ink-300 bg-white p-5 sm:p-8 shadow-lg">
      <!-- Progress Bar -->
      <div class="mb-6">
        <div class="flex items-center justify-between text-xs font-semibold text-ink-600 mb-2">
          <span data-step-indicator>Step 1 of 4: Your Industry</span>
          <span class="font-mono text-brand-600 font-bold" data-step-percent>25%</span>
        </div>
        <div class="h-2 w-full rounded-full bg-ink-100 overflow-hidden">
          <div class="h-full bg-brand-600 transition-all duration-300 ease-out" style="width: 25%;" data-progress-bar></div>
        </div>
      </div>

      <!-- STEP 1: Industry -->
      <div class="quiz-step" data-step="1">
        <h3 class="text-base sm:text-lg font-semibold text-ink-950 mb-1">
          1. What industry is your business in?
        </h3>
        <p class="text-xs sm:text-sm text-ink-500 mb-4">Select the option closest to what you do.</p>
        
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 sm:gap-3">
          <button type="button" class="quiz-option text-left p-3.5 rounded-xl border border-ink-200 hover:border-brand-500 hover:bg-brand-50/50 transition flex flex-col gap-1 focus:ring-2 focus:ring-brand-500" data-field="industry" data-value="Hotels & Resorts" data-demo="kayal-backwaters">
            <span class="text-lg">🏨</span>
            <span class="text-xs sm:text-sm font-semibold text-ink-900">Hotels & Resorts</span>
            <span class="text-[11px] text-ink-500">Homestays, villas, boutique stays</span>
          </button>
          <button type="button" class="quiz-option text-left p-3.5 rounded-xl border border-ink-200 hover:border-brand-500 hover:bg-brand-50/50 transition flex flex-col gap-1 focus:ring-2 focus:ring-brand-500" data-field="industry" data-value="Restaurants" data-demo="anaar-awadhi-table">
            <span class="text-lg">🍽️</span>
            <span class="text-xs sm:text-sm font-semibold text-ink-900">Restaurants & Cafés</span>
            <span class="text-[11px] text-ink-500">Fine dining, cloud kitchens, bakeries</span>
          </button>
          <button type="button" class="quiz-option text-left p-3.5 rounded-xl border border-ink-200 hover:border-brand-500 hover:bg-brand-50/50 transition flex flex-col gap-1 focus:ring-2 focus:ring-brand-500" data-field="industry" data-value="Dental Clinics" data-demo="ivory-smiles">
            <span class="text-lg">🏥</span>
            <span class="text-xs sm:text-sm font-semibold text-ink-900">Healthcare & Clinics</span>
            <span class="text-[11px] text-ink-500">Dentists, doctors, diagnostic labs</span>
          </button>
          <button type="button" class="quiz-option text-left p-3.5 rounded-xl border border-ink-200 hover:border-brand-500 hover:bg-brand-50/50 transition flex flex-col gap-1 focus:ring-2 focus:ring-brand-500" data-field="industry" data-value="Real Estate" data-demo="shivalik-homes">
            <span class="text-lg">🏢</span>
            <span class="text-xs sm:text-sm font-semibold text-ink-900">Real Estate & Builders</span>
            <span class="text-[11px] text-ink-500">Developers, residential projects</span>
          </button>
          <button type="button" class="quiz-option text-left p-3.5 rounded-xl border border-ink-200 hover:border-brand-500 hover:bg-brand-50/50 transition flex flex-col gap-1 focus:ring-2 focus:ring-brand-500" data-field="industry" data-value="Jewellery" data-demo="sunehri-atelier">
            <span class="text-lg">💎</span>
            <span class="text-xs sm:text-sm font-semibold text-ink-900">Jewellery & Boutiques</span>
            <span class="text-[11px] text-ink-500">Retail showrooms, luxury craft</span>
          </button>
          <button type="button" class="quiz-option text-left p-3.5 rounded-xl border border-ink-200 hover:border-brand-500 hover:bg-brand-50/50 transition flex flex-col gap-1 focus:ring-2 focus:ring-brand-500" data-field="industry" data-value="Professional Services" data-demo="meridian-advisory">
            <span class="text-lg">💼</span>
            <span class="text-xs sm:text-sm font-semibold text-ink-900">Professional Services</span>
            <span class="text-[11px] text-ink-500">Consultants, law, architecture, coaching</span>
          </button>
        </div>
      </div>

      <!-- STEP 2: Primary Goal -->
      <div class="quiz-step hidden" data-step="2">
        <h3 class="text-base sm:text-lg font-semibold text-ink-950 mb-1">
          2. What is the #1 job your website must do?
        </h3>
        <p class="text-xs sm:text-sm text-ink-500 mb-4">Choose the primary action you want visitors to take.</p>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <button type="button" class="quiz-option text-left p-4 rounded-xl border border-ink-200 hover:border-brand-500 hover:bg-brand-50/50 transition flex items-start gap-3 focus:ring-2 focus:ring-brand-500" data-field="goal" data-value="calls" data-weight="starter">
            <span class="text-xl">📞</span>
            <div>
              <div class="text-xs sm:text-sm font-semibold text-ink-900">Direct Phone & WhatsApp Enquiries</div>
              <div class="text-xs text-ink-500 mt-0.5">Show contact details, location map, and direct 1-tap call/message.</div>
            </div>
          </button>
          <button type="button" class="quiz-option text-left p-4 rounded-xl border border-ink-200 hover:border-brand-500 hover:bg-brand-50/50 transition flex items-start gap-3 focus:ring-2 focus:ring-brand-500" data-field="goal" data-value="booking" data-weight="business">
            <span class="text-xl">📅</span>
            <div>
              <div class="text-xs sm:text-sm font-semibold text-ink-900">Direct Appointments & Booking Requests</div>
              <div class="text-xs text-ink-500 mt-0.5">Calendar slots, room bookings, table reservations without OTA fees.</div>
            </div>
          </button>
          <button type="button" class="quiz-option text-left p-4 rounded-xl border border-ink-200 hover:border-brand-500 hover:bg-brand-50/50 transition flex items-start gap-3 focus:ring-2 focus:ring-brand-500" data-field="goal" data-value="catalogue" data-weight="custom">
            <span class="text-xl">🛍️</span>
            <div>
              <div class="text-xs sm:text-sm font-semibold text-ink-900">Product Catalogue / Direct Ordering</div>
              <div class="text-xs text-ink-500 mt-0.5">Full product list, dynamic filters, rupee prices, and order checkout.</div>
            </div>
          </button>
          <button type="button" class="quiz-option text-left p-4 rounded-xl border border-ink-200 hover:border-brand-500 hover:bg-brand-50/50 transition flex items-start gap-3 focus:ring-2 focus:ring-brand-500" data-field="goal" data-value="prestige" data-weight="business">
            <span class="text-xl">🌟</span>
            <div>
              <div class="text-xs sm:text-sm font-semibold text-ink-900">High-Ticket Credibility & Google Ranking</div>
              <div class="text-xs text-ink-500 mt-0.5">Rank on Google search for your city and prove authority to premium clients.</div>
            </div>
          </button>
        </div>
      </div>

      <!-- STEP 3: Scale & Pages -->
      <div class="quiz-step hidden" data-step="3">
        <h3 class="text-base sm:text-lg font-semibold text-ink-950 mb-1">
          3. How large does the website need to be?
        </h3>
        <p class="text-xs sm:text-sm text-ink-500 mb-4">You can always expand later as your business grows.</p>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <button type="button" class="quiz-option text-left p-4 rounded-xl border border-ink-200 hover:border-brand-500 hover:bg-brand-50/50 transition flex flex-col gap-1 focus:ring-2 focus:ring-brand-500" data-field="scope" data-value="starter" data-weight="starter">
            <span class="text-xs font-bold text-brand-600">UP TO 5 PAGES</span>
            <div class="text-xs sm:text-sm font-semibold text-ink-900">Starter Brochure</div>
            <div class="text-xs text-ink-500 mt-1">Home, About, Services/Menu, Photo Gallery, Contact & Map.</div>
          </button>
          <button type="button" class="quiz-option text-left p-4 rounded-xl border border-ink-200 hover:border-brand-500 hover:bg-brand-50/50 transition flex flex-col gap-1 focus:ring-2 focus:ring-brand-500" data-field="scope" data-value="business" data-weight="business">
            <span class="text-xs font-bold text-brand-600">6 TO 12 PAGES</span>
            <div class="text-xs sm:text-sm font-semibold text-ink-900">Comprehensive Business</div>
            <div class="text-xs text-ink-500 mt-1">Dedicated service subpages, SEO schema, client reviews, booking flows.</div>
          </button>
          <button type="button" class="quiz-option text-left p-4 rounded-xl border border-ink-200 hover:border-brand-500 hover:bg-brand-50/50 transition flex flex-col gap-1 focus:ring-2 focus:ring-brand-500" data-field="scope" data-value="custom" data-weight="custom">
            <span class="text-xs font-bold text-brand-600">12+ PAGES / CUSTOM</span>
            <div class="text-xs sm:text-sm font-semibold text-ink-900">Custom System</div>
            <div class="text-xs text-ink-500 mt-1">Extensive catalogue, custom pricing calculators, bespoke backend flows.</div>
          </button>
        </div>
      </div>

      <!-- STEP 4: Timeline -->
      <div class="quiz-step hidden" data-step="4">
        <h3 class="text-base sm:text-lg font-semibold text-ink-950 mb-1">
          4. What is your expected launch timeline?
        </h3>
        <p class="text-xs sm:text-sm text-ink-500 mb-4">We deliver on fixed dates with no endless delays.</p>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <button type="button" class="quiz-option text-left p-4 rounded-xl border border-ink-200 hover:border-brand-500 hover:bg-brand-50/50 transition flex flex-col gap-1 focus:ring-2 focus:ring-brand-500" data-field="timeline" data-value="2weeks">
            <span class="text-lg">⚡</span>
            <div class="text-xs sm:text-sm font-semibold text-ink-900">Rapid (2 to 3 Weeks)</div>
            <div class="text-xs text-ink-500">Need it live quickly for an upcoming launch or season.</div>
          </button>
          <button type="button" class="quiz-option text-left p-4 rounded-xl border border-ink-200 hover:border-brand-500 hover:bg-brand-50/50 transition flex flex-col gap-1 focus:ring-2 focus:ring-brand-500" data-field="timeline" data-value="4weeks">
            <span class="text-lg">🎯</span>
            <div class="text-xs sm:text-sm font-semibold text-ink-900">Standard (3 to 5 Weeks)</div>
            <div class="text-xs text-ink-500">Time for full custom design, content review, and SEO setup.</div>
          </button>
          <button type="button" class="quiz-option text-left p-4 rounded-xl border border-ink-200 hover:border-brand-500 hover:bg-brand-50/50 transition flex flex-col gap-1 focus:ring-2 focus:ring-brand-500" data-field="timeline" data-value="flexible">
            <span class="text-lg">🗓️</span>
            <div class="text-xs sm:text-sm font-semibold text-ink-900">Planning Ahead (Next Month)</div>
            <div class="text-xs text-ink-500">Gathering quotes and finalizing requirements first.</div>
          </button>
        </div>
      </div>

      <!-- RESULTS SCREEN -->
      <div class="quiz-result hidden" data-result-screen>
        <div class="rounded-xl bg-brand-50/80 border border-brand-200 p-5 sm:p-7">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-brand-200 pb-4 mb-4">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-brand-700">Recommended Match For You</span>
              <h4 class="font-display text-xl sm:text-2xl font-bold text-ink-950 mt-0.5" data-res-name>
                Business Website
              </h4>
            </div>
            <div class="text-right">
              <span class="text-xs text-ink-500 font-medium">Estimated Investment</span>
              <div class="font-mono text-xl sm:text-2xl font-bold text-brand-700" data-res-price>
                ₹35,000 – ₹70,000
              </div>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-5 mb-5 text-xs sm:text-sm">
            <div>
              <div class="font-semibold text-ink-900 mb-1.5">Why this fits your business:</div>
              <p class="text-ink-700 leading-relaxed" data-res-reason>
                Ideal for a business needing up to 12 pages with appointment booking and strong Google local SEO presence.
              </p>
            </div>
            <div>
              <div class="font-semibold text-ink-900 mb-1.5">What is included:</div>
              <ul class="space-y-1 text-ink-700 list-disc list-inside" data-res-features>
                <li>Up to 12 mobile-first pages</li>
                <li>Structured schema for Google search</li>
                <li>Direct booking & inquiry flows</li>
                <li>2 rounds of revisions included</li>
              </ul>
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-brand-200">
            <div class="text-xs text-ink-600">
              <span>Estimated Delivery:</span>
              <strong class="text-ink-900" data-res-timeline>3 to 5 weeks</strong>
            </div>

            <div class="flex items-center gap-2.5 w-full sm:w-auto">
              <button
                type="button"
                class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 rounded-md bg-brand-600 px-5 py-3 text-xs sm:text-sm font-semibold text-white shadow-sm hover:bg-brand-700 transition"
                data-apply-quiz-btn
              >
                Apply This Scope to Enquiry Form ↓
              </button>
              <button
                type="button"
                class="inline-flex items-center justify-center p-3 rounded-md border border-ink-300 bg-white text-ink-700 hover:bg-ink-100 transition text-xs font-semibold"
                title="Restart quiz"
                data-restart-quiz
              >
                ↺
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initPackageQuiz() {
    const root = document.querySelector<HTMLElement>('[data-quiz-root]');
    if (!root) return;

    let currentStep = 1;
    const answers: Record<string, string> = {
      industry: 'Hotels & Resorts',
      goal: 'booking',
      scope: 'business',
      timeline: '4weeks'
    };

    const stepIndicator = root.querySelector<HTMLElement>('[data-step-indicator]');
    const stepPercent = root.querySelector<HTMLElement>('[data-step-percent]');
    const progressBar = root.querySelector<HTMLElement>('[data-progress-bar]');
    const steps = root.querySelectorAll<HTMLElement>('.quiz-step');
    const resultScreen = root.querySelector<HTMLElement>('[data-result-screen]');

    const resName = root.querySelector<HTMLElement>('[data-res-name]');
    const resPrice = root.querySelector<HTMLElement>('[data-res-price]');
    const resReason = root.querySelector<HTMLElement>('[data-res-reason]');
    const resTimeline = root.querySelector<HTMLElement>('[data-res-timeline]');
    const applyBtn = root.querySelector<HTMLButtonElement>('[data-apply-quiz-btn]');
    const restartBtn = root.querySelector<HTMLButtonElement>('[data-restart-quiz]');

    const packages = {
      starter: {
        name: 'Starter Brochure Site',
        price: '₹18,000 – ₹32,000',
        timeline: '2 to 3 weeks',
        reason: 'Perfect for a single business needing a clean, fast mobile site with clear contact details and Google Maps location.',
        features: [
          'Up to 5 mobile-first pages',
          'Fast 0.4s load time with zero bloated plugins',
          '1-tap call & direct enquiry forms',
          'Basic on-page SEO & Google Profile guidance'
        ]
      },
      business: {
        name: 'Business Website',
        price: '₹35,000 – ₹70,000',
        timeline: '3 to 5 weeks',
        reason: 'The sweet spot for growing businesses requiring multi-service pages, booking/enquiry flows, and full Google search schema.',
        features: [
          'Up to 12 custom designed pages',
          'Booking or appointment enquiry flows',
          'Structured schema.org for Google rankings',
          '2 rounds of design revisions'
        ]
      },
      custom: {
        name: 'Custom / E-Commerce Build',
        price: '₹70,000 – ₹1,50,000',
        timeline: '5 to 9 weeks',
        reason: 'Built for businesses with extensive product catalogues, custom calculators, or bespoke functional requirements.',
        features: [
          'Full agreed scope and custom interactive tools',
          'Dynamic product filters or custom booking logic',
          'Performance & accessibility audit before launch',
          '3 rounds of revisions included'
        ]
      }
    };

    function showStep(step: number) {
      currentStep = step;
      steps.forEach((s) => {
        if (Number(s.dataset.step) === step) {
          s.classList.remove('hidden');
        } else {
          s.classList.add('hidden');
        }
      });

      if (step <= 4) {
        if (resultScreen) resultScreen.classList.add('hidden');
        const pct = Math.round((step / 4) * 100);
        if (stepPercent) stepPercent.textContent = `${pct}%`;
        if (progressBar) progressBar.style.width = `${pct}%`;
        if (stepIndicator) {
          const titles = ['Your Industry', 'Primary Goal', 'Website Scale', 'Launch Timeline'];
          stepIndicator.textContent = `Step ${step} of 4: ${titles[step - 1]}`;
        }
      } else {
        // Show result
        steps.forEach((s) => s.classList.add('hidden'));
        if (resultScreen) resultScreen.classList.remove('hidden');
        if (stepPercent) stepPercent.textContent = '100%';
        if (progressBar) progressBar.style.width = '100%';
        if (stepIndicator) stepIndicator.textContent = 'Recommendation Ready!';
        computeResult();
      }
    }

    function computeResult() {
      let tierKey: 'starter' | 'business' | 'custom' = 'business';

      if (answers.scope === 'starter' && answers.goal === 'calls') {
        tierKey = 'starter';
      } else if (answers.scope === 'custom' || answers.goal === 'catalogue') {
        tierKey = 'custom';
      } else {
        tierKey = 'business';
      }

      const p = packages[tierKey];
      if (resName) resName.textContent = p.name;
      if (resPrice) resPrice.textContent = p.price;
      if (resReason) resReason.textContent = `${p.reason} Tailored for your ${answers.industry} requirements.`;
      if (resTimeline) resTimeline.textContent = p.timeline;
    }

    // Option clicks
    root.querySelectorAll<HTMLButtonElement>('.quiz-option').forEach((btn) => {
      btn.addEventListener('click', () => {
        const field = btn.dataset.field;
        const val = btn.dataset.value;
        if (field && val) {
          answers[field] = val;
        }
        showStep(currentStep + 1);
      });
    });

    // Restart
    if (restartBtn) {
      restartBtn.addEventListener('click', () => {
        showStep(1);
      });
    }

    // Apply to enquiry form
    if (applyBtn) {
      applyBtn.addEventListener('click', () => {
        const form = document.querySelector<HTMLFormElement>('#enquiry-form');
        if (!form) {
          window.location.href = '/contact';
          return;
        }

        const categorySelect = form.elements.namedItem('category') as HTMLSelectElement | null;
        const needsSelect = form.elements.namedItem('needs') as HTMLSelectElement | null;
        const messageArea = (form.elements.namedItem('message') || form.elements.namedItem('notes')) as HTMLTextAreaElement | null;

        if (categorySelect && answers.industry) {
          for (let i = 0; i < categorySelect.options.length; i++) {
            const opt = categorySelect.options[i];
            if (opt && (opt.text.includes(answers.industry) || answers.industry.includes(opt.text))) {
              categorySelect.selectedIndex = i;
              break;
            }
          }
        }

        if (needsSelect) {
          needsSelect.value = answers.scope === 'custom' ? 'ecommerce' : 'new-website';
        }

        if (messageArea) {
          const tier = resName?.textContent?.trim() ?? 'Business Website';
          messageArea.value = `[Quiz Matched Scope] Recommended Package: ${tier} (${resPrice?.textContent?.trim()}). Industry: ${answers.industry}. Primary Goal: ${answers.goal}. Timeline: ${answers.timeline}.`;
        }

        form.scrollIntoView({ behavior: 'smooth', block: 'center' });
        form.classList.add('ring-2', 'ring-brand-500', 'ring-offset-4');
        setTimeout(() => {
          form.classList.remove('ring-2', 'ring-brand-500', 'ring-offset-4');
        }, 2500);
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPackageQuiz);
  } else {
    initPackageQuiz();
  }
</script>
