---
/**
 * Two floating CTA bubbles shown site-wide (BaseLayout):
 *   A · Build Your Website Free → https://atittle.com/free-website-builder/app?start=ai
 *   B · Free Website Audit      → https://atittle.com/tools/website-evaluator
 *
 * Placement (chosen around the widgets that already float):
 *   - ≥1024px: lower-right, stacked ABOVE the WhatsApp button (bottom-6 right-6, 56px);
 *     label-only pills on laptops, with the supporting line added from 1536px.
 *   - <1024px: right edge, stacked ABOVE the centred Dock (bottom ≈1rem + 56px) and the
 *     safe-area inset — compact labels, both actions always visible (no hidden menu).
 * Stacking: z-index 35 — above WhatsApp (30), below the Dock/header scrim (40), the
 * mobile nav panel / dock sheet (50) and the demo theatre, so it never covers a dialog.
 *
 * Plain anchors (no JS needed to navigate). Motion is CSS-only (transform/opacity on
 * inner wrappers, never on the fixed container) and stops under prefers-reduced-motion.
 * A ~0.6 KB script tucks the bubbles away on small screens while a form is on screen
 * or a field has focus (so they never cover form controls, a submit button or the
 * on-screen keyboard).
 * A bubble is not shown on the page it links to.
 */
const path = Astro.url.pathname.replace(/\/$/, "");
const showBuild = !path.startsWith("/free-website-builder");
const showAudit = path !== "/tools/website-evaluator";
const BUILD_URL = "https://atittle.com/free-website-builder/app?start=ai";
const AUDIT_URL = "https://atittle.com/tools/website-evaluator";
---

{
  (showBuild || showAudit) && (
    <nav class="fga" aria-label="Free tools" data-fga>
      {showBuild && (
        <a class="fga-item fga-build" href={BUILD_URL} data-analytics-event="floating_build_click">
          <span class="fga-float">
            <span class="fga-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="12.5" r="7.5" />
                <path d="M3.5 12.5h15M11 5a11.5 11.5 0 0 1 0 15M11 5a11.5 11.5 0 0 0 0 15" />
                <path class="fga-spark" d="M19.5 2.5v4M17.5 4.5h4" />
              </svg>
            </span>
            <span class="fga-text">
              <span class="fga-label">
                <span class="fga-long" data-i18n="growth.build">Build Your Website Free</span>
                <span class="fga-short" data-i18n="growth.buildShort">Build Website Free</span>
              </span>
              <span class="fga-sub" data-i18n="growth.buildSub">Create a website with AI. No coding required.</span>
            </span>
          </span>
        </a>
      )}
      {showAudit && (
        <a class="fga-item fga-audit" href={AUDIT_URL} data-analytics-event="floating_audit_click">
          <span class="fga-float">
            <span class="fga-icon" aria-hidden="true">
              <span class="fga-scan" />
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="10.5" cy="10.5" r="6.5" />
                <path d="m15.5 15.5 5 5" />
                <path d="m7.8 10.6 1.9 1.9 3.4-3.6" />
              </svg>
            </span>
            <span class="fga-text">
              <span class="fga-label">
                <span class="fga-long" data-i18n="growth.audit">Free Website Audit</span>
                <span class="fga-short" data-i18n="growth.auditShort">Free Website Audit</span>
              </span>
              <span class="fga-sub" data-i18n="growth.auditSub">Evaluate your website and discover what needs fixing.</span>
            </span>
          </span>
        </a>
      )}
    </nav>
  )
}

<style>
  .fga {
    --fga-gap: 10px;
    position: fixed;
    z-index: 35;
    right: max(12px, env(safe-area-inset-right, 0px));
    /* Mobile/tablet: above the centred Dock (≈1rem + 56px tall) and the safe area. */
    bottom: calc(max(1rem, env(safe-area-inset-bottom, 1rem)) + 64px);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--fga-gap);
    pointer-events: none; /* only the bubbles themselves take clicks */
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .fga.is-tucked {
    opacity: 0;
    transform: translateY(12px);
    visibility: hidden;
  }
  @media (min-width: 1024px) {
    .fga {
      --fga-gap: 12px;
      right: 24px;
      /* Desktop: stacked above the WhatsApp button (bottom 24px, 56px tall) + 16px. */
      bottom: 96px;
    }
  }

  .fga-item {
    pointer-events: auto;
    display: block;
    text-decoration: none;
    border-radius: 999px;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }
  .fga-float {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 6px 16px 6px 6px;
    border-radius: 999px;
    border: 1px solid transparent;
    box-shadow:
      0 1px 2px rgba(22, 17, 13, 0.12),
      0 12px 28px -12px rgba(22, 17, 13, 0.45);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      background-color 0.18s ease;
    will-change: transform;
  }
  .fga-icon {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
  }
  .fga-icon svg {
    position: relative;
    width: 20px;
    height: 20px;
    transition: transform 0.18s ease;
  }
  .fga-text {
    display: grid;
    min-width: 0;
    line-height: 1.15;
  }
  .fga-label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: -0.005em;
    white-space: nowrap;
  }
  .fga-long,
  .fga-sub {
    display: none;
  }
  @media (min-width: 1024px) {
    .fga-float {
      min-height: 52px;
      padding: 7px 18px 7px 7px;
      gap: 11px;
    }
    .fga-icon {
      width: 40px;
      height: 40px;
    }
    .fga-label {
      font-size: 15px;
    }
    .fga-long {
      display: block;
    }
    .fga-short {
      display: none;
    }
  }
  /* Supporting lines only where the page has real side margin (content is max 1280px
     wide); on laptops the label-only pill keeps the bubbles off the page's text. */
  @media (min-width: 1536px) {
    .fga-sub {
      display: block;
      margin-top: 3px;
      font-size: 12px;
      font-weight: 500;
      white-space: nowrap;
    }
  }

  /* A · Builder — deep brand teal, restrained aqua accent */
  .fga-build .fga-float {
    background: linear-gradient(135deg, #1c403e 0%, #102726 70%);
    border-color: rgba(127, 216, 204, 0.28);
    color: var(--color-cream);
  }
  .fga-build .fga-icon {
    color: #9be7dc;
    background: rgba(127, 216, 204, 0.14);
    box-shadow: 0 0 0 1px rgba(127, 216, 204, 0.35) inset;
  }
  .fga-build .fga-icon::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: inherit;
    background: radial-gradient(circle, rgba(127, 216, 204, 0.38), transparent 70%);
    opacity: 0.55;
    z-index: 0;
  }
  .fga-build .fga-sub {
    color: rgba(251, 246, 238, 0.78);
  }

  /* B · Audit — warm cream glass, terracotta icon, marigold scan ring */
  .fga-audit .fga-float {
    background: rgba(251, 246, 238, 0.94);
    border-color: var(--color-ink-200);
    color: var(--color-ink-950);
    backdrop-filter: saturate(1.3) blur(10px);
    -webkit-backdrop-filter: saturate(1.3) blur(10px);
  }
  .fga-audit .fga-icon {
    color: var(--color-cream);
    background: var(--color-brand-600);
  }
  .fga-scan {
    position: absolute;
    inset: -3px;
    border-radius: 999px;
    border: 2px solid var(--color-gold-400);
    opacity: 0;
  }
  .fga-audit .fga-sub {
    color: var(--color-ink-600);
  }

  /* Interaction */
  @media (hover: hover) and (pointer: fine) {
    .fga-item:hover .fga-float {
      box-shadow:
        0 2px 4px rgba(22, 17, 13, 0.14),
        0 18px 36px -14px rgba(22, 17, 13, 0.55);
    }
    .fga-build:hover .fga-icon svg {
      transform: rotate(-8deg) scale(1.06);
    }
    .fga-audit:hover .fga-icon svg {
      transform: scale(1.08);
    }
    .fga-audit:hover .fga-float {
      background: #fffdf9;
    }
  }
  .fga-item:focus-visible .fga-float {
    outline: 3px solid var(--color-gold-400);
    outline-offset: 3px;
  }
  .fga-item:active .fga-float {
    transform: translateY(1px) scale(0.98);
    transition-duration: 0.06s;
  }

  /* Ambient motion — decorative, transform/opacity only, halted for reduced motion */
  @media (prefers-reduced-motion: no-preference) {
    .fga-item {
      animation: fga-bob 7s ease-in-out infinite;
    }
    .fga-audit {
      animation-duration: 8s;
      animation-delay: -3.2s;
    }
    .fga-item:hover,
    .fga-item:focus-visible {
      animation-play-state: paused;
    }
    .fga-build .fga-icon::after {
      animation: fga-glow 4.5s ease-in-out infinite;
    }
    .fga-build .fga-spark {
      transform-box: fill-box;
      transform-origin: center;
      animation: fga-twinkle 4.5s ease-in-out infinite;
    }
    .fga-scan {
      animation: fga-scan 3.6s ease-out infinite 1.2s;
    }
  }
  @keyframes fga-bob {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, -4px, 0);
    }
  }
  @keyframes fga-glow {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 0.75;
    }
  }
  @keyframes fga-twinkle {
    0%,
    70%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    82% {
      opacity: 0.4;
      transform: scale(0.7);
    }
  }
  @keyframes fga-scan {
    0% {
      opacity: 0.7;
      transform: scale(0.85);
    }
    55%,
    100% {
      opacity: 0;
      transform: scale(1.35);
    }
  }
</style>

<script>
  // Small screens only: tuck the bubbles away while a form is on screen or a
  // text field has focus, so they never cover a form control, its submit button
  // or an on-screen keyboard. Desktop (≥1024px) is unaffected.
  const el = document.querySelector<HTMLElement>("[data-fga]");
  if (el) {
    const small = matchMedia("(max-width: 1023px)");
    let formsInView = 0;
    let fieldFocused = false;
    const update = () => el.classList.toggle("is-tucked", small.matches && (formsInView > 0 || fieldFocused));
    const isField = (t: EventTarget | null) =>
      t instanceof HTMLElement && t.matches("input:not([type=checkbox]):not([type=radio]):not([type=submit]):not([type=button]), textarea, select, [contenteditable='true']");
    document.addEventListener("focusin", (e) => {
      if (isField(e.target)) {
        fieldFocused = true;
        update();
      }
    });
    document.addEventListener("focusout", (e) => {
      if (isField(e.target)) {
        fieldFocused = false;
        update();
      }
    });
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) formsInView += e.isIntersecting ? 1 : (e.target as HTMLElement).dataset.fgaSeen ? -1 : 0;
        for (const e of entries) (e.target as HTMLElement).dataset.fgaSeen = e.isIntersecting ? "1" : "";
        formsInView = Math.max(0, formsInView);
        update();
      });
      document.querySelectorAll("form").forEach((f) => io.observe(f));
    }
    small.addEventListener("change", update);
  }
</script>
