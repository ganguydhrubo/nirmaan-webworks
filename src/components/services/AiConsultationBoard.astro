      }
    },
    {
      keywords: ["saas", "subscription", "software", "mrr", "portal", "ca", "billing", "tool", "b2b"],
      practice: "Practice 03: End-to-End SaaS (Software as a Service)",
      practiceId: "saas",
      startingPrice: "Starts at ₹2,499",
      timeline: "48h to 6 Weeks",
      diagnosis: "Internal spreadsheets and checklists that your team uses every day are prime candidates for B2B SaaS because other business owners in your industry experience the exact same operational pain.",
      steps: [
        "Architect a multi-tenant web application with secure role-based access control (Admin, Staff, Client).",
        "Integrate automated recurring Indian subscriptions via Razorpay Subscriptions (e-mandate & recurring UPI).",
        "Build clean self-serve onboarding so new paying clients can configure their account in under 3 minutes without manual assistance."
      ],
      microTier: {
        price: "₹2,499 – ₹5,000",
        title: "SaaS Architecture Blueprint",
        desc: "Complete database schema, technical stack recommendation, UI wireframes, and developer handoff spec.",
        time: "48 to 72 Hours"
      },
      growthTier: {
        price: "₹28,000 – ₹65,000",
        title: "Core Working MVP",
        desc: "Multi-tenant authentication, user dashboard, core workflow tool, and Razorpay subscription billing.",
        time: "3 to 4 Weeks"
      },
      scaleTier: {
        price: "₹75,000 – ₹1,80,000",
        title: "Enterprise B2B SaaS",
        desc: "Role-based permissions, automated team invites, analytics telemetry, customer portal, and API webhooks.",
        time: "5 to 8 Weeks"
      }
    }
  ];

  function matchQuery(rawText: string): KnowledgeEntry {
    const text = rawText.toLowerCase();
    
    let bestMatch: KnowledgeEntry = knowledgeBase[0]!;
    let maxScore = -1;

    for (const item of knowledgeBase) {
      let score = 0;
      for (const kw of item.keywords) {
        if (text.includes(kw)) score += 1;
      }
      if (score > maxScore) {
        maxScore = score;
        bestMatch = item;
      }
    }

    if (maxScore <= 0) {
      return {
        keywords: [],
        practice: "Practice 06: Practical Digital Transformation",
        practiceId: "ai-transformation",
        startingPrice: "Starts at ₹499",
        timeline: "24h to 2 Weeks",
        diagnosis: `For your specific business requirement ("${rawText.slice(0, 40)}..."), we offer tailored options ranging from a quick ₹499 starter fix to full custom deployment.`,
        steps: [
          "Deploy a high-speed customer touchpoint optimized for mobile visitors and WhatsApp.",
          "Automate repetitive operational tasks (enquiry qualification and billing alerts).",
          "Track direct ROI so every rupee invested produces measurable growth."
        ],
        microTier: {
          price: "₹499 – ₹1,999",
          title: "Micro Quick Starter",
          desc: "Audit, single bug fix, or essential WhatsApp customer link.",
          time: "24 to 48 Hours"
        },
        growthTier: {
          price: "₹7,500 – ₹22,000",
          title: "Growth Implementation",
          desc: "Complete workflow deployment, customer funnel, or system overhaul.",
          time: "7 to 10 Days"
        },
        scaleTier: {
          price: "₹35,000 – ₹90,000",
          title: "Custom Enterprise Solution",
          desc: "Full custom software architecture with dedicated support.",
          time: "3 to 5 Weeks"
        }
      };
    }

    return bestMatch;
  }

  function initConsultation() {
    const form = document.querySelector<HTMLFormElement>('#ai-consultation-form');
    const input = document.querySelector<HTMLInputElement>('#ai-user-query');
    const chips = document.querySelectorAll<HTMLButtonElement>('.ai-chip');
    const idleState = document.querySelector<HTMLElement>('#ai-idle-state');
    const resultCard = document.querySelector<HTMLElement>('#ai-result-card');
    const practiceEl = document.querySelector<HTMLElement>('#ai-result-practice');
    const startingEl = document.querySelector<HTMLElement>('#ai-result-starting');
    const timelineEl = document.querySelector<HTMLElement>('#ai-result-timeline');
    const diagnosisEl = document.querySelector<HTMLElement>('#ai-result-diagnosis');
    const stepsEl = document.querySelector<HTMLElement>('#ai-result-steps');
    const applyBtn = document.querySelector<HTMLButtonElement>('#ai-apply-btn');
    const whatsappBtn = document.querySelector<HTMLAnchorElement>('#ai-whatsapp-btn');

    // Tier Elements
    const microPriceEl = document.querySelector<HTMLElement>('#tier-micro-price');
    const microTitleEl = document.querySelector<HTMLElement>('#tier-micro-title');
    const microDescEl = document.querySelector<HTMLElement>('#tier-micro-desc');
    const microTimeEl = document.querySelector<HTMLElement>('#tier-micro-time');

    const growthPriceEl = document.querySelector<HTMLElement>('#tier-growth-price');
    const growthTitleEl = document.querySelector<HTMLElement>('#tier-growth-title');
    const growthDescEl = document.querySelector<HTMLElement>('#tier-growth-desc');
    const growthTimeEl = document.querySelector<HTMLElement>('#tier-growth-time');

    const scalePriceEl = document.querySelector<HTMLElement>('#tier-scale-price');
    const scaleTitleEl = document.querySelector<HTMLElement>('#tier-scale-title');
    const scaleDescEl = document.querySelector<HTMLElement>('#tier-scale-desc');
    const scaleTimeEl = document.querySelector<HTMLElement>('#tier-scale-time');

    function renderResult(query: string) {
      if (!query.trim()) return;
      const match = matchQuery(query);

      if (idleState) idleState.classList.add('hidden');
      if (resultCard) {
        resultCard.classList.remove('hidden');
        resultCard.classList.add('animate-in', 'fade-in', 'duration-300');
      }

      if (practiceEl) practiceEl.textContent = match.practice;
      if (startingEl) startingEl.textContent = match.startingPrice;
      if (timelineEl) timelineEl.textContent = match.timeline;
      if (diagnosisEl) diagnosisEl.textContent = match.diagnosis;

      if (stepsEl) {
        stepsEl.innerHTML = '';
        match.steps.forEach(step => {
          const li = document.createElement('li');
          li.className = 'flex items-start gap-2';
          li.innerHTML = `<span class="text-emerald-400 font-bold">›</span><span>${step}</span>`;
          stepsEl.appendChild(li);
        });
      }

      // Update 3-Tier details
      if (microPriceEl) microPriceEl.textContent = match.microTier.price;
      if (microTitleEl) microTitleEl.textContent = match.microTier.title;
      if (microDescEl) microDescEl.textContent = match.microTier.desc;
      if (microTimeEl) microTimeEl.textContent = match.microTier.time;

      if (growthPriceEl) growthPriceEl.textContent = match.growthTier.price;
      if (growthTitleEl) growthTitleEl.textContent = match.growthTier.title;
      if (growthDescEl) growthDescEl.textContent = match.growthTier.desc;
      if (growthTimeEl) growthTimeEl.textContent = match.growthTier.time;

      if (scalePriceEl) scalePriceEl.textContent = match.scaleTier.price;
      if (scaleTitleEl) scaleTitleEl.textContent = match.scaleTier.title;
      if (scaleDescEl) scaleDescEl.textContent = match.scaleTier.desc;
      if (scaleTimeEl) scaleTimeEl.textContent = match.scaleTier.time;

      // WhatsApp link setup
      if (whatsappBtn) {
        const waMsg = `Hi ATITTLE, I ran my business scenario through your AI Consultation Board: "${query}". You recommended ${match.practice} (${match.startingPrice} onwards). I'd like to discuss bringing this to life.`;
        whatsappBtn.href = `https://wa.me/919330393298?text=${encodeURIComponent(waMsg)}`;
      }

      // Apply to form handler
      if (applyBtn) {
        applyBtn.onclick = () => {
          const targetForm = document.querySelector<HTMLFormElement>('#services-enquiry-form');
          if (!targetForm) return;

          const msgArea = (targetForm.elements.namedItem('message') || targetForm.elements.namedItem('notes')) as HTMLTextAreaElement | null;
          const needsSelect = targetForm.elements.namedItem('needs') as HTMLSelectElement | null;

          if (needsSelect) needsSelect.value = 'not-sure';
          if (msgArea) {
            msgArea.value = `[AI Consultation Blueprint]\nBusiness Case: ${query}\nRecommended: ${match.practice}\nBudget Tiers: Micro (${match.microTier.price}) | Growth (${match.growthTier.price}) | Scale (${match.scaleTier.price})\nEstimated Timeline: ${match.timeline}\n\nPlease get in touch to formalize this scope.`;
          }

          targetForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetForm.classList.add('ring-2', 'ring-brand-500', 'ring-offset-4');
          setTimeout(() => targetForm.classList.remove('ring-2', 'ring-brand-500', 'ring-offset-4'), 2500);
        };
      }
    }

    // Form submit
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (input && input.value) {
        renderResult(input.value);
      }
    });

    // Chip clicks
    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const q = chip.dataset.query;
        if (q) {
          if (input) input.value = q;
          renderResult(q);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initConsultation);
  } else {
    initConsultation();
  }
</script>
