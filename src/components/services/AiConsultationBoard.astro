---
import Icon from "@/components/ui/Icon.astro";

interface Props {
  id?: string;
  class?: string;
}

const { id = "ai-consultation-board", class: className = "" } = Astro.props;

// Pre-packaged high-intent Indian business prompts spanning small retailers to high-end clients
const quickScenarios = [
  {
    id: "retailer",
    label: "🛍️ Surat Retailer (₹499)",
    query: "I run a clothing & saree shop in Surat. Can I start with a ₹499 digital catalog and WhatsApp order link for my customers?",
  },
  {
    id: "cafe",
    label: "☕ Local Cafe (₹799)",
    query: "We run a bakery cafe in Lucknow. How do I fix my Google Maps menu and take direct orders without 26% Zomato cut?",
  },
  {
    id: "rescue-micro",
    label: "🛠️ Single Bug Fix (₹499)",
    query: "Our website contact form is broken and throwing a PHP error. Can you fix just this single issue for our clinic?",
  },
  {
    id: "jewellery",
    label: "💎 Jaipur Jewellery (Growth)",
    query: "I run a silver and gemstone jewellery store in Jaipur. How do we get high-intent orders outside our city?",
  },
  {
    id: "resort",
    label: "🏨 30-Room Resort (Scale)",
    query: "We run a heritage boutique resort in Rajasthan. OTA commissions (18-22%) are eating our margins. What's the fix?",
  },
  {
    id: "clinic",
    label: "🏥 Dental Clinic (AI Agent)",
    query: "I run a dental clinic in Pune. Patients call at 10 PM and we lose appointments. Can an AI agent book them?",
  },
  {
    id: "factory",
    label: "🏭 CNC Manufacturing (IoT)",
    query: "We operate 8 manufacturing machines in Gujarat. Can IoT sensors alert our phones before a breakdown happens?",
  },
  {
    id: "saas",
    label: "📦 B2B Subscription (SaaS)",
    query: "We want to turn our internal client billing checklist into a paid subscription SaaS for other CA firms. What's required?",
  }
];
---

<section id={id} class:list={["relative overflow-hidden bg-ink-950 py-16 sm:py-24 text-cream border-y border-ink-800", className]} data-ai-consultation>
  <!-- Ambient Luxury Glow Background -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute -top-40 left-1/4 h-96 w-96 rounded-full bg-brand-500/10 blur-3xl"></div>
    <div class="absolute -bottom-40 right-1/4 h-96 w-96 rounded-full bg-emerald-500/10 blur-3xl"></div>
    <div class="absolute inset-0 bg-[radial-gradient(#261d16_1px,transparent_1px)] [background-size:24px_24px] opacity-25"></div>
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <!-- Top Terminal Bar Header -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-gold-400/40 bg-gold-950/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-gold-300 backdrop-blur">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
        From ₹499 Micro Solutions to Scale Enterprise &middot; Instant 0ms Simulation
      </div>

      <h2 class="font-display mt-4 text-3xl sm:text-4xl lg:text-5xl font-semibold text-cream leading-tight">
        Not sure which service fits? <br />
        <span class="text-brand-400 italic">Test your business use-case live.</span>
      </h2>

      <p class="mt-4 text-sm sm:text-base text-ink-300 leading-relaxed max-w-2xl mx-auto">
        Whether you are a local corner retailer testing digital with a ₹499 starter fix or a high-end enterprise scaling custom SaaS, our digital architect maps the right scope, tiered budget, and delivery roadmap in real time.
      </p>
    </div>

    <!-- The Consultation Console -->
    <div class="rounded-3xl border border-ink-800 bg-ink-900/90 p-5 sm:p-8 shadow-2xl backdrop-blur-md">
      <!-- Quick Scenario Chips -->
      <div class="mb-6">
        <div class="flex items-center justify-between text-xs font-medium text-ink-400 mb-2.5">
          <span>Choose an Indian Business Scenario:</span>
          <span class="text-emerald-400">1-Tap to Test</span>
        </div>
        <div class="flex flex-wrap gap-2">
          {quickScenarios.map(scenario => (
            <button
              type="button"
              class="ai-chip inline-flex items-center rounded-full border border-ink-700 bg-ink-800/80 px-3.5 py-1.5 text-xs font-medium text-ink-200 transition hover:border-brand-500 hover:bg-ink-700 hover:text-white active:scale-95 cursor-pointer"
              data-query={scenario.query}
              data-id={scenario.id}
            >
              {scenario.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Custom Input Form -->
      <form id="ai-consultation-form" class="relative mb-6">
        <div class="relative flex flex-col sm:flex-row items-stretch gap-3">
          <div class="relative flex-1">
            <input
              type="text"
              id="ai-user-query"
              placeholder="Or type your business: 'I own a bakery in Lucknow, can AI automate pre-orders?'"
              class="w-full rounded-xl border border-ink-700 bg-ink-950 px-4 py-3.5 text-sm sm:text-base text-cream placeholder-ink-500 shadow-inner focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 transition"
              required
            />
          </div>
          <button
            type="submit"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 text-sm sm:text-base font-semibold text-cream shadow-md transition hover:bg-brand-500 active:scale-98 shrink-0 cursor-pointer"
          >
            <span>Analyze & Architect</span>
            <span aria-hidden="true">⚡</span>
          </button>
        </div>
      </form>

      <!-- Live Blueprint Output Board -->
      <div id="ai-output-container" class="rounded-2xl border border-ink-800 bg-ink-950/80 p-5 sm:p-7 transition-all duration-300">
        <!-- Default Idle Placeholder -->
        <div id="ai-idle-state" class="flex flex-col items-center justify-center py-8 text-center text-ink-400">
          <div class="h-12 w-12 rounded-full border border-ink-800 bg-ink-900 flex items-center justify-center text-xl mb-3 text-brand-400">
            ✦
          </div>
          <p class="text-sm sm:text-base font-medium text-ink-300">
            Select a prompt above or ask a custom question.
          </p>
          <p class="text-xs text-ink-500 mt-1">
            Get an instant plain-English breakdown with 3 tiered investment options (from ₹499) and delivery roadmap.
          </p>
        </div>

        <!-- Result Card (Populated dynamically) -->
        <div id="ai-result-card" class="hidden space-y-5">
          <!-- Top Classification Bar -->
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink-800 pb-4">
            <div class="flex items-center gap-2.5">
              <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-950 border border-emerald-500/40 text-xs font-mono text-emerald-400">
                ✓
              </span>
              <div>
                <span class="text-[11px] font-mono uppercase tracking-wider text-ink-400">Recommended Practice:</span>
                <div id="ai-result-practice" class="font-display text-base sm:text-lg font-bold text-cream">
                  <!-- Injected via JS -->
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2 text-xs font-mono">
              <span class="rounded bg-emerald-950 border border-emerald-500/40 px-2.5 py-1 text-emerald-300" id="ai-result-starting">
                Starts at ₹499
              </span>
              <span class="rounded bg-ink-800 px-2.5 py-1 text-ink-300" id="ai-result-timeline">
                <!-- Injected via JS -->
              </span>
            </div>
          </div>

          <!-- Problem Breakdown -->
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-brand-400 mb-1">
              Core Bottleneck & Insight:
            </div>
            <p id="ai-result-diagnosis" class="text-sm sm:text-base text-ink-200 leading-relaxed">
              <!-- Injected via JS -->
            </p>
          </div>

          <!-- Actionable Blueprint -->
          <div class="rounded-xl border border-ink-800 bg-ink-900 p-4 sm:p-5">
            <div class="text-xs font-bold uppercase tracking-wider text-emerald-400 mb-2 flex items-center gap-1.5">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
              Recommended ATITTLE Implementation Blueprint:
            </div>
            <ul id="ai-result-steps" class="space-y-2 text-xs sm:text-sm text-ink-300">
              <!-- Injected via JS -->
            </ul>
          </div>

          <!-- Comprehensive 3-Tier Investment Spectrum (₹499 to High-End) -->
          <div class="rounded-xl border border-ink-800 bg-ink-900/90 p-4 sm:p-5">
            <div class="text-xs font-bold uppercase tracking-wider text-gold-300 mb-3 flex items-center justify-between">
              <span class="flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-gold-400"></span>
                Flexible Investment Options (Small Retailer to High-End):
              </span>
              <span class="text-[11px] font-mono text-emerald-400">Options for Every Stage</span>
            </div>

            <div class="grid gap-3 sm:grid-cols-3 text-xs">
              <!-- Tier 1: Micro Starter -->
              <div class="tier-card rounded-lg border border-emerald-500/30 bg-emerald-950/30 p-3.5 flex flex-col justify-between" id="tier-micro-card">
                <div>
                  <div class="flex items-center justify-between text-[10px] font-mono text-emerald-400 uppercase font-bold">
                    <span>Micro Starter</span>
                    <span class="rounded bg-emerald-900/60 px-1.5 py-0.5 text-emerald-300" id="tier-micro-price">₹499 – ₹1,999</span>
                  </div>
                  <div class="font-bold text-cream mt-2 text-xs" id="tier-micro-title">Single Setup / Audit</div>
                  <p class="text-[11px] text-ink-300 mt-1 leading-snug" id="tier-micro-desc">Ideal for small shops and local retailers testing digital.</p>
                </div>
                <div class="text-[10px] font-mono text-emerald-400 mt-2.5 pt-2 border-t border-emerald-900/50" id="tier-micro-time">24 to 48 Hours</div>
              </div>

              <!-- Tier 2: Growth SMB -->
              <div class="tier-card rounded-lg border border-brand-500/40 bg-brand-950/30 p-3.5 flex flex-col justify-between ring-1 ring-brand-500/30" id="tier-growth-card">
                <div>
                  <div class="flex items-center justify-between text-[10px] font-mono text-brand-300 uppercase font-bold">
                    <span>Growth SMB</span>
                    <span class="rounded bg-brand-900/60 px-1.5 py-0.5 text-brand-300" id="tier-growth-price">₹7,500 – ₹24,000</span>
                  </div>
                  <div class="font-bold text-cream mt-2 text-xs" id="tier-growth-title">Full Workflow Deployment</div>
                  <p class="text-[11px] text-ink-300 mt-1 leading-snug" id="tier-growth-desc">Complete multi-step automation or targeted growth campaigns.</p>
                </div>
                <div class="text-[10px] font-mono text-brand-300 mt-2.5 pt-2 border-t border-brand-900/50" id="tier-growth-time">7 to 14 Days</div>
              </div>

              <!-- Tier 3: Scale / Enterprise -->
              <div class="tier-card rounded-lg border border-purple-500/30 bg-purple-950/30 p-3.5 flex flex-col justify-between" id="tier-scale-card">
                <div>
                  <div class="flex items-center justify-between text-[10px] font-mono text-purple-300 uppercase font-bold">
                    <span>Scale / Custom</span>
                    <span class="rounded bg-purple-900/60 px-1.5 py-0.5 text-purple-300" id="tier-scale-price">₹45,000 – ₹1.5L+</span>
                  </div>
                  <div class="font-bold text-cream mt-2 text-xs" id="tier-scale-title">High-End Architecture</div>
                  <p class="text-[11px] text-ink-300 mt-1 leading-snug" id="tier-scale-desc">Multi-tenant SaaS, IoT telemetry, or autonomous AI teams.</p>
                </div>
                <div class="text-[10px] font-mono text-purple-300 mt-2.5 pt-2 border-t border-purple-900/50" id="tier-scale-time">3 to 6 Weeks</div>
              </div>
            </div>
          </div>

          <!-- 1-Tap Handoff CTAs -->
          <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-ink-800">
            <button
              type="button"
              id="ai-apply-btn"
              class="inline-flex items-center gap-2 rounded-lg bg-brand-600 hover:bg-brand-500 text-cream px-4 py-2.5 text-xs sm:text-sm font-semibold shadow-sm transition active:scale-98 cursor-pointer"
            >
              <span>Apply Blueprint to Enquiry Form &darr;</span>
            </button>

            <a
              id="ai-whatsapp-btn"
              href="#"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-lg bg-[#25D366] hover:bg-[#1EBE5D] text-white px-4 py-2.5 text-xs sm:text-sm font-semibold shadow-sm transition active:scale-98"
              data-analytics-event="whatsapp_click"
            >
              <Icon name="whatsapp" class="h-4 w-4" />
              <span>Discuss on WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // High-performance tiered simulation engine
  interface TierInfo {
    price: string;
    title: string;
    desc: string;
    time: string;
  }

  interface KnowledgeEntry {
    keywords: string[];
    practice: string;
    practiceId: string;
    startingPrice: string;
    timeline: string;
    diagnosis: string;
    steps: string[];
    microTier: TierInfo;
    growthTier: TierInfo;
    scaleTier: TierInfo;
  }

  const knowledgeBase: KnowledgeEntry[] = [
    {
      keywords: ["retail", "saree", "surat", "clothing", "apparel", "kirana", "shop", "store", "corner", "small"],
      practice: "Practice 01: Retail Lead Funnel + Practice 06: WhatsApp Catalog",
      practiceId: "meta-google-ads",
      startingPrice: "Starts at ₹499",
      timeline: "24h to 7 Days",
      diagnosis: "Small retailers & local shop owners don't need a ₹50,000 corporate portal to start selling online. You only need an instant digital catalog link on WhatsApp so nearby customers can view items, check stock, and place orders directly.",
      steps: [
        "Create a clean mobile-friendly WhatsApp product catalog link & QR standee for your billing counter.",
        "Set up instant auto-reply with payment UPI QR and delivery pin code confirmation.",
        "Run hyper-local Instagram/Facebook micro-ads in your 5km radius starting from ₹200/day."
      ],
      microTier: {
        price: "₹499 – ₹1,499",
        title: "Micro Catalog & QR Setup",
        desc: "Instant WhatsApp product link, QR standee for shop counter, and Google Maps listing update.",
        time: "Within 24 Hours"
      },
      growthTier: {
        price: "₹4,999 – ₹12,500",
        title: "Local Storefront & Ads",
        desc: "Mobile-first ordering landing page with automated WhatsApp cart checkout and 5km radius ad launch.",
        time: "3 to 5 Days"
      },
      scaleTier: {
        price: "₹28,000 – ₹65,000",
        title: "Pan-India D2C Platform",
        desc: "Automated inventory sync with Tally/billing machine, multi-courier tracking, and national scaling.",
        time: "2 to 3 Weeks"
      }
    },
    {
      keywords: ["cafe", "bakery", "restaurant", "food", "lucknow", "menu", "zomato", "swiggy", "order"],
      practice: "Practice 02: Local Maps & Menu + Practice 03: Direct Food Ordering",
      practiceId: "seo-aeo",
      startingPrice: "Starts at ₹799",
