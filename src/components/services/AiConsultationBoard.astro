        title: "24/7 AI Booking Assistant",
        desc: "Intelligent booking agent that checks doctor schedules in real time and sends automated reminder pings.",
        time: "7 to 10 Days"
      },
      scaleTier: {
        price: "₹45,000 – ₹95,000",
        title: "Hospital Chain Patient Portal",
        desc: "Multi-branch digital reception, electronic medical records (EMR) lookup, and automated post-care follow-ups.",
        time: "3 to 4 Weeks"
      }
    },
    {
      keywords: ["iot", "machine", "cnc", "sensor", "hardware", "factory", "manufacturing", "breakdown", "telemetry"],
      practice: "Practice 05: End-to-End IoT (Hardware to Cloud Dashboard)",
      practiceId: "iot",
