---
import { siteConfig } from "@config/site";

const demos = siteConfig.demoRegistry.map((demo) => {
  const industry = siteConfig.industryRegistry.find((i) => i.slug === demo.industrySlug)!;
  return {
    ...demo,
    industryName: industry.name,
    category: industry.shortName,
  };
});
---

<div
  id="cinematic-theatre"
  class="cinematic-theatre"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Cinematic Demo Theatre"
>
  <!-- Ambient Deep Space Backdrop -->
  <div class="theatre-backdrop" data-theatre-close></div>
  <div class="theatre-ambient-glow" id="theatre-glow" aria-hidden="true"></div>

  <!-- Theatre Shell -->
  <div class="theatre-shell">
    <!-- Top Floating Glass Navigation Header -->
    <header class="theatre-header">
      <div class="theatre-brand">
        <span class="theatre-live-dot" aria-hidden="true"></span>
        <div class="theatre-titles">
          <span class="theatre-kicker">ATITTLE CINEMATIC REEL SUITE</span>
          <span class="theatre-subline">Hardware-Tested Working Prototypes</span>
        </div>
      </div>

      <!-- Device Viewport Toggle (Mobile 3D Phone vs Studio Desktop) -->
      <div class="theatre-viewport-switcher" role="radiogroup" aria-label="Device viewport">
        <button
          type="button"
          class="theatre-vp-btn is-active"
          data-viewport="mobile"
          aria-checked="true"
          role="radio"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
          <span>3D Mobile Stage</span>
        </button>
        <button
          type="button"
          class="theatre-vp-btn"
          data-viewport="desktop"
          aria-checked="false"
          role="radio"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
          <span>Studio Desktop</span>
        </button>
      </div>

      <!-- Action Controls (Sound FX & Close) -->
      <div class="theatre-actions">
        <button
          type="button"
          class="theatre-sound-toggle"
          id="theatre-sound-btn"
          aria-label="Toggle sound effects"
          title="Toggle interactive sound design"
        >
          <span class="sound-wave-icon" aria-hidden="true">
            <i></i><i></i><i></i>
          </span>
          <span id="theatre-sound-label">Sound FX</span>
        </button>

        <button
          type="button"
          class="theatre-close-btn"
          data-theatre-close
          aria-label="Close Theatre (Esc)"
          title="Close (Escape)"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
    </header>

    <!-- Category Pills Filter Strip -->
    <nav class="theatre-category-bar" aria-label="Demo category filter">
      <div class="theatre-pills-scroll" id="theatre-pills">
        <button type="button" class="theatre-pill is-active" data-filter="all">All ({demos.length})</button>
        {Array.from(new Set(demos.map((d) => d.category))).map((cat) => (
          <button type="button" class="theatre-pill" data-filter={cat}>{cat}</button>
        ))}
      </div>
    </nav>

    <!-- Core Interactive Stage & Inspector -->
    <main class="theatre-stage-area">
      <!-- Left / Center: Interactive Staging Device (With 3D Gyro/Cursor Tilt) -->
      <div class="theatre-stage-wrapper">
        <div class="theatre-device-stage" id="theatre-device-container">
          <!-- Mobile Frame (Titanium finish, Dynamic Island, Specular Glare) -->
          <div class="theatre-phone-frame" id="theatre-phone-frame">
            <div class="phone-dynamic-island" aria-hidden="true">
              <span class="island-camera"></span>
              <span class="island-sensor"></span>
            </div>
            <div class="phone-screen" id="theatre-phone-screen">
              <!-- Pixel-Perfect Mobile Showcase Poster (0ms paint) -->
              <img
                id="theatre-poster-mobile"
                class="phone-poster-img"
                src="/images/showcase/shivalik-homes-mobile.webp"
                alt="Mobile demo preview"
                width="585"
                height="780"
              />
              <!-- Live Scrollable Interactive Mobile Prototype -->
              <iframe
                id="theatre-iframe-mobile"
                class="phone-live-iframe"
                src="/demos/shivalik-homes/?theatre=1"
                title="Interactive Mobile Prototype"
                loading="eager"
              ></iframe>
              <div class="phone-glare" aria-hidden="true"></div>
            </div>
            <div class="phone-home-indicator" aria-hidden="true"></div>
          </div>

          <!-- Desktop Frame (Studio Browser) -->
          <div class="theatre-desktop-frame" id="theatre-desktop-frame">
            <div class="desktop-header-bar" aria-hidden="true">
              <div class="desktop-dots">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
              </div>
              <div class="desktop-url-bar">
                <svg class="h-3 w-3 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span id="theatre-desktop-url">atittle.com/demos/...</span>
              </div>
              <div class="desktop-badge">PROTOTYPE</div>
            </div>
            <div class="desktop-screen" id="theatre-desktop-screen">
              <img
                id="theatre-poster-desktop"
                class="theatre-poster-desktop"
                src={`/images/showcase/${demos[0]?.slug || "shivalik-homes"}-desktop.webp`}
                alt="Desktop Preview"
                loading="eager"
              />
              <iframe
                id="theatre-iframe-desktop"
                class="theatre-live-iframe-desktop"
                title="Desktop Live Prototype"
                loading="lazy"
                src={`/demos/${demos[0]?.slug || "shivalik-homes"}/?theatre=1`}
              ></iframe>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Blueprint Inspector Card -->
      <aside class="theatre-inspector">
        <div class="inspector-card">
          <div class="inspector-badge-row">
            <span class="inspector-category" id="theatre-card-category">Industry</span>
            <span class="inspector-city" id="theatre-card-city">City</span>
          </div>

          <h2 class="inspector-title" id="theatre-card-title">Demo Name</h2>
          <p class="inspector-tagline" id="theatre-card-tagline">Business Tagline</p>

          <!-- Engineering & Conversion Highlights -->
          <div class="inspector-specs">
            <div class="spec-item">
              <span class="spec-value">0.6s</span>
              <span class="spec-label">Mobile 4G Paint</span>
            </div>
            <div class="spec-item">
              <span class="spec-value">100%</span>
              <span class="spec-label">Direct WhatsApp</span>
            </div>
            <div class="spec-item">
              <span class="spec-value">100/100</span>
              <span class="spec-label">Lighthouse</span>
            </div>
          </div>

          <p class="inspector-quote">
            "Designed and engineered for real Indian smartphone hardware — no broken layouts, no corporate fluff, built to convert."
          </p>

          <!-- Launch Actions -->
          <div class="inspector-actions">
            <a
              href="#"
              id="theatre-launch-btn"
              class="theatre-launch-cta"
              data-magnetic
              target="_blank"
              rel="noopener"
            >
              <span>Explore Full Live Demo</span>
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
            </a>

            <div class="theatre-nav-controls">
              <button type="button" class="theatre-step-btn" id="theatre-prev-btn" aria-label="Previous demo (Left arrow)">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
              </button>
              <span class="theatre-nav-counter" id="theatre-counter">1 / 15</span>
              <button type="button" class="theatre-step-btn" id="theatre-next-btn" aria-label="Next demo (Right arrow)">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
              </button>
            </div>
          </div>
        </div>
      </aside>
    </main>

    <!-- Bottom Reel Strip (Horizontal Scrub Carousel) -->
    <footer class="theatre-carousel-strip">
      <div class="theatre-thumbnails-track" id="theatre-thumbnails" role="tablist" aria-label="Demo thumbnails">
        {demos.map((d, index) => (
          <button
            type="button"
            class:list={["theatre-thumb-item", index === 0 && "is-active"]}
            data-index={index}
            data-slug={d.slug}
            data-category={d.category}
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            aria-label={`Select ${d.businessName}`}
          >
            <div class="thumb-poster">
              <img
                src={`/images/demos/${d.slug}/thumb.webp`}
                alt=""
                width="140"
                height="90"
                loading="lazy"
                decoding="async"
              />
              <span class="thumb-number">{String(index + 1).padStart(2, "0")}</span>
            </div>
            <div class="thumb-info">
              <span class="thumb-name">{d.businessName}</span>
              <span class="thumb-cat">{d.category}</span>
            </div>
          </button>
        ))}
      </div>
    </footer>
  </div>
</div>

<!-- Structured client data for fast switching without server roundtrips -->
<script id="theatre-data" type="application/json" is:inline set:html={JSON.stringify(demos)}></script>

<script src="../../scripts/theatre-controller.ts"></script>

<style>
  /* =========================================================
     CINEMATIC DEMO THEATRE — INVENTIKO-GRADE DARK LUXURY CSS
     ========================================================= */
  .cinematic-theatre {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1);
    background-color: #060608 !important; /* 100% solid pitch black luxury — zero bleed through */
  }

  .cinematic-theatre.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .theatre-backdrop {
    position: absolute;
    inset: 0;
    cursor: pointer;
  }

  .theatre-ambient-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(193, 82, 46, 0.28) 0%, rgba(200, 145, 44, 0.12) 45%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
    transform: translate(-50%, -50%);
    top: 45%;
    left: 45%;
    transition: all 800ms ease;
  }

  .theatre-shell {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    max-width: 1560px;
    padding: 1.25rem;
    box-sizing: border-box;
    overflow: hidden;
  }

  /* --- Header Bar --- */
  .theatre-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    border-radius: 9999px;
    background: rgba(26, 26, 30, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(16px);
    color: #fff;
    gap: 1rem;
    flex-shrink: 0;
  }

  .theatre-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .theatre-live-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 9999px;
    background-color: #22c55e;
    box-shadow: 0 0 12px #22c55e;
    animation: livePulse 2s infinite;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .theatre-titles {
    display: flex;
    flex-direction: column;
  }

  .theatre-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #ea580c;
    text-transform: uppercase;
  }

  .theatre-subline {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.65);
  }

  /* Viewport switcher */
  .theatre-viewport-switcher {
    display: flex;
    align-items: center;
    background: rgba(15, 15, 18, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    padding: 0.25rem;
    gap: 0.25rem;
  }

  .theatre-vp-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem;
    font-size: 0.78rem;
    font-weight: 600;
    border-radius: 9999px;
    color: rgba(255, 255, 255, 0.6);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 200ms ease;
  }

  .theatre-vp-btn.is-active {
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .theatre-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .theatre-sound-toggle {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 200ms ease;
  }

  .theatre-sound-toggle.is-active {
    color: #22c55e;
    border-color: rgba(34, 197, 94, 0.35);
    background: rgba(34, 197, 94, 0.1);
  }

  .sound-wave-icon {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 12px;
  }

  .sound-wave-icon i {
    width: 2px;
    height: 8px;
    background: currentColor;
    border-radius: 1px;
    animation: waveBar 1.2s ease-in-out infinite;
  }
  .sound-wave-icon i:nth-child(2) { height: 12px; animation-delay: 0.2s; }
  .sound-wave-icon i:nth-child(3) { height: 6px; animation-delay: 0.4s; }

  @keyframes waveBar {
    0%, 100% { transform: scaleY(0.5); }
    50% { transform: scaleY(1.2); }
  }

  .theatre-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #fff;
    cursor: pointer;
    transition: all 200ms ease;
  }

  .theatre-close-btn:hover {
    background: rgba(239, 68, 68, 0.2);
    border-color: rgba(239, 68, 68, 0.4);
    color: #f87171;
    transform: scale(1.05);
  }

  /* --- Category Pills --- */
  .theatre-category-bar {
    margin-top: 0.75rem;
    flex-shrink: 0;
  }

  .theatre-pills-scroll {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 0.25rem;
  }
  .theatre-pills-scroll::-webkit-scrollbar { display: none; }

  .theatre-pill {
    padding: 0.35rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 9999px;
    white-space: nowrap;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.65);
    cursor: pointer;
    transition: all 200ms ease;
  }

  .theatre-pill.is-active,
  .theatre-pill:hover {
    background: rgba(234, 88, 12, 0.2);
    border-color: rgba(234, 88, 12, 0.5);
    color: #fed7aa;
  }

  /* --- Main Stage & Inspector --- */
  .theatre-stage-area {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 1.5rem;
    flex: 1;
    min-height: 0;
    margin-top: 0.75rem;
    align-items: center;
  }

  .theatre-stage-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 0;
    perspective: 1200px;
  }

  .theatre-device-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
    transform-style: preserve-3d;
  }

  /* --- Mobile Phone 3D Titanium Frame --- */
  .theatre-phone-frame {
    position: relative;
    width: 340px;
    height: 690px;
    max-height: calc(100vh - 230px);
    aspect-ratio: 9 / 19.5;
    background: #0f0f12;
    border-radius: 48px;
    padding: 10px;
    box-shadow:
      0 0 0 3px #38383e,
      0 0 0 6px #1c1c1e,
      0 25px 60px -10px rgba(0, 0, 0, 0.95),
      0 0 50px rgba(193, 82, 46, 0.25);
    transition: all 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .phone-dynamic-island {
    position: absolute;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    width: 86px;
    height: 22px;
    background: #000;
    border-radius: 9999px;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 10px;
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.5);
    pointer-events: none;
  }

  .island-camera {
    width: 9px;
    height: 9px;
    border-radius: 9999px;
    background: #0c1a26;
    border: 1px solid #1e3a5f;
  }

  .island-sensor {
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: #141417;
  }

  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 38px;
    overflow: hidden;
    background: #ffffff;
  }

  .phone-poster-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    z-index: 5;
    transition: opacity 250ms ease;
    background: #fff;
  }

  .phone-live-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    background: #ffffff;
    z-index: 6;
    border-radius: 38px;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .phone-glare {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, transparent 40%);
    pointer-events: none;
    z-index: 25;
  }

  .phone-home-indicator {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 4px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.5);
    z-index: 20;
  }

  /* --- Desktop Studio Frame --- */
  .theatre-desktop-frame {
    display: none;
    width: 840px;
    max-width: calc(100vw - 440px);
    height: 520px;
    max-height: calc(100vh - 220px);
    background: #18181b;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 30px 80px -15px rgba(0, 0, 0, 0.95),
      0 0 50px rgba(193, 82, 46, 0.2);
    overflow: hidden;
    flex-direction: column;
    position: relative;
  }

  .desktop-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1rem;
    background: #121215;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
    z-index: 10;
  }

  .desktop-dots {
    display: flex;
    gap: 6px;
  }

  .desktop-dots .dot {
    width: 10px;
    height: 10px;
    border-radius: 9999px;
  }
  .desktop-dots .red { background: #ef4444; }
  .desktop-dots .yellow { background: #eab308; }
  .desktop-dots .green { background: #22c55e; }

  .desktop-url-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 0.2rem 1rem;
    border-radius: 6px;
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.7);
    width: 280px;
    justify-content: center;
  }

  .desktop-badge {
    font-size: 0.68rem;
    font-weight: 700;
    color: #f97316;
    letter-spacing: 0.05em;
  }

  .desktop-screen {
    flex: 1;
    position: relative;
    overflow: hidden;
    background: #ffffff;
  }

  .theatre-poster-desktop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    z-index: 5;
    transition: opacity 250ms ease;
    background: #fff;
  }

  .theatre-live-iframe-desktop {
    position: absolute;
    top: 0;
    left: 0;
    width: 1280px;
    height: 750px;
    border: none;
    background: #ffffff;
    z-index: 6;
    transform-origin: top left;
  }

  /* Switch view mode */
  .cinematic-theatre[data-mode="desktop"] .theatre-phone-frame { display: none; }
  .cinematic-theatre[data-mode="desktop"] .theatre-desktop-frame { display: flex; }

  /* --- Inspector Card --- */
  .theatre-inspector {
    height: 100%;
    display: flex;
    align-items: center;
  }

  .inspector-card {
    background: rgba(24, 24, 27, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    padding: 1.75rem;
    backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
    width: 100%;
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.6);
  }

  .inspector-badge-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .inspector-category {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
