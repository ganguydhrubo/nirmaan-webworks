---
import { siteConfig } from "@config/site";
interface Props {
  class?: string;
  variant?: "default" | "light";
}
const { class: className = "", variant = "default" } = Astro.props;
const textColor = variant === "light" ? "text-cream" : "text-ink-950";
const brandColor = variant === "light" ? "text-brand-300" : "text-brand-600";
---

<a href="/" class:list={["inline-flex items-center gap-2.5 group", className]} aria-label={`${siteConfig.businessName} — home`}>
  <svg viewBox="0 0 40 40" class="h-9 w-9 shrink-0" aria-hidden="true">
    <rect x="2" y="2" width="36" height="36" rx="10" fill="var(--color-brand-600)"></rect>
    <path d="M17 13 10 20 17 27" stroke="var(--color-cream)" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M23 13 30 20 23 27" stroke="var(--color-cream)" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span class:list={["font-display text-lg font-semibold leading-none", textColor]}>
    webjobs<span class={brandColor}>.site</span>
  </span>
</a>
