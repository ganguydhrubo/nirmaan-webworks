---
import { siteConfig } from "@config/site";
interface Props {
  class?: string;
  variant?: "default" | "light";
}
const { class: className = "", variant = "default" } = Astro.props;
const textColor = variant === "light" ? "text-cream" : "text-ink-950";
const brandColor = variant === "light" ? "text-gold-300" : "text-brand-600";
---

<a href="/" class:list={["inline-flex items-center gap-2.5 group", className]} aria-label={`${siteConfig.businessName} — home`}>
  <svg viewBox="0 0 40 40" class="h-9 w-9 shrink-0 transition-transform duration-300 group-hover:scale-105" aria-hidden="true">
    <defs>
      <linearGradient id="wjs-mark" x1="2" y1="2" x2="38" y2="38" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="var(--color-brand-500)"></stop>
        <stop offset="1" stop-color="var(--color-brand-700)"></stop>
      </linearGradient>
    </defs>
    <rect x="1.5" y="1.5" width="37" height="37" rx="11" fill="url(#wjs-mark)"></rect>
    <rect x="1.5" y="1.5" width="37" height="37" rx="11" fill="none" stroke="rgba(255,255,255,0.14)" stroke-width="1"></rect>
    <path d="M16.5 12.5 9 20l7.5 7.5" stroke="var(--color-cream)" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M23.5 12.5 31 20l-7.5 7.5" stroke="var(--color-cream)" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
    <circle cx="20" cy="20" r="2.1" fill="var(--color-gold-400)"></circle>
  </svg>
  <span class:list={["font-display text-lg font-semibold leading-none tracking-tight", textColor]}>
    webjobs<span class={brandColor}>.site</span>
  </span>
</a>
