---
import { siteConfig } from "@config/site";
interface Props {
  class?: string;
  variant?: "default" | "light";
}
const { class: className = "", variant = "default" } = Astro.props;
const textColor = variant === "light" ? "text-cream" : "text-ink-950";
---

<a href="/" class:list={["inline-flex items-center gap-2.5 group", className]} aria-label={`${siteConfig.businessName} — home`}>
  <svg viewBox="0 0 100 100" class="h-9 w-9 shrink-0 transition-transform duration-300 group-hover:scale-105" aria-hidden="true">
    <defs>
      <linearGradient id="atittle-mark" x1="10" y1="6" x2="90" y2="96" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#eef4ff"></stop>
        <stop offset="0.45" stop-color="#5b8def"></stop>
        <stop offset="1" stop-color="#1548c9"></stop>
      </linearGradient>
      <linearGradient id="atittle-mark-2" x1="90" y1="6" x2="10" y2="96" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#eef4ff"></stop>
        <stop offset="0.45" stop-color="#4f7fe8"></stop>
        <stop offset="1" stop-color="#0f3aa8"></stop>
      </linearGradient>
    </defs>
    <rect x="1" y="1" width="98" height="98" rx="24" fill="#0a1330"></rect>
    <path d="M50 16 20 86" stroke="url(#atittle-mark)" stroke-width="13" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M50 16 80 86" stroke="url(#atittle-mark-2)" stroke-width="13" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M33 62 67 62" stroke="url(#atittle-mark)" stroke-width="11" fill="none" stroke-linecap="round"></path>
  </svg>
  <span class:list={["font-display text-lg font-bold uppercase leading-none tracking-wide", textColor]}>
    ATITTLE
  </span>
</a>
