---
interface Props {
  id?: string;
  variant?: 'dropdown' | 'segmented';
  class?: string;
}

const { id = 'lang-selector', variant = 'dropdown', class: className = '' } = Astro.props;
---

{variant === 'dropdown' ? (
  <div class:list={['lang-selector-container relative inline-block text-left', className]}>
    <button
      type="button"
      id={id + '-btn'}
      data-lang-trigger
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-label="Select language: currently English"
      class="group inline-flex h-9 items-center gap-1.5 rounded-full border border-brand-400/50 bg-brand-50/50 px-2.5 py-1 text-xs font-semibold text-brand-900 shadow-xs ring-1 ring-brand-500/15 hover:border-brand-600 hover:bg-brand-50 hover:shadow-sm hover:ring-brand-500/25 transition cursor-pointer"
    >
      <svg class="h-3.5 w-3.5 text-brand-600 shrink-0 group-hover:scale-110 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="2" y1="12" x2="22" y2="12"></line>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      </svg>
      <span class="inline-block text-[11px] font-bold tracking-wider text-brand-700" data-lang-short-label>EN</span>
      <span class="sr-only" data-lang-current-label>English</span>
      <svg class="h-3 w-3 text-brand-600/70 group-hover:text-brand-700 transition-transform duration-200" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
      </svg>
    </button>

    <div
      role="listbox"
      aria-labelledby={id + '-btn'}
      class="lang-dropdown hidden absolute right-0 mt-1.5 w-36 origin-top-right rounded-xl border border-brand-200/90 bg-white p-1.5 shadow-xl ring-1 ring-black/5 z-50 focus:outline-hidden"
    >
      <button
        type="button"
        role="option"
        data-set-lang="en"
        class="lang-option flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-xs font-medium text-ink-800 hover:bg-brand-50 hover:text-brand-700 transition cursor-pointer"
      >
        <span>English</span>
        <span class="text-[10px] font-bold text-ink-400">EN</span>
      </button>
      <button
        type="button"
        role="option"
        data-set-lang="bn"
        class="lang-option flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-xs font-medium text-ink-800 hover:bg-brand-50 hover:text-brand-700 transition cursor-pointer"
      >
        <span>বাংলা</span>
        <span class="text-[10px] font-bold text-ink-400">BN</span>
      </button>
      <button
        type="button"
        role="option"
        data-set-lang="hi"
        class="lang-option flex w-full items-center justify-between rounded-lg px-2.5 py-1.5 text-xs font-medium text-ink-800 hover:bg-brand-50 hover:text-brand-700 transition cursor-pointer"
      >
        <span>हिंदी</span>
        <span class="text-[10px] font-bold text-ink-400">HI</span>
      </button>
    </div>
  </div>
) : (
  <div class:list={['lang-segmented-wrapper w-full', className]}>
    <div class="mb-1.5 flex items-center gap-1.5 px-1 text-[11px] font-bold tracking-wider text-brand-800 uppercase">
      <svg class="h-3.5 w-3.5 text-brand-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="2" y1="12" x2="22" y2="12"></line>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      </svg>
      <span>Language / ভাষা / भाषा</span>
    </div>
    <div id={id} class="lang-segmented flex items-center justify-center gap-1 rounded-xl border border-brand-300/80 bg-brand-50/40 p-1 shadow-2xs ring-1 ring-brand-500/10" role="group" aria-label="Language selection">
      <button
        type="button"
        data-set-lang="en"
        class="lang-segment-btn flex-1 rounded-lg px-2.5 py-1.5 text-center text-xs font-semibold text-ink-700 hover:text-brand-600 transition cursor-pointer"
        aria-label="English"
      >
        English
      </button>
      <div class="h-3.5 w-px bg-brand-200/80" aria-hidden="true"></div>
      <button
        type="button"
        data-set-lang="bn"
        class="lang-segment-btn flex-1 rounded-lg px-2.5 py-1.5 text-center text-xs font-semibold text-ink-700 hover:text-brand-600 transition cursor-pointer"
        aria-label="বাংলা (Bengali)"
      >
        বাংলা
      </button>
      <div class="h-3.5 w-px bg-brand-200/80" aria-hidden="true"></div>
      <button
        type="button"
        data-set-lang="hi"
        class="lang-segment-btn flex-1 rounded-lg px-2.5 py-1.5 text-center text-xs font-semibold text-ink-700 hover:text-brand-600 transition cursor-pointer"
        aria-label="हिंदी (Hindi)"
      >
        हिंदी
      </button>
    </div>
  </div>
)}

<style>
  .lang-dropdown.is-open {
    display: block !important;
  }
  .lang-option.is-active {
    background-color: var(--color-brand-50);
    color: var(--color-brand-700);
    font-weight: 700;
  }
  .lang-option.is-active span:last-child {
    color: var(--color-brand-600);
  }
  .lang-segment-btn.is-active {
    background-color: #ffffff;
    color: var(--color-brand-700);
    font-weight: 700;
    border: 1px solid rgba(184, 69, 30, 0.25);
    box-shadow: 0 2px 4px rgba(184, 69, 30, 0.12), 0 1px 2px rgba(0, 0, 0, 0.05);
  }
</style>
