---
import Logo from "@/components/ui/Logo.astro";
import Icon from "@/components/ui/Icon.astro";
import { siteConfig } from "@config/site";
import { telLink, waLink } from "@/lib/contact-links";

const navItems = [
  { href: "/industries", label: "Industries" },
  { href: "/demos", label: "Demos" },
  { href: "/tools/website-evaluator", label: "AI Evaluator" },
  { href: "/pricing", label: "Pricing" },
  { href: "/work-process", label: "Process" },
  { href: "/about", label: "About" },
  { href: "/faq", label: "FAQ" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-ink-200/70 bg-cream/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <Logo />

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={currentPath === item.href || currentPath.startsWith(item.href + "/") ? "page" : undefined}
              class:list={[
                "rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-ink-100 hover:text-brand-600",
                (currentPath === item.href || currentPath.startsWith(item.href + "/")) && "text-brand-600",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={telLink()} class="flex items-center gap-1.5 text-sm font-medium text-ink-700 hover:text-brand-600" data-analytics-event="call_click">
        <Icon name="phone" class="h-4 w-4" />
        {siteConfig.phoneDisplay}
      </a>
      <a
        href="/contact"
        class="rounded-md bg-brand-600 px-4 py-2.5 text-sm font-semibold text-cream shadow-sm transition hover:bg-brand-700"
        data-analytics-event="cta_click"
      >
        Get a free quote
      </a>
    </div>

    <button
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
      aria-label="Open menu"
      class="inline-flex h-11 w-11 items-center justify-center rounded-md text-ink-800 lg:hidden"
    >
      <Icon name="menu" class="h-6 w-6" />
    </button>
  </div>

  <!-- Mobile nav overlay -->
  <div data-nav-scrim hidden class="fixed inset-0 z-40 bg-ink-950/40 lg:hidden"></div>
  <div
    id="mobile-nav-panel"
    data-nav-panel
    hidden
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
    class="fixed inset-y-0 right-0 z-50 flex w-[85%] max-w-sm flex-col gap-6 overflow-y-auto bg-cream p-6 shadow-xl lg:hidden"
    style="padding-top: max(1.5rem, env(safe-area-inset-top)); padding-bottom: max(1.5rem, env(safe-area-inset-bottom));"
  >
    <div class="flex items-center justify-between">
      <Logo />
      <button type="button" data-nav-close aria-label="Close menu" class="inline-flex h-11 w-11 items-center justify-center rounded-md text-ink-800">
        <Icon name="close" class="h-6 w-6" />
      </button>
    </div>
    <nav aria-label="Mobile">
      <ul class="flex flex-col gap-1">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="block rounded-md px-3 py-3 text-lg font-medium text-ink-900 hover:bg-ink-100">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mt-auto flex flex-col gap-3 border-t border-ink-200 pt-5">
      <a href={telLink()} class="flex items-center gap-2 text-base font-medium text-ink-800" data-analytics-event="call_click">
        <Icon name="phone" class="h-5 w-5" /> {siteConfig.phoneDisplay}
      </a>
      <a href={waLink(siteConfig.whatsappMessageTemplates.header)} target="_blank" rel="noopener" aria-label="Chat on WhatsApp (opens WhatsApp)" class="flex items-center gap-2 text-base font-medium text-teal-700" data-analytics-event="whatsapp_click">
        <Icon name="whatsapp" class="h-5 w-5" /> Chat on WhatsApp
      </a>
      <a href="/contact" class="mt-2 rounded-md bg-brand-600 px-4 py-3 text-center text-base font-semibold text-cream" data-analytics-event="cta_click">
        Get a free quote
      </a>
    </div>
  </div>
</header>
