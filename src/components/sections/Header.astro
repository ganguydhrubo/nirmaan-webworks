---
import Logo from "@/components/ui/Logo.astro";
import Icon from "@/components/ui/Icon.astro";
import { siteConfig } from "@config/site";
import { telLink, waLink } from "@/lib/contact-links";

const navItems = [
  { href: "/industries", label: "Industries" },
  { href: "/demos", label: "Demos" },
  { href: "/services", label: "More Services", hasDot: true },
  { href: "/tools/website-evaluator", label: "AI Evaluator" },
  { href: "/pricing", label: "Pricing" },
  { href: "/work-process", label: "Process" },
  { href: "/about", label: "About" },
  { href: "/faq", label: "FAQ" },
];

const currentPath = Astro.url.pathname;
---

<header>
  <!--
    The sticky/blur bar is deliberately a plain inner div, not the <header>
    itself: `backdrop-filter` (Tailwind's `backdrop-blur`) makes an element a
    CSS containing block for `position: fixed` descendants, exactly like
    `transform` or `filter` do. With backdrop-blur on <header>, the mobile
    nav panel below (fixed, inset-y-0) was resolving its top/bottom against
    the ~68px-tall header instead of the viewport — it "opened" but rendered
    as an unusable sliver. Keeping <header> itself filter-free means its
    fixed-position descendants (the panel, the scrim) correctly position
    against the viewport instead.
  -->
  <div class="sticky top-0 z-40 border-b border-ink-200/70 bg-cream/95 backdrop-blur transition-transform duration-200" id="site-header-bar">
  <div class="header-inner mx-auto flex max-w-7xl items-center justify-between gap-2 px-4 py-2 sm:py-3 sm:px-6 lg:px-8 xl:gap-4 transition-transform duration-200">
    <Logo />

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-0.5 xl:gap-1">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={currentPath === item.href || currentPath.startsWith(item.href + "/") ? "page" : undefined}
              class:list={[
                "whitespace-nowrap rounded-md px-2 py-2 text-sm font-medium transition-colors hover:bg-ink-100 hover:text-brand-600 xl:px-3",
                (currentPath === item.href || currentPath.startsWith(item.href + "/")) && "text-brand-600",
              ]}
            >
              <span class="inline-flex items-center gap-1.5">
                {item.label}
                {item.hasDot && (
                  <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-2 lg:flex xl:gap-3">
      <a href={telLink()} class="hidden items-center gap-1.5 whitespace-nowrap text-sm font-medium text-ink-700 hover:text-brand-600 xl:flex" data-analytics-event="call_click">
        <Icon name="phone" class="h-4 w-4" />
        {siteConfig.phoneDisplay}
      </a>
      <a
        href="/contact"
        class="whitespace-nowrap rounded-md bg-brand-600 px-3 py-2.5 text-sm font-semibold text-cream shadow-sm transition hover:bg-brand-700 xl:px-4"
        data-analytics-event="cta_click"
      >
        Get a free quote
      </a>
    </div>

    <button
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="mobile-nav-panel"
      aria-label="Open menu"
      class="inline-flex h-11 w-11 items-center justify-center rounded-md text-ink-800 lg:hidden"
    >
      <Icon name="menu" class="h-6 w-6" />
    </button>
  </div>
  </div>

  <!-- Mobile nav overlay: deliberately outside the sticky/blur div above, see the comment on <header> for why. -->
  <div data-nav-scrim hidden class="mobile-nav-scrim fixed inset-0 z-40 bg-ink-950/40 lg:hidden"></div>
  <div
    id="mobile-nav-panel"
    data-nav-panel
    hidden
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
    class="mobile-nav-panel fixed inset-y-0 right-0 z-50 flex w-[85%] max-w-sm flex-col gap-6 overflow-y-auto bg-cream p-6 shadow-2xl lg:hidden"
    style="padding-top: max(1.5rem, env(safe-area-inset-top)); padding-bottom: max(1.5rem, env(safe-area-inset-bottom));"
  >
    <div class="flex items-center justify-between">
      <Logo />
      <button type="button" data-nav-close aria-label="Close menu" class="inline-flex h-11 w-11 items-center justify-center rounded-md text-ink-800 hover:bg-ink-100 transition-colors">
        <Icon name="close" class="h-6 w-6" />
      </button>
    </div>
    <nav aria-label="Mobile">
      <ul class="flex flex-col gap-1">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="mobile-nav-link flex items-center justify-between rounded-md px-3 py-3 text-lg font-medium text-ink-900 hover:bg-ink-100 transition-colors">
              <span class="mobile-nav-typed inline-flex items-center gap-2" data-nav-label={item.label}>
                <span class="typed-text">{item.label}</span>
                <span class="typed-cursor is-done" aria-hidden="true"></span>
                {item.hasDot && (
                  <span class="nav-pulse-dot inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
                )}
              </span>
              {item.hasDot && (
                <span class="nav-badge-new rounded bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-800">7 New</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mt-auto flex flex-col gap-3 border-t border-ink-200 pt-5">
      <a href={telLink()} class="flex items-center gap-2 text-base font-medium text-ink-800" data-analytics-event="call_click">
        <Icon name="phone" class="h-5 w-5" /> {siteConfig.phoneDisplay}
      </a>
      <a href={waLink(siteConfig.whatsappMessageTemplates.header)} target="_blank" rel="noopener" aria-label="Chat on WhatsApp (opens WhatsApp)" class="flex items-center gap-2 text-base font-medium text-teal-700" data-analytics-event="whatsapp_click">
        <Icon name="whatsapp" class="h-5 w-5" /> Chat on WhatsApp
      </a>
      <a href="/contact" class="mt-2 rounded-md bg-brand-600 px-4 py-3 text-center text-base font-semibold text-cream" data-analytics-event="cta_click">
        Get a free quote
      </a>
      <div class="mt-2 flex items-center justify-center gap-3 pt-2">
        <a
          href="https://www.facebook.com/atittleweb"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-ink-300 bg-white text-ink-700 shadow-2xs hover:border-[#1877F2] hover:text-[#1877F2] transition"
          aria-label="Follow ATITTLE on Facebook (opens in new tab)"
        >
          <Icon name="facebook" class="h-4 w-4" />
        </a>
        <a
          href="https://www.instagram.com/atittleweb/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-ink-300 bg-white text-ink-700 shadow-2xs hover:border-[#E4405F] hover:text-[#E4405F] transition"
          aria-label="Follow ATITTLE on Instagram (opens in new tab)"
        >
          <Icon name="instagram" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  (function () {
    const bar = document.getElementById("site-header-bar");
    if (!bar) return;
    let isScrolled = false;
    window.addEventListener(
      "scroll",
      () => {
        const scrolled = window.scrollY > 40;
        if (scrolled !== isScrolled) {
          isScrolled = scrolled;
          bar.classList.toggle("header--scrolled", scrolled);
        }
      },
      { passive: true }
    );
  })();
</script>

<style>
  #site-header-bar.header--scrolled {
    transform: translateY(-2px);
  }
  #site-header-bar.header--scrolled .header-inner {
    transform: scale(0.98);
  }

  /* Mobile Nav Panel & Scrim Smooth Transitions */
  .mobile-nav-scrim {
    opacity: 0;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: opacity 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mobile-nav-scrim.is-open {
    opacity: 1;
  }

  .mobile-nav-panel {
    transform: translateX(100%);
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mobile-nav-panel.is-open {
    transform: translateX(0);
  }

  /* Menu Items Typing & Stable States */
  .mobile-nav-link {
    opacity: 0;
    transform: translateX(14px);
    transition: opacity 240ms cubic-bezier(0.16, 1, 0.3, 1), transform 240ms cubic-bezier(0.16, 1, 0.3, 1), background-color 150ms ease;
  }
  .mobile-nav-link.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  .typed-cursor {
    display: inline-block;
    width: 2px;
    height: 1.15em;
    background-color: var(--color-brand-600);
    margin-left: 2px;
    vertical-align: middle;
    animation: cursorBlink 600ms infinite ease-in-out;
  }
  .typed-cursor.is-done {
    display: none;
  }
  @keyframes cursorBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .mobile-nav-typed.is-stable .typed-text {
    animation: textSettle 400ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes textSettle {
    0% {
      color: var(--color-brand-600);
      letter-spacing: -0.015em;
    }
    50% {
      letter-spacing: 0.01em;
    }
    100% {
      color: var(--color-ink-900);
      letter-spacing: 0;
    }
  }

  .nav-badge-new {
    opacity: 0;
    transform: scale(0.65);
    transition: opacity 250ms ease, transform 300ms cubic-bezier(0.2, 0.9, 0.3, 1.25);
  }
  .nav-badge-new.is-visible {
    opacity: 1;
    transform: scale(1);
  }

  .nav-pulse-dot {
    opacity: 0;
    transform: scale(0);
    transition: opacity 200ms ease, transform 250ms cubic-bezier(0.2, 0.9, 0.3, 1.25);
  }
  .nav-pulse-dot.is-visible {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header-bar,
    #site-header-bar .header-inner,
    .mobile-nav-scrim,
    .mobile-nav-panel,
    .mobile-nav-link,
    .nav-badge-new,
    .nav-pulse-dot {
      transform: none !important;
      transition: none !important;
      opacity: 1 !important;
    }
    .typed-cursor {
      display: none !important;
    }
    .mobile-nav-typed.is-stable .typed-text {
      animation: none !important;
    }
  }
</style>
