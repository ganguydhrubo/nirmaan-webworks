---
import { performanceReport } from "@/data/performance";

const homePerf = performanceReport.pages.find((p) => p.path === "/");
---

<section class="bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal grid gap-8 sm:gap-10 rounded-2xl border border-ink-200 bg-cream p-5 sm:p-10 lg:p-12 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-semibold text-ink-950">We measure this site, we don't just describe it</h2>
        <p class="mt-3 text-sm sm:text-base text-ink-700">
          Every claim an agency makes about speed is easy to say and hard to check. So instead of telling you this site is fast, here is the actual Lighthouse score for the page you're reading right now, tested on a throttled mobile connection.
        </p>
        {performanceReport.measured && (
          <p class="mt-3 text-xs sm:text-sm text-ink-500">Measured on {performanceReport.measuredOn} · {performanceReport.device}</p>
        )}
      </div>

      {performanceReport.measured && homePerf ? (
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 min-w-0">
          {[
            { label: "Performance", value: homePerf.performance },
            { label: "Accessibility", value: homePerf.accessibility },
            { label: "Best Practices", value: homePerf.bestPractices },
            { label: "SEO", value: homePerf.seo },
          ].map((m) => (
            <div class="rounded-xl border border-ink-200 bg-white p-3.5 sm:p-5 text-center min-w-0 shadow-2xs">
              <p class="font-display text-2xl sm:text-3xl font-bold text-brand-600 tabular-nums">{m.value}</p>
              <p class="mt-1 text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-ink-500 break-words leading-tight">{m.label}</p>
            </div>
          ))}
        </div>
      ) : (
        <div class="rounded-xl border border-dashed border-ink-300 bg-white p-6 text-sm text-ink-500">
          Full Lighthouse results for this site are published in TESTING.md and will appear here once the build is complete and measured — not before.
        </div>
      )}
    </div>
  </div>
</section>
