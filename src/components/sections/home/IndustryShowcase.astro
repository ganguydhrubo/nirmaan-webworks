---
import { siteConfig } from "@config/site";
import DemoDirectory from "@/components/ui/DemoDirectory.astro";
---
<section id="industries" data-theme="dark" data-dock-title="Live Demos" data-dock-desc="15 working industry websites" class="bg-ink-950 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="reveal max-w-2xl">
      <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-brand-300" data-i18n="industryShowcase.badge">Built around your business</p>
      <h2 class="font-display text-3xl font-semibold text-cream sm:text-4xl" data-i18n="industryShowcase.heading">See the actual demo, not a mockup</h2>
      <p class="mt-4 text-lg text-ink-300">{siteConfig.demoRegistry.length} real, working websites built for {siteConfig.demoRegistry.length} kinds of Indian businesses. Click through — every page, filter, gallery and form actually works.</p>
      <a href="/demos" class="mt-6 inline-flex min-h-11 items-center gap-4 font-semibold text-brand-300" data-i18n="industryShowcase.viewAllIndustries">Watch the full showcase <span aria-hidden="true">↗</span></a>
    </div>
    <div class="mt-8 rounded-xl bg-cream px-5"><DemoDirectory /></div>
    <p class="mt-6 text-sm text-ink-300">These are demonstration sites for fictional businesses, built to show our design and engineering quality — not real clients.</p>
  </div>
</section>
