---
import { siteConfig } from "@config/site";
import Icon from "@/components/ui/Icon.astro";

const demoBySlug = Object.fromEntries(siteConfig.demoRegistry.map((d) => [d.industrySlug, d]));
---

<section id="industries" class="bg-ink-950 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-semibold text-cream sm:text-4xl">See the actual demo, not a mockup</h2>
      <p class="mt-4 text-lg text-ink-300">
        Six real, working websites built for six kinds of Indian businesses. Click through — every page, filter, gallery and form actually works.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {siteConfig.industryRegistry.map((industry) => {
        const demo = demoBySlug[industry.slug];
        return (
          <a href={`/demos/${demo?.slug}`} class="reveal group overflow-hidden rounded-xl border border-ink-800 bg-ink-900 transition hover:border-brand-500/50">
            <div class="aspect-[4/3] overflow-hidden bg-ink-800">
              <img
                src={`/images/demos/${demo?.slug}/card.jpg`}
                alt={`Homepage preview of the ${demo?.businessName} demo, a ${industry.shortName.toLowerCase()} website`}
                width="480"
                height="360"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              />
            </div>
            <div class="p-5">
              <p class="text-xs font-semibold uppercase tracking-wide text-brand-400">{industry.shortName}</p>
              <h3 class="mt-1 font-display text-lg font-semibold text-cream">{demo?.businessName}</h3>
              <p class="mt-1 text-sm text-ink-400">{demo?.tagline} — {demo?.city}</p>
              <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-brand-400 group-hover:text-brand-300">
                Open live demo <Icon name="chevron-right" class="h-4 w-4" />
              </span>
            </div>
          </a>
        );
      })}
    </div>

    <p class="reveal mt-10 text-center text-sm text-ink-400">
      These are demonstration sites for fictional businesses, built to show our design and engineering quality — not real clients.
    </p>
  </div>
</section>
