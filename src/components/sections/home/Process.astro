---
const steps = [
  {
    n: "01",
    time: "Day 1",
    badge: "Scope & Rupee Quote",
    title: "Enquiry & Scoping Call",
    body: "You tell us about your business, current aggregator bleed, and what you need. We confirm exact pages, features, and a fixed price in INR within one business day.",
    deliverable: "Signed Scope Sheet · Fixed INR Quote · Dedicated WhatsApp Thread",
  },
  {
    n: "02",
    time: "Days 2–4",
    badge: "Content Blueprint",
    title: "Content Architecture & Mapping",
    body: "We collect your photos, service rates, and clinic/menu details (or shape them with you). We structure every page for thumb ergonomics before writing any code.",
    deliverable: "Sitemap Blueprint · Copy Architecture · WhatsApp Action Triggers",
  },
  {
    n: "03",
    time: "Days 5–10",
    badge: "Astro 7 Engineering",
    title: "Design & Mobile-First Build",
    body: "We build your site with sub-second performance. You receive a private staging URL to test real working buttons and interactions on your own phone.",
    deliverable: "Private Staging Link · Sub-Second Core Web Vitals · 360px Tested",
  },
  {
    n: "04",
    time: "Days 11–13",
    badge: "Real-Device Pass",
    title: "Owner Review & Revisions",
    body: "You review the live preview on your phone. We implement your consolidated feedback pass so everything matches your brand standards without timeline drift.",
    deliverable: "Consolidated Revisions Applied · Cross-Device Verification",
  },
  {
    n: "05",
    time: "Day 14",
    badge: "100% Handover",
    title: "DNS Pointing & Go-Live",
    body: "We connect your domain, deploy to global edge CDN, verify Google Maps schema, and hand over every single login credential and code repository.",
    deliverable: "Live Domain · Google Maps Schema · Full Account & Code Handover",
  },
];
---

<section class="bg-white py-16 sm:py-24 border-b border-ink-200" id="process" data-theme="light" data-dock-title="How We Work" data-dock-desc="Predictable milestones & delivery">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-300 bg-brand-50 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-brand-700 shadow-sm" data-i18n="process.badge">
        Predictable Milestones
      </div>
      <h2 class="mt-4 font-display text-3xl font-bold text-ink-950 sm:text-4xl" data-i18n="process.heading">
        How a project actually runs
      </h2>
      <p class="mt-3 text-base sm:text-lg text-ink-700 leading-relaxed" data-i18n="process.subheading">
        Realistic timelines and transparent sprint handoffs — not vague "let's hop on a call" loops.
      </p>
    </div>

    <!-- Timeline Grid -->
    <div class="mt-14 space-y-6 sm:space-y-8">
      {steps.map((step) => (
        <div class="reveal relative flex flex-col sm:flex-row gap-5 sm:gap-6 rounded-2xl border border-ink-200 bg-cream/30 p-6 sm:p-7 shadow-sm transition duration-300 hover:border-brand-500 hover:bg-white hover:shadow-md">
          <!-- Step Number & Time Badge -->
          <div class="flex items-center sm:flex-col justify-between sm:justify-start gap-3 sm:w-28 shrink-0">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-ink-950 font-display text-lg font-bold text-cream shadow-sm">
              {step.n}
            </span>
            <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-brand-700 border border-brand-200 shadow-2xs sm:text-center">
              {step.time}
            </span>
          </div>

          <!-- Content Body -->
          <div class="min-w-0 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-xs font-bold uppercase tracking-wider text-brand-600">
                  {step.badge}
                </span>
              </div>
              <h3 class="mt-1 font-display text-xl font-bold text-ink-950">
                {step.title}
              </h3>
              <p class="mt-2 text-xs sm:text-sm text-ink-600 leading-relaxed max-w-3xl">
                {step.body}
              </p>
            </div>

            <!-- Deliverable Tag -->
            <div class="mt-4 rounded-xl bg-white border border-ink-200/80 px-3.5 py-2 text-xs text-ink-700 flex items-center gap-2">
              <span class="text-brand-600 font-bold shrink-0">Deliverable:</span>
              <span class="font-medium text-ink-900 truncate">{step.deliverable}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Footer Note -->
    <div class="mt-10 rounded-2xl border border-ink-200 bg-cream p-5 sm:p-6 text-center max-w-3xl mx-auto">
      <p class="text-xs sm:text-sm text-ink-700 font-medium">
        ⏱ <strong class="text-ink-950">Turnaround Guarantee:</strong> Starter WhatsApp Storefronts launch in <span class="text-brand-600 font-bold">48 hours</span>. Standard Business Websites launch in <span class="text-brand-600 font-bold">10–14 days</span> from signed scope.
      </p>
    </div>
  </div>
</section>

