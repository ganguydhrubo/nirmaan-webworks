---
---

<div class="hero-speed-chip-container hidden" id="speed-chip-container">
  <div class="speed-chip-flip-card" id="speed-chip-card" tabindex="0" role="button" aria-label="Page load time measured by your browser. Tap to flip.">
    <!-- Front Face -->
    <div class="speed-chip-face speed-chip-front">
      <span class="speed-bolt" aria-hidden="true">⚡</span>
      <span class="speed-chip-text">
        This page loaded in <strong id="speed-chip-value" class="tabular-nums font-mono font-bold text-brand-700">0.00</strong>s on your phone
      </span>
    </div>

    <!-- Back Face -->
    <div class="speed-chip-face speed-chip-back">
      <a href="#proof" class="speed-proof-link" id="speed-proof-link">
        <span class="font-medium text-[10px]">Measured by your browser (LCP)</span>
        <span class="text-brand-700 font-bold ml-1">Proof &rarr;</span>
      </a>
    </div>
  </div>
</div>

<style>
  .hero-speed-chip-container {
    perspective: 800px;
    margin-top: 0.5rem;
    min-height: 26px; /* Reserved space */
  }

  .speed-chip-flip-card {
    position: relative;
    width: fit-content;
    min-width: 26ch;
    height: 26px;
    transform-style: preserve-3d;
    transition: transform 200ms cubic-bezier(0.2, 0.8, 0.3, 1);
    cursor: pointer;
    border-radius: 9999px;
    outline: none;
    user-select: none;
  }
  .speed-chip-flip-card:focus-visible {
    outline: 2px solid var(--color-brand-400);
    outline-offset: 2px;
  }
  .speed-chip-flip-card.is-flipped {
    transform: rotateX(180deg);
  }

  .speed-chip-face {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 11px;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-sizing: border-box;
  }

  .speed-chip-front {
    background: rgba(255, 255, 255, 0.94);
    color: var(--color-ink-900);
    border: 1px solid rgba(193, 82, 46, 0.28);
    box-shadow: 0 2px 8px rgba(193, 82, 46, 0.08);
  }

  .speed-bolt {
    color: #d97706;
    font-size: 12px;
  }

  .speed-chip-back {
    background: #fff7ed;
    color: #9a3412;
    border: 1px solid rgba(193, 82, 46, 0.4);
    transform: rotateX(180deg);
  }

  .speed-proof-link {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .tabular-nums {
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .speed-chip-flip-card {
      transition: none !important;
    }
  }
</style>

<script>
  (function () {
    try {
      // 1. Guard check: do not run or render if API unavailable, saveData active, or reduced motion
      const navConn = (navigator as unknown as { connection?: { saveData?: boolean } }).connection;
      if (navConn && navConn.saveData) return;
      if (typeof window.PerformanceObserver === "undefined") return;

      const container = document.getElementById("speed-chip-container");
      const card = document.getElementById("speed-chip-card");
      const valEl = document.getElementById("speed-chip-value") as HTMLElement | null;
      const proofLink = document.getElementById("speed-proof-link");
      if (!container || !card || !valEl) return;

      let measuredLcpSeconds: number | null = null;

      const observer = new PerformanceObserver((entryList) => {
        const entries = entryList.getEntries();
        if (entries.length === 0) return;
        const lastEntry = entries[entries.length - 1];
        if (lastEntry && lastEntry.startTime > 0) {
          measuredLcpSeconds = lastEntry.startTime / 1000;
        }
      });

      observer.observe({ type: "largest-contentful-paint", buffered: true });

      // After first paint & LCP observer runs, inspect value
      window.addEventListener("load", () => {
        setTimeout(() => {
          // If no LCP observed or LCP > 2.5s, keep hidden (never fake)
          if (measuredLcpSeconds === null || measuredLcpSeconds > 2.5) {
            return;
          }

          // Unhide speed chip container
          container.classList.remove("hidden");

          // Counter animation (counts from 0.00 to measured value over 500ms)
          const target = measuredLcpSeconds;
          const startTime = performance.now();
          const duration = 500;

          const isReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (isReducedMotion) {
            valEl.textContent = target.toFixed(2);
            return;
          }

          function step(currentTime: number) {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);
            // Ease out cubic
            const easeOut = 1 - Math.pow(1 - progress, 3);
            const currentVal = (target * easeOut).toFixed(2);
            if (valEl) {
              valEl.textContent = currentVal;
            }

            if (progress < 1) {
              requestAnimationFrame(step);
            } else if (valEl) {
              valEl.textContent = target.toFixed(2);
            }
          }

          // Trigger count at >= 1800ms
          const delay = Math.max(0, 1800 - performance.now());
          setTimeout(() => {
            requestAnimationFrame(step);
          }, delay);
        }, 150);
      });

      // 3D Flip interaction
      card.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (proofLink && proofLink.contains(target) && card.classList.contains("is-flipped")) {
          // Allow link to navigate to #proof
          return;
        }
        card.classList.toggle("is-flipped");
      });

      card.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          card.classList.toggle("is-flipped");
        }
      });
    } catch (_) {}
  })();
</script>
