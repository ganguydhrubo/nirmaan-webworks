---
import Icon from "@/components/ui/Icon.astro";

const deliverables = [
  {
    icon: "bolt" as const,
    badge: "99/100 Mobile Score",
    title: "A site that loads fast on a real phone",
    body: "Engineered and benchmarked on a real mid-range Android phone over a throttled 4G connection — not just verified on high-speed studio WiFi.",
  },
  {
    icon: "whatsapp" as const,
    badge: "Pre-filled 1-Tap Trigger",
    title: "WhatsApp, call and map built in",
    body: "Every single page makes contacting you natural and thumb-friendly. Customers tap once and arrive in your WhatsApp with the exact service name pre-filled.",
  },
  {
    icon: "shield" as const,
    badge: "Zero Platform Hostage",
    title: "You own the domain, the code and the content",
    body: "Full GitHub repository code, hosting accounts, and domain DNS are assigned directly to your name. If you ever want to move host, you have 100% control.",
  },
  {
    icon: "rupee" as const,
    badge: "Fixed Rupee Contract",
    title: "One clear rupee price before you commit",
    body: "You receive an exact INR scope breakdown before any advance is paid. You will know exactly what is included, what isn't, and what renewals cost upfront.",
  },
  {
    icon: "check" as const,
    badge: "Written For Your City",
    title: "Real content, not lorem ipsum left in",
    body: "We write and shape the words with you — your authentic menu, doctor qualifications, room inclusions, and price lists. No site ever ships with dummy text.",
  },
  {
    icon: "star" as const,
    badge: "Pre-baked JSON-LD Schema",
    title: "Local SEO and Google Business Profile set up",
    body: "Structured LocalBusiness schema so customers searching for your category and locality on Google and AI answer engines find your real website first.",
  },
];
---

<section id="what-we-build" data-theme="light" data-dock-title="What You Get" data-dock-desc="Concrete deliverables, not adjectives" class="bg-white py-16 sm:py-24 border-b border-ink-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto max-w-3xl text-center">
      <div class="inline-flex items-start text-left sm:items-center gap-2 rounded-full border border-brand-300 bg-brand-50/80 px-3.5 py-1 text-xs font-semibold uppercase tracking-wide sm:tracking-wider text-brand-700 shadow-sm max-w-full">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-600 shrink-0 mt-1 sm:mt-0" aria-hidden="true"></span>
        <span class="break-words min-w-0">Concrete Deliverables, Not Adjectives</span>
      </div>
      <h2 class="mt-4 font-display text-3xl font-bold text-ink-950 sm:text-4xl">
        What you actually get
      </h2>
      <p class="mt-3 text-base sm:text-lg text-ink-700 leading-relaxed">
        Everything engineered for real Indian buying behavior — transparent, measurable, and owned 100% by your business.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {deliverables.map((d) => (
        <div class="reveal group relative flex flex-col rounded-2xl border border-ink-200 bg-cream/40 p-6 shadow-sm transition duration-300 hover:border-brand-500 hover:bg-white hover:shadow-md">
          <div class="flex items-center justify-between gap-3">
            <span class="rounded-full bg-white px-2.5 py-1 text-[11px] font-semibold text-brand-700 border border-brand-200 shadow-2xs">
              {d.badge}
            </span>
            <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white text-brand-600 border border-ink-200 shadow-2xs transition group-hover:bg-brand-600 group-hover:text-white group-hover:border-brand-600">
              <Icon name={d.icon} class="h-5 w-5" />
            </div>
          </div>
          <h3 class="mt-4 font-display text-lg font-bold text-ink-950 leading-snug">
            {d.title}
          </h3>
          <p class="mt-2 text-xs sm:text-sm text-ink-600 leading-relaxed">
            {d.body}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

