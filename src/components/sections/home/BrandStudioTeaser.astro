---
/**
 * Homepage entry point for ATITTLE Brand Studio.
 */
---

<section id="brand-studio" data-dock-title="Brand Studio" data-dock-desc="Design brand logos & social posts free" class="bg-cream py-14 sm:py-20 border-t border-ink-200/60">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-8 rounded-3xl border border-ink-200 bg-ink-950 text-cream p-6 sm:p-10 lg:grid-cols-[1.2fr_0.8fr] lg:p-12 shadow-2xl relative overflow-hidden">
      {/* Decorative ambient aura */}
      <div class="absolute -right-20 -top-20 h-72 w-72 rounded-full bg-amber-500/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="min-w-0 relative z-10">
        <p class="inline-flex items-center gap-2 rounded-full bg-amber-500/15 border border-amber-500/30 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-amber-400">
          <span class="h-2 w-2 rounded-full bg-amber-400 animate-pulse" aria-hidden="true"></span> New · Free Brand & Logo Studio
        </p>
        <h2 class="mt-4 font-display text-2xl font-semibold leading-tight text-white sm:text-4xl">
          Craft high-converting social creatives, festival offers, and luxury logos in minutes.
        </h2>
        <p class="mt-3 text-stone-300 sm:text-lg">
          Point-to-point visual design editor with 18 curated Indian business templates, 40+ high-res photography assets, vector icons, and transparent PNG/SVG export. 100% free, no sign-up required.
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:items-stretch relative z-10">
        <a href="/free-brand-studio/app" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-gradient-to-r from-amber-600 to-amber-500 px-6 py-3 font-bold text-stone-950 transition hover:from-amber-500 hover:to-amber-400 shadow-lg shadow-amber-500/20" data-analytics-event="studio_cta_home">
          <span>🎨</span> Open Brand Studio Free
        </a>
        <a href="/free-brand-studio" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-stone-700 bg-stone-900/60 px-6 py-3 font-semibold text-stone-200 transition hover:border-amber-500 hover:text-white">
          <span>✦</span> Explore 18 Indian SMB Templates
        </a>
      </div>
    </div>
  </div>
</section>
