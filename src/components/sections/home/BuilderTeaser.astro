---
/**
 * Homepage entry point for the Free AI Website Builder. Lives here rather
 * than in the desktop header because the header's 8 items already fill its
 * 1280px container (a 9th item overflowed the "Get a free quote" button at
 * every desktop width). Mobile menu + footer also link to the builder.
 */
---

<section id="builder" data-dock-title="Free AI Builder" data-dock-desc="Build your own website free" class="bg-cream py-14 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-8 rounded-3xl border border-ink-200 bg-white p-6 sm:p-10 lg:grid-cols-[1.2fr_0.8fr] lg:p-12">
      <div class="min-w-0">
        <p class="inline-flex items-center gap-2 rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-brand-700">
          <span class="h-2 w-2 rounded-full bg-emerald-600" aria-hidden="true"></span> New · Free AI Website Builder
        </p>
        <h2 class="mt-4 font-display text-2xl font-semibold leading-tight text-ink-950 sm:text-4xl">
          Want to build it yourself? Let AI draft your website in under a minute.
        </h2>
        <p class="mt-3 text-ink-700 sm:text-lg">
          Describe your business, edit everything visually, and download plain HTML files to host anywhere, including GoDaddy. No sign-up, no coding.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col lg:items-stretch">
        <a href="/free-website-builder/app?start=ai" class="inline-flex min-h-12 items-center justify-center rounded-full bg-brand-600 px-6 py-3 font-semibold text-cream transition hover:bg-brand-700" data-analytics-event="builder_cta_home">
          Create My Website Free
        </a>
        <a href="/free-website-builder" class="inline-flex min-h-12 items-center justify-center rounded-full border border-ink-300 px-6 py-3 font-semibold text-ink-900 transition hover:border-ink-700">
          See how it works
        </a>
      </div>
    </div>
  </div>
</section>
