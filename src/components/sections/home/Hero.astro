---
import { siteConfig } from "@config/site";
import { waLink } from "@/lib/contact-links";
import Icon from "@/components/ui/Icon.astro";
---

<section class="relative overflow-hidden border-b border-ink-200 bg-cream">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 md:items-center md:gap-12 md:py-24 lg:px-8">
    <div class="reveal min-w-0">
      <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-brand-50 px-3.5 py-1.5 text-sm font-medium text-brand-700">
        <Icon name="map-pin" class="h-4 w-4" /> Built in {siteConfig.address.city}, working across India
      </p>
      <h1 class="font-display text-4xl font-semibold leading-[1.08] text-ink-950 sm:text-5xl">
        A website that gets your business found — and turns visitors into WhatsApp enquiries.
      </h1>
      <p class="mt-5 max-w-xl text-lg text-ink-700">
        We build fast, mobile-first websites for Indian shops, clinics, restaurants, jewellers and builders — priced in plain rupees, with no login systems or paid plugins you don't need.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-brand-600 px-6 py-3.5 text-base font-semibold text-cream shadow-sm transition hover:bg-brand-700"
          data-analytics-event="cta_click"
        >
          Get a free quote <Icon name="chevron-right" class="h-4 w-4" />
        </a>
        <a
          href={waLink(siteConfig.whatsappMessageTemplates.heroSecondary)}
          target="_blank"
          rel="noopener"
          aria-label="Chat on WhatsApp (opens WhatsApp)"
          class="inline-flex items-center justify-center gap-2 rounded-md border border-ink-300 bg-white px-6 py-3.5 text-base font-semibold text-ink-800 transition hover:border-teal-500 hover:text-teal-700"
          data-analytics-event="whatsapp_click"
        >
          <Icon name="whatsapp" class="h-5 w-5 text-[#25D366]" /> Chat on WhatsApp
        </a>
      </div>
      <p class="mt-5 text-sm text-ink-500">{siteConfig.responseCommitment} No sales call required to get a price.</p>
    </div>

    <div class="reveal relative min-w-0">
      <div class="overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-xl">
        <div class="flex items-center gap-1.5 border-b border-ink-100 bg-ink-50 px-4 py-3">
          <span class="h-2.5 w-2.5 rounded-full bg-ink-300"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-ink-300"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-ink-300"></span>
          <span class="ml-3 min-w-0 truncate text-xs text-ink-500">kayalbackwaters.example — Kayal Backwaters Resort (demo)</span>
        </div>
        <img
          src="/images/demos/kayal-backwaters/hero-preview.jpg"
          alt="Preview of the Kayal Backwaters Resort demo homepage, showing a wooden houseboat on a Kerala backwater at sunset"
          width="960"
          height="640"
          fetchpriority="high"
          decoding="async"
          class="aspect-[3/2] w-full object-cover"
        />
      </div>
      <a
        href="/demos/kayal-backwaters"
        class="absolute -bottom-4 left-1/2 flex w-[92%] -translate-x-1/2 items-center justify-between gap-3 rounded-xl border border-ink-200 bg-white px-5 py-3.5 text-sm font-medium text-ink-800 shadow-lg transition hover:-translate-y-0.5 sm:w-[85%]"
      >
        See this demo, built for a resort
        <Icon name="chevron-right" class="h-4 w-4 shrink-0 text-brand-600" />
      </a>
    </div>
  </div>
</section>
