---
import { siteConfig } from "@config/site";
import { waLink } from "@/lib/contact-links";
import Icon from "@/components/ui/Icon.astro";
import DemoShowcase from "@/components/ui/DemoShowcase.astro";
import HeroEnquiryStack from "@/components/sections/home/HeroEnquiryStack.astro";
import HeroSpeedChip from "@/components/sections/home/HeroSpeedChip.astro";
---

<section
  id="hero"
  data-theme="light"
  data-dock-title="Overview"
  data-dock-desc="Built for Indian businesses"
  class="hero-cinematic border-b border-ink-200 bg-cream"
>
  <div class="hero-composition mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="hero-copy min-w-0">
      <!-- Eyebrow with Spring Dropping Pin -->
      <p class="hero-eyebrow inline-flex items-center gap-2 rounded-full bg-brand-50 px-3.5 py-1.5 text-xs sm:text-sm font-medium text-brand-700">
        <span class="hero-eyebrow-pin inline-flex items-center justify-center rounded-full">
          <Icon name="map-pin" class="h-4 w-4 shrink-0 text-brand-600" />
        </span>
        <span>Built in {siteConfig.address.city}, working across India</span>
      </p>

      <!-- H1 Headline with Kinetic Reveal Animation -->
      <h1 class="font-display font-semibold text-ink-950">
        A website that gets your business found — and turns visitors into <span class="hero-highlight">WhatsApp enquiries.</span>
      </h1>

      <!-- Subcopy Paragraph: Clear, readable value proposition -->
      <p class="hero-description text-ink-800">
        We build fast, mobile-first websites for Indian shops, clinics, restaurants, jewellers and builders — priced in plain rupees, with no login systems or paid plugins you don't need.
      </p>

      <!-- The "Enquiry Arrives" Hook Stack: live interactive proof -->
      <HeroEnquiryStack />

      <!-- Primary & Secondary CTAs -->
      <div class="hero-actions">
        <a
          href="/contact"
          class="cta-touch-btn quote-cta-btn inline-flex items-center justify-center gap-2 rounded-md bg-brand-600 px-4 py-3 font-semibold text-cream shadow-sm transition hover:bg-brand-700"
          data-analytics-event="cta_click"
        >
          <span class="quote-cta-sheen" aria-hidden="true"></span>
          <span>Get a free quote</span>
          <Icon name="chevron-right" class="h-4 w-4" />
        </a>
        <a
          href={waLink(siteConfig.whatsappMessageTemplates.heroSecondary)}
          target="_blank"
          rel="noopener"
          aria-label="Chat on WhatsApp (opens WhatsApp)"
          class="cta-touch-btn cta-whatsapp-btn inline-flex items-center justify-center gap-2 rounded-md border border-ink-300 bg-white px-4 py-3 font-semibold text-ink-800 transition hover:border-teal-500 hover:text-teal-700"
          data-analytics-event="whatsapp_click"
        >
          <Icon name="whatsapp" class="h-5 w-5 text-[#25D366] wa-icon-wiggle shrink-0" />
          <span>Chat on WhatsApp</span>
        </a>
      </div>

      <!-- Trust Bar & Real LCP Speed Chip -->
      <div class="hero-trust-bar flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 mt-3">
        <HeroSpeedChip />
        <p class="hero-response text-ink-600">
          {siteConfig.responseCommitment} No sales call required to get a price.
        </p>
      </div>

      <!-- Proof & AI Evaluator Links -->
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 mt-3">
        <a class="hero-proof-link" href="/demos">
          {siteConfig.demoRegistry.length} industries. {siteConfig.demoRegistry.length} working websites. <span aria-hidden="true">&nearr;</span>
        </a>
        <span class="text-ink-400 hidden sm:inline" aria-hidden="true">&middot;</span>
        <a
          href="#evaluator"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700 hover:text-brand-800 transition"
        >
          <Icon name="sparkle" class="h-3.5 w-3.5 text-amber-500" />
          <span>Test your site score (AI Evaluator) &darr;</span>
        </a>
      </div>
    </div>

    <!-- Right Column on Desktop / Bottom on Mobile -->
    <div class="hero-showcase min-w-0">
      <DemoShowcase id="home-showcase" compact />
    </div>
  </div>
</section>

<style>
  .hero-composition {
    display: grid;
    gap: 2.5rem;
    padding-top: 2rem;
    padding-bottom: 2rem;
    align-items: center;
  }
  h1 {
    margin-top: 1rem;
    font-size: clamp(2rem, 3.65vw, 3.6rem);
    line-height: 1.12;
    text-wrap: balance;
  }
  .hero-description {
    margin-top: 1rem;
    font-size: 1rem;
    line-height: 1.65;
    max-width: 36rem;
  }
  .hero-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.35rem;
    font-size: 0.875rem;
  }
  .hero-response {
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .hero-proof-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid var(--color-ink-300);
    padding-bottom: 0.25rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .hero-composition {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 3rem;
      padding-block: 2.5rem;
      align-items: start;
    }
    .hero-copy {
      padding-top: 2rem;
    }
  }
  @media (min-width: 1280px) {
    .hero-composition {
      gap: 4rem;
    }
  }
  @media (max-width: 899px) {
    .hero-copy {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      padding-bottom: 1rem;
    }
    .hero-showcase {
      max-width: 38rem;
      width: 100%;
      margin-inline: auto;
      margin-top: 1rem;
      padding-bottom: calc(var(--dock-h, 52px) + var(--dock-gap, 16px) + env(safe-area-inset-bottom, 1rem) + 1.5rem);
    }
  }
  @media (max-width: 639px) {
    .hero-composition {
      padding-top: 1.25rem;
      padding-bottom: 1rem;
      gap: 2rem;
    }
    .hero-eyebrow {
      font-size: 0.72rem;
      padding: 0.3rem 0.75rem;
    }
    h1 {
      margin-top: 0.75rem;
      font-size: clamp(1.8rem, 6.7vw, 2.25rem);
      line-height: 1.16;
      letter-spacing: -0.018em;
    }
    .hero-description {
      margin-top: 0.75rem;
      font-size: 0.92rem;
      line-height: 1.58;
    }
    .hero-actions {
      margin-top: 1.15rem;
      gap: 0.6rem;
      font-size: 0.82rem;
    }
    .hero-actions a {
      flex: 1;
      padding-inline: 0.65rem;
      padding-block: 0.85rem;
      white-space: nowrap;
    }
    .hero-actions svg {
      width: 15px;
      height: 15px;
    }
    .hero-response {
      font-size: 0.72rem;
    }
    .hero-proof-link {
      font-size: 0.78rem;
    }
  }
</style>

<script>
  // Non-blocking CTA touch feedback & ripple
  (function () {
    const ctaBtns = document.querySelectorAll<HTMLElement>(".cta-touch-btn");

    ctaBtns.forEach((btn) => {
      btn.addEventListener("pointerdown", (e: PointerEvent) => {
        const rect = btn.getBoundingClientRect();
        const x = `${e.clientX - rect.left}px`;
        const y = `${e.clientY - rect.top}px`;

        btn.style.setProperty("--ripple-x", x);
        btn.style.setProperty("--ripple-y", y);
        btn.classList.add("has-ripple", "is-pressed");

        // Subtle haptic where supported
        if ("vibrate" in navigator) {
          try {
            navigator.vibrate(10);
          } catch (_) {}
        }
      });

      const release = () => {
        btn.classList.remove("is-pressed");
        setTimeout(() => {
          btn.classList.remove("has-ripple");
        }, 300);
      };

      btn.addEventListener("pointerup", release);
      btn.addEventListener("pointercancel", release);
      btn.addEventListener("mouseleave", release);
    });
  })();
</script>
