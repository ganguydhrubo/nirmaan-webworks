---
import Icon from "@/components/ui/Icon.astro";

const problems = [
  {
    icon: "smartphone" as const,
    badge: "Speed Bleed · Android & 4G",
    title: "Your customers search on their phone, not Google Maps alone.",
    body: "If your site takes more than 3 seconds to load on a mid-range Android phone over typical mobile data, more than half your visitors bounce before they ever see your menu, your rooms, or your price list.",
    metricLabel: "Drop-off if load > 3s",
    metricValue: "53% Lost Visitors",
    comparison: {
      slow: "4.8s (Bloated WordPress / Builder)",
      fast: "0.6s (ATITTLE Lightweight Build)",
    },
  },
  {
    icon: "whatsapp" as const,
    badge: "Conversion Friction · Zero Inbound",
    title: "A phone number in a photo isn't a way to take enquiries.",
    body: "Customers in 2026 won't type a 10-digit phone number manually from a blurry visiting card pinned to an Instagram bio. They expect an instant 1-tap WhatsApp button with pre-filled details that starts the conversation immediately.",
    metricLabel: "Abandon manual dialling",
    metricValue: "70% Lost Leads",
    comparison: {
      slow: "Blurry JPG visiting card on Instagram",
      fast: "1-Tap WhatsApp CTA with pre-filled enquiry",
    },
  },
  {
    icon: "quote" as const,
    badge: "Trust Deficit · Lost Shortlists",
    title: "Your competitor with real photos is winning the comparison.",
    body: "When someone compares three local clinics, hotels, or stores at 10 PM, the business with authentic photos, visible rupee pricing, and clear credentials gets picked first — even if your real-world service is far superior.",
    metricLabel: "Pick the most transparent site",
    metricValue: "8 out of 10 Buyers",
    comparison: {
      slow: "Generic stock photos + 'Call for price'",
      fast: "Real space photos + transparent rupee pricing",
    },
  },
];
---

<section id="problem" data-theme="light" data-dock-title="The Cost" data-dock-desc="Why weak websites bleed enquiries" class="bg-cream py-16 sm:py-24 border-b border-ink-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-red-200 bg-red-50/80 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-red-700 shadow-sm">
        <span class="h-2 w-2 rounded-full bg-red-500 animate-pulse"></span>
        The Hidden Enquiries Leak
      </div>
      <h2 class="mt-4 font-display text-3xl font-bold text-ink-950 sm:text-4xl">
        What a weak website actually costs you
      </h2>
      <p class="mt-3 text-base sm:text-lg text-ink-700 leading-relaxed">
        Not a vague "poor impression" — specific, everyday enquiries that quietly go to someone else instead.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:gap-8 lg:grid-cols-3">
      {problems.map((p) => (
        <div class="reveal group relative flex flex-col rounded-2xl border border-ink-200 bg-white p-4 sm:p-7 shadow-sm transition duration-300 hover:border-brand-500 hover:shadow-lg min-w-0">
          <!-- Top Badge & Icon Header -->
          <div class="flex items-center justify-between gap-3">
            <span class="rounded-full bg-cream px-2.5 py-1 text-[11px] font-semibold text-ink-700 border border-ink-200">
              {p.badge}
            </span>
            <div class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600 transition group-hover:bg-brand-600 group-hover:text-white">
              <Icon name={p.icon} class="h-5 w-5" />
            </div>
          </div>

          <!-- Problem Title -->
          <h3 class="mt-5 font-display text-lg sm:text-xl font-bold text-ink-950 leading-snug break-words">
            {p.title}
          </h3>

          <!-- Explanation -->
          <p class="mt-2.5 text-xs sm:text-sm text-ink-600 leading-relaxed flex-grow break-words">
            {p.body}
          </p>

          <!-- Interactive Before / After Comparison Strip -->
          <div class="mt-6 rounded-xl border border-ink-100 bg-cream/70 p-3 text-xs min-w-0">
            <div class="flex flex-col min-[480px]:flex-row min-[480px]:items-center gap-1 min-[480px]:gap-2 text-red-700 font-medium min-w-0">
              <span class="shrink-0 font-bold text-[11px] min-[480px]:text-xs">❌ Common:</span>
              <span class="break-words min-w-0">{p.comparison.slow}</span>
            </div>
            <div class="mt-2 flex flex-col min-[480px]:flex-row min-[480px]:items-center gap-1 min-[480px]:gap-2 text-emerald-800 font-medium pt-2 border-t border-ink-200/60 min-w-0">
              <span class="shrink-0 font-bold text-[11px] min-[480px]:text-xs">✅ With us:</span>
              <span class="break-words min-w-0">{p.comparison.fast}</span>
            </div>
          </div>

          <!-- High-Impact Metric Callout -->
          <div class="mt-5 flex items-center justify-between rounded-xl bg-red-50/70 border border-red-100 p-2.5 sm:px-3.5 sm:py-2.5 gap-2 min-w-0">
            <span class="text-[11px] font-medium text-red-800 min-w-0 break-words">{p.metricLabel}</span>
            <span class="font-display text-xs font-bold text-red-700 shrink-0">{p.metricValue}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

