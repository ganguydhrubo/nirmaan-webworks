---
import { siteConfig } from "@config/site";
---

<section class="border-b border-ink-200 bg-white py-6">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <p class="mb-4 text-center text-xs font-semibold uppercase tracking-wider text-ink-500">Websites built for</p>
    <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
      {siteConfig.industryRegistry.map((industry) => (
        <li>
          <a href={`/industries/${industry.slug}`} class="text-sm font-medium text-ink-600 transition-colors hover:text-brand-600">
            {industry.shortName}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
