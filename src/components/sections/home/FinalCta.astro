---
import EnquiryForm from "@/components/sections/EnquiryForm.astro";
---

<section id="contact" class="bg-ink-950 py-16 sm:py-24">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8">
    <div class="reveal min-w-0">
      <h2 class="font-display text-3xl font-semibold text-cream sm:text-4xl">Tell us about your business</h2>
      <p class="mt-4 text-lg text-ink-300">
        No sales call needed to get a price. Fill this in and we'll reply with a scoped quote — usually within one business day.
      </p>
    </div>
    <div class="reveal min-w-0 rounded-2xl bg-white p-6 shadow-xl sm:p-8">
      <EnquiryForm />
    </div>
  </div>
</section>
