---
import { siteConfig } from "@config/site";
import Icon from "@/components/ui/Icon.astro";

function formatInr(n: number): string {
  return `₹${n.toLocaleString("en-IN")}`;
}
---

<section id="pricing" data-theme="dark" data-dock-title="Pricing" data-dock-desc="Starting rupee ranges" class="bg-ink-950 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-semibold text-cream sm:text-4xl" data-i18n="pricingTeaser.heading">Pricing, before you ever talk to us</h2>
      <p class="mt-4 text-lg text-ink-300" data-i18n="pricingTeaser.subheading">Starting ranges. Your exact quote depends on pages and features — confirmed in writing before work begins.</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {siteConfig.priceRanges.map((tier) => (
        <div class:list={["reveal flex flex-col rounded-2xl border p-6", tier.id === "business" ? "border-brand-500 bg-ink-900 ring-1 ring-brand-500" : tier.id === "micro-starter" ? "border-emerald-500/50 bg-ink-900" : "border-ink-800 bg-ink-900"]}>
          {tier.id === "micro-starter" && <span class="mb-3 inline-block w-fit rounded-full bg-emerald-800 border border-emerald-500/40 px-2.5 py-0.5 text-xs font-semibold text-emerald-200">Local Retail & Kirana</span>}
          {tier.id === "business" && <span class="mb-3 inline-block w-fit rounded-full bg-brand-600 px-2.5 py-0.5 text-xs font-semibold text-cream">Most chosen</span>}
          <h3 class="font-display text-lg font-semibold text-cream">{tier.name}</h3>
          <p class="mt-2 font-display text-2xl font-semibold text-cream">
            {formatInr(tier.priceMinInr)}<span class="text-base text-ink-400"> – {formatInr(tier.priceMaxInr)}</span>
          </p>
          <p class="mt-1 text-sm text-ink-400">{tier.indicativeTimelineWeeks[0]}–{tier.indicativeTimelineWeeks[1]} weeks · {tier.bestFor}</p>
          <ul class="mt-6 flex-1 space-y-2.5 text-sm text-ink-300">
            {tier.includes.map((item) => (
              <li class="flex items-start gap-2">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-400" /> {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="reveal mt-8 text-center text-sm text-ink-400">
      {siteConfig.gstNote} Optional maintenance: {formatInr(siteConfig.maintenanceMonthlyInr.min)}–{formatInr(siteConfig.maintenanceMonthlyInr.max)}/month — never required to keep your site live.
    </p>
    <div class="reveal mt-8 text-center">
      <a href="/pricing" class="text-sm font-semibold text-brand-400 hover:text-brand-300" data-i18n="pricingTeaser.viewFullPricing">See the full pricing breakdown →</a>
    </div>
  </div>
</section>
