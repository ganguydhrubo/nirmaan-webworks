---
import Icon from "@/components/ui/Icon.astro";
import { siteConfig } from "@config/site";
import { telLink, waLink } from "@/lib/contact-links";
---

<div
  data-mobile-sticky-bar
  class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-3 border-t border-ink-200 bg-white shadow-[0_-4px_16px_rgba(0,0,0,0.08)] transition-opacity duration-200 lg:hidden"
  style={`padding-bottom: env(safe-area-inset-bottom)`}
>
  <a href={telLink()} class="flex flex-col items-center justify-center gap-0.5 py-2.5 text-ink-700 active:bg-ink-100" data-analytics-event="call_click">
    <Icon name="phone" class="h-5 w-5" />
    <span class="text-xs font-medium">Call</span>
  </a>
  <a
    href={waLink(siteConfig.whatsappMessageTemplates.mobileStickyBar)}
    target="_blank"
    rel="noopener"
    aria-label="Chat with us on WhatsApp (opens WhatsApp)"
    class="flex flex-col items-center justify-center gap-0.5 border-x border-ink-200 bg-[#25D366] py-2.5 text-ink-950 active:opacity-90 font-semibold"
    data-analytics-event="whatsapp_click"
  >
    <Icon name="whatsapp" class="h-5 w-5 text-ink-950" />
    <span class="text-xs font-bold text-ink-950">WhatsApp</span>
  </a>
  <a href="/contact" class="flex flex-col items-center justify-center gap-0.5 bg-brand-600 py-2.5 text-cream active:bg-brand-700" data-analytics-event="cta_click">
    <Icon name="bolt" class="h-5 w-5" />
    <span class="text-xs font-medium">Enquire</span>
  </a>
</div>
