---
/**
 * Minimal wrapper for the demo sites. Deliberately thin — each demo
 * builds its own header/nav/footer/visual identity beneath this; the only
 * things every demo shares are: noindex (see SEO.md), the fonts.css this
 * demo asked for, and the honest "demo site" disclosure banner (Section 7 /
 * Section 11 — no demo may pretend to be a real, currently-operating
 * business without disclosure).
 */
import { siteConfig } from "@config/site";
import { waLink } from "@/lib/contact-links";
import Icon from "@/components/ui/Icon.astro";
import "@/styles/global.css";

interface Props {
  demoSlug: string;
  title: string;
  description: string;
  fontsHref: string;
  themeColor: string;
}

const { demoSlug, title, description, fontsHref, themeColor } = Astro.props;

const demo = siteConfig.demoRegistry.find((d) => d.slug === demoSlug);
if (!demo) {
  throw new Error(`Unknown demo slug "${demoSlug}" — add it to config/site.ts demoRegistry`);
}
const industry = siteConfig.industryRegistry.find((i) => i.slug === demo.industrySlug);

const canonicalUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={themeColor} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href={fontsHref} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      if (new URLSearchParams(window.location.search).has('theatre')) {
        document.documentElement.classList.add('in-theatre');
      }
    </script>
    <style>
      :global(html.in-theatre [data-demo-banner]) {
        display: none !important;
      }

      /* Executive Studio Sound Bar */
      .demo-banner {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(14, 14, 18, 0.95);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.4rem 0.75rem;
        color: #f5f5f7;
      }
      .demo-banner-inner {
        max-width: 1280px;
        margin-inline: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
      }
      .demo-banner-left,
      .demo-banner-center,
      .demo-banner-right {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .demo-home-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.3rem 0.65rem;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 150ms ease;
      }
      .demo-home-btn:hover {
        background: rgba(255, 255, 255, 0.16);
        border-color: rgba(255, 255, 255, 0.25);
      }
      .demo-industry-pill {
        font-size: 0.72rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.6);
      }

      /* Sound & Atmosphere Toggle (like Inventiko SoundToggle) */
      .demo-sound-toggle-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.85rem;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.16);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 200ms ease;
      }
      .demo-sound-toggle-btn:hover {
        background: rgba(255, 255, 255, 0.14);
        border-color: rgba(255, 255, 255, 0.3);
      }
      .demo-sound-toggle-btn.is-active {
        background: rgba(234, 88, 12, 0.2);
        border-color: rgba(234, 88, 12, 0.6);
        color: #fed7aa;
        box-shadow: 0 0 12px rgba(234, 88, 12, 0.25);
      }
      .sound-eq-bars {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        height: 12px;
      }
      .sound-eq-bars i {
        width: 2px;
        height: 6px;
        background: currentColor;
        border-radius: 1px;
        transition: transform 150ms ease;
      }
      .demo-sound-toggle-btn.is-active .sound-eq-bars i {
        animation: eqBounce 1.2s ease-in-out infinite;
      }
      .demo-sound-toggle-btn.is-active .sound-eq-bars i:nth-child(1) { height: 7px; animation-delay: 0s; }
      .demo-sound-toggle-btn.is-active .sound-eq-bars i:nth-child(2) { height: 12px; animation-delay: 0.2s; }
      .demo-sound-toggle-btn.is-active .sound-eq-bars i:nth-child(3) { height: 9px; animation-delay: 0.4s; }
      .demo-sound-toggle-btn.is-active .sound-eq-bars i:nth-child(4) { height: 11px; animation-delay: 0.15s; }

      @keyframes eqBounce {
        0%, 100% { transform: scaleY(0.4); }
        50% { transform: scaleY(1.2); }
      }

      .banner-cta-link {
        font-size: 0.74rem;
        color: rgba(255, 255, 255, 0.75);
        text-decoration: underline;
        text-underline-offset: 3px;
        transition: color 150ms ease;
      }
      .banner-cta-link:hover {
        color: #fed7aa;
      }
      .banner-wa-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.3rem 0.65rem;
        border-radius: 9999px;
        background: rgba(34, 197, 94, 0.18);
        border: 1px solid rgba(34, 197, 94, 0.4);
        color: #86efac;
        font-size: 0.74rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 150ms ease;
      }
      .banner-wa-btn:hover {
        background: #16a34a;
        color: #fff;
      }

      @media (max-width: 768px) {
        .demo-banner-inner {
          justify-content: space-between;
          gap: 0.4rem;
        }
        .demo-industry-pill,
        .banner-cta-link {
          display: none;
        }
        .demo-sound-toggle-btn {
          padding: 0.3rem 0.6rem;
          font-size: 0.72rem;
        }
        .banner-wa-btn {
          padding: 0.3rem 0.55rem;
          font-size: 0.72rem;
        }
      }
    </style>
  </head>
  <body>
    <a href="#demo-content" class="skip-link">Skip to demo content</a>
    
    <div data-demo-banner class="demo-banner">
      <div class="demo-banner-inner">
        <div class="demo-banner-left">
          <a
            href="/"
            class="demo-home-btn"
            aria-label={`Back to ${siteConfig.businessName} homepage`}
            data-analytics-event="cta_click"
          >
            <Icon name="chevron-left" class="h-3.5 w-3.5 shrink-0" />
            <span>{siteConfig.businessName}</span>
          </a>
          <span class="demo-industry-pill">Demo · {industry?.name}</span>
        </div>

        <div class="demo-banner-center">
          <button
            type="button"
            class="demo-sound-toggle-btn"
            id="demo-sound-toggle"
            aria-label="Toggle cinematic sound and atmosphere"
            title="Toggle atmospheric sound design"
          >
            <span class="sound-eq-bars" aria-hidden="true">
              <i></i><i></i><i></i><i></i>
            </span>
            <span id="demo-sound-status">Sound FX</span>
          </button>
        </div>

        <div class="demo-banner-right">
          <a
            href={`/contact?category=${encodeURIComponent(industry?.shortName ?? "")}&demo=${demo.slug}`}
            class="banner-cta-link"
            data-analytics-event="cta_click"
            data-demo-slug={demo.slug}
          >
            Want one for your business?
          </a>
          <a
            href={waLink(siteConfig.whatsappMessageTemplates.demoGeneric(demo.businessName))}
            target="_blank"
            rel="noopener"
            aria-label="Ask on WhatsApp about this demo (opens WhatsApp)"
            class="banner-wa-btn"
            data-analytics-event="whatsapp_click"
            data-demo-slug={demo.slug}
          >
            <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"/></svg>
            <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </div>

    <div id="demo-content" tabindex="-1"><slot /></div>

    <script src="../scripts/analytics-client.ts"></script>
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/kinetic-motion.ts"></script>
    <script is:inline>
      (function() {
        const btn = document.getElementById('demo-sound-toggle');
        const label = document.getElementById('demo-sound-status');
        if (!btn || !label) return;

        function update() {
          const active = window.atittleAudio ? window.atittleAudio.isSoundEnabled() : false;
          btn.classList.toggle('is-active', active);
          label.textContent = active ? 'Sound FX: ON' : 'Sound FX';
        }

        update();
        window.addEventListener('atittle:sound-toggled', update);

        btn.addEventListener('click', function() {
          if (window.atittleAudio) {
            window.atittleAudio.toggle();
            update();
          }
        });
      })();
    </script>
  </body>
</html>
