  <!-- Interactive Test Bench Script -->
  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const tabButtons = document.querySelectorAll(".bench-tab-btn");
      const atittleView = document.getElementById("bench-atittle-view");
      const traditionalView = document.getElementById("bench-traditional-view");

      tabButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = btn.getAttribute("data-target");

          // Toggle button active styling
          tabButtons.forEach((b) => {
            b.classList.remove("active", "bg-white", "text-ink-950", "border", "border-ink-200", "shadow-sm");
            b.classList.add("text-ink-600");
          });

          btn.classList.add("active", "bg-white", "text-ink-950", "border", "border-ink-200", "shadow-sm");
          btn.classList.remove("text-ink-600");

          // Toggle view visibility
          if (target === "atittle") {
            if (atittleView) {
              atittleView.classList.remove("hidden");
              atittleView.classList.add("block");
            }
            if (traditionalView) {
              traditionalView.classList.add("hidden");
              traditionalView.classList.remove("block");
            }
          } else {
            if (traditionalView) {
              traditionalView.classList.remove("hidden");
              traditionalView.classList.add("block");
            }
            if (atittleView) {
              atittleView.classList.add("hidden");
              atittleView.classList.remove("block");
            }
          }
        });
      });
    });
  </script>
