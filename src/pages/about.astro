---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import { siteConfig } from "@config/site";
import { telLink, waLink, mailLink } from "@/lib/contact-links";
import { breadcrumbJsonLd } from "@/lib/seo";

export const prerender = true;

const jsonLd = [
  breadcrumbJsonLd([
    { name: "Home", url: siteConfig.siteUrl },
    { name: "About", url: `${siteConfig.siteUrl}/about` },
  ]),
];

const benchmarks = [
  { metric: "0.6s", label: "Median Mobile FCP", note: "Tested on Indian 4G/LTE" },
  { metric: "99/100", label: "Lighthouse Score", note: "Mobile performance score" },
  { metric: "15+", label: "Working Demos", note: "Live production industry systems" },
  { metric: "100%", label: "Client Owned", note: "Code, DNS & domain handover" },
];

const craftPillars = [
  {
    icon: "smartphone",
    title: "The Real-Hardware Testing Lab",
    badge: "Hardware-Tested",
    description:
      "We do not simulate mobile screens in Chrome DevTools and call it a day. Every ATITTLE site is physically tested on budget and mid-range Android devices (Redmi, Realme, Samsung Galaxy M-series) and iPhones at 320px, 360px, 375px, and 412px viewports.",
    takeaway: "Your customers never see broken buttons, misaligned text, or sluggish scrolling.",
  },
  {
    icon: "bolt",
    title: "Aggregator Commission Rescue",
    badge: "0% Commission",
    description:
      "Indian businesses lose 18% to 30% of their top line to Swiggy, Zomato, Practo, Urban Company, and Justdial. We build direct 1-tap WhatsApp ordering, token booking, and lead channels that put 100% of your customer margins back into your pocket.",
    takeaway: "Turn search traffic into direct buyers who talk directly to you.",
  },
  {
    icon: "shield",
    title: "Zero Platform Hostage & Full Ownership",
    badge: "100% Client Owned",
    description:
      "No proprietary CMS lock-ins, no hostage hosting accounts, and no monthly maintenance retainers just to change your phone number. On launch day, we hand over full GitHub repository access, Cloudflare/Vercel credentials, and DNS records.",
    takeaway: "Any competent developer in the world can run or edit your site in 5 minutes.",
  },
  {
    icon: "rupee",
    title: "Public Rupee Scope & Zero Fine Print",
    badge: "Fixed Rupee Contract",
    description:
      "No mystery pricing, no hourly billing surprises, and no unexpected renewal invoices. Our packages start transparently from ₹4,999 for local shop storefronts up to ₹45,000+ for enterprise platforms, documented in writing before design begins.",
    takeaway: "What is written in your rupee contract is exactly what you pay. Nothing more.",
  },
];

const nonNegotiables = [
  {
    refusal: "No WordPress, Elementor, or Divi Sludge",
    guarantee: "Modern Astro static generation that loads in under 1 second and never slows down over time.",
  },
  {
    refusal: "No Fake 5-Star Reviews or AI Testimonials",
    guarantee: "Real business addresses, genuine verified photos, and authentic proof of work.",
  },
  {
    refusal: "No Mandatory Monthly Retainer Hostage",
    guarantee: "Zero recurring fees to keep your site online. We train you or your team for free.",
  },
  {
    refusal: "No False 'Guaranteed #1 on Google' Promises",
    guarantee: "Honest technical SEO: valid schema.org JSON-LD, sub-second TTFB, and Google Business Profile setup.",
  },
  {
    refusal: "No Junior Ghost Handoffs",
    guarantee: "The senior engineers you speak with on the scoping call are the people building your site.",
  },
  {
    refusal: "No Hidden Costs or Surprise Invoices",
    guarantee: "All scope items, revision rounds, and turnaround milestones agreed in writing before kickoff.",
  },
];
---

<BaseLayout
  title="About ATITTLE — Mobile-First Web Design Studio, Kolkata"
  description="ATITTLE is an independent web engineering studio based in Newtown, Kolkata. We build lightning-fast, mobile-first websites for Indian businesses, tested on real budget phones over Indian 4G networks."
  jsonLd={jsonLd}
>
  <!-- 1. Hero Section: Studio Mission & Hardware Ethos -->
  <section class="relative overflow-hidden bg-cream py-12 sm:py-16 md:py-20 border-b border-ink-200/70">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.03]"
      style="background-image: radial-gradient(#1f1b16 1px, transparent 1px); background-size: 24px 24px;"
    ></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Live Studio Badge -->
      <div class="inline-flex max-w-full items-center gap-2 rounded-full border border-brand-200 bg-brand-50/80 px-3.5 py-1.5 text-xs sm:text-sm font-semibold text-brand-700 shadow-sm backdrop-blur-sm">
        <span class="relative flex h-2 w-2 shrink-0">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-600"></span>
        </span>
        <span class="sm:hidden">Studio Live · Real-Device Testing Lab</span>
        <span class="hidden sm:inline">Studio Live · Newtown, Kolkata · Physical Real-Device Testing Lab</span>
      </div>

      <!-- Main Display Headline -->
      <h1 class="mt-6 font-display text-3xl font-semibold tracking-tight text-ink-950 sm:text-5xl lg:text-6xl max-w-4xl leading-[1.15] break-words">
        We Don’t Build for Boardrooms. <br />
        <span class="text-brand-600 italic">We Build for 6.5-Inch Screens on Indian 4G.</span>
      </h1>

      <!-- Mission Paragraph -->
      <p class="mt-6 text-base sm:text-lg lg:text-xl text-ink-700 max-w-3xl leading-relaxed break-words">
        {siteConfig.businessName} is an independent web engineering studio operating out of {siteConfig.address.line1}, {siteConfig.address.city}, {siteConfig.address.state}.
        We build lightning-fast, conversion-focused websites for Indian clinics, retail stores, jewellers, restaurants, hotels, and growing businesses — priced transparently in plain rupees and built to load in under one second.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center gap-3 sm:gap-4">
        <a
          href={waLink("Hi ATITTLE studio team, I want to discuss a fast website for my business.")}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-[#25D366] px-5 py-3 text-sm font-bold text-ink-950 shadow-sm transition hover:opacity-95 active:scale-95"
          data-analytics-event="whatsapp_click"
        >
          <Icon name="whatsapp" class="h-5 w-5 text-ink-950" />
          <span>WhatsApp Studio Directly</span>
        </a>

        <a
          href="/industries"
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-ink-300 bg-white px-5 py-3 text-sm font-semibold text-ink-900 shadow-sm transition hover:border-brand-500 hover:text-brand-600 active:scale-95"
        >
          <span>Explore 15 Live Demos</span>
          <Icon name="chevron-right" class="h-4 w-4" />
        </a>

        <a
          href={telLink()}
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-ink-200 bg-cream-50 px-4 py-3 text-sm font-medium text-ink-700 hover:text-ink-950 hover:border-ink-400"
          data-analytics-event="call_click"
        >
          <Icon name="phone" class="h-4 w-4 text-brand-600" />
          <span>{siteConfig.phoneDisplay}</span>
        </a>
      </div>

      <!-- Live Benchmarks Strip -->
      <div class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 sm:grid-cols-4 pt-8 border-t border-ink-200/80">
        {benchmarks.map((b) => (
          <div class="rounded-xl border border-ink-200/80 bg-white/90 p-4 shadow-sm backdrop-blur-sm">
            <div class="font-display text-2xl sm:text-3xl font-bold text-brand-600 tracking-tight">{b.metric}</div>
            <div class="mt-1 text-xs sm:text-sm font-bold text-ink-900">{b.label}</div>
            <div class="mt-0.5 text-[11px] sm:text-xs text-ink-500">{b.note}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. Interactive Feature: The Real-Device Test Bench -->
  <section class="bg-white py-14 sm:py-20 border-b border-ink-200" id="test-bench">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-700 border border-brand-200">
          Interactive Audit
        </div>
        <h2 class="mt-3 font-display text-2xl sm:text-4xl font-semibold text-ink-950">
          The Real-Device Reality Check
        </h2>
        <p class="mt-3 text-sm sm:text-base text-ink-600">
          Toggle between an average agency’s bloated website and ATITTLE’s lightweight engineering. See exactly why 60%+ of mobile visitors abandon slow sites before the first sentence renders.
        </p>
      </div>

      <!-- Mode Switcher Buttons -->
      <div class="mt-8 flex justify-center">
        <div class="inline-flex rounded-xl border border-ink-300 bg-ink-100 p-1 sm:p-1.5 shadow-inner max-w-full" id="bench-toggle-container">
          <button
            type="button"
            class="bench-tab-btn active flex items-center gap-1.5 sm:gap-2 rounded-lg px-2.5 py-2 sm:px-4 sm:py-2.5 text-xs sm:text-sm font-bold transition shadow-sm bg-white text-ink-950 border border-ink-200"
            data-target="atittle"
          >
            <span class="h-2 w-2 sm:h-2.5 sm:w-2.5 shrink-0 rounded-full bg-emerald-500"></span>
            <span class="sm:hidden">ATITTLE (0.58s)</span>
            <span class="hidden sm:inline">ATITTLE Engineered Build</span>
            <span class="hidden sm:inline rounded bg-emerald-100 px-1.5 py-0.5 text-[10px] font-bold text-emerald-800">0.58s</span>
          </button>
          <button
            type="button"
            class="bench-tab-btn flex items-center gap-1.5 sm:gap-2 rounded-lg px-2.5 py-2 sm:px-4 sm:py-2.5 text-xs sm:text-sm font-semibold transition text-ink-600 hover:text-ink-900"
            data-target="traditional"
          >
            <span class="h-2 w-2 sm:h-2.5 sm:w-2.5 shrink-0 rounded-full bg-red-500"></span>
            <span class="sm:hidden">Typical Agency (6.8s)</span>
            <span class="hidden sm:inline">Typical Agency Build</span>
            <span class="hidden sm:inline rounded bg-red-100 px-1.5 py-0.5 text-[10px] font-bold text-red-800">6.8s</span>
          </button>
        </div>
      </div>

      <!-- Test Bench Interactive Stage Card -->
      <div class="mt-8 rounded-2xl border border-ink-200 bg-cream p-5 sm:p-8 lg:p-10 shadow-md">
        <!-- Live State Display: ATITTLE (Default) -->
        <div id="bench-atittle-view" class="bench-view block">
          <div class="grid gap-8 lg:grid-cols-12 items-center">
            <!-- Simulated Mobile Device Mockup (Left 5 Cols) -->
            <div class="lg:col-span-5 flex justify-center">
              <div class="relative w-full max-w-[280px] sm:max-w-[310px] rounded-[36px] border-[6px] border-ink-900 bg-ink-950 p-2 shadow-2xl">
                <!-- Device Speaker & Camera Notch -->
                <div class="absolute top-3 left-1/2 -translate-x-1/2 h-4 w-24 rounded-full bg-ink-900 flex items-center justify-center gap-2">
                  <div class="h-2 w-2 rounded-full bg-ink-800"></div>
                  <div class="h-1.5 w-8 rounded-full bg-ink-800"></div>
                </div>

                <!-- Screen Viewport -->
                <div class="mt-6 rounded-[28px] bg-white p-4 text-ink-900 overflow-hidden border border-ink-200">
                  <!-- Simulated Browser Bar -->
                  <div class="flex items-center justify-between border-b border-ink-100 pb-2.5 mb-3 text-[11px] text-ink-500">
                    <span class="inline-flex items-center gap-1 font-mono text-emerald-600 font-bold">
                      <Icon name="shield" class="h-3 w-3" /> atittle.com
                    </span>
                    <span class="rounded bg-emerald-100 px-1.5 py-0.5 font-mono text-[10px] font-bold text-emerald-800">4G · 0.58s</span>
                  </div>

                  <!-- Simulated Fast Page Content -->
                  <div class="space-y-2.5">
                    <div class="h-3 w-20 rounded bg-brand-200"></div>
                    <div class="h-5 w-44 rounded bg-ink-900 font-bold"></div>
                    <div class="h-2.5 w-full rounded bg-ink-200"></div>
                    <div class="h-2.5 w-5/6 rounded bg-ink-200"></div>

                    <!-- Instant 1-Tap CTA Mockup -->
                    <div class="mt-4 rounded-xl bg-emerald-50 border border-emerald-200 p-3">
                      <div class="flex items-center gap-2">
                        <div class="h-6 w-6 rounded-full bg-[#25D366] flex items-center justify-center text-ink-950 font-bold text-xs">WA</div>
                        <div class="text-xs font-bold text-emerald-950">Book via WhatsApp in 1 Tap</div>
                      </div>
                      <div class="mt-1 text-[10px] text-emerald-800 font-medium">Pre-filled query · Zero Swiggy/Practo fee</div>
                    </div>

                    <!-- Speed Proof Pill -->
                    <div class="mt-3 flex items-center justify-between rounded-lg bg-cream px-2.5 py-2 border border-ink-200 text-[11px]">
                      <span class="font-semibold text-ink-700">Lighthouse Mobile:</span>
                      <span class="font-mono font-bold text-emerald-600">99 / 100</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Diagnostics Metrics Breakdown (Right 7 Cols) -->
            <div class="lg:col-span-7 space-y-5">
              <div class="inline-flex items-center gap-2 rounded-md bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-900">
                <Icon name="check" class="h-4 w-4 text-emerald-700" />
                Verified: Redmi Note 12 on Real Airtel/Jio 4G Network
              </div>

              <h3 class="font-display text-2xl sm:text-3xl font-semibold text-ink-950">
                The ATITTLE Engineered Standard
              </h3>
              <p class="text-sm sm:text-base text-ink-700">
                We build zero-bloat static sites with Astro, vanilla TypeScript, and modern CSS. Customers on crowded bus stops or slow 4G in Tier-2/3 cities get an instantaneous, buttery-smooth experience.
              </p>

              <!-- Progress Comparison Meter -->
              <div class="rounded-xl border border-ink-200 bg-white p-4 shadow-sm space-y-4">
                <div>
                  <div class="flex justify-between text-xs font-bold text-ink-800 mb-1">
                    <span>Page Load Speed to First Touch</span>
                    <span class="text-emerald-700 font-mono">0.58s (Instant)</span>
                  </div>
                  <div class="h-2.5 w-full rounded-full bg-ink-100 overflow-hidden">
                    <div class="h-full rounded-full bg-emerald-500 w-[14%] transition-all duration-500"></div>
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-3 border-t border-ink-100">
                  <div class="rounded-lg bg-cream-50 p-2.5 border border-ink-200/60">
                    <span class="text-[11px] text-ink-500 block font-medium">Page Payload</span>
                    <span class="font-display text-lg font-bold text-emerald-700">48 KB</span>
                    <span class="text-[10px] text-ink-600 block mt-0.5">Static Astro payload</span>
                  </div>
                  <div class="rounded-lg bg-cream-50 p-2.5 border border-ink-200/60">
                    <span class="text-[11px] text-ink-500 block font-medium">Visitor Drop-off</span>
                    <span class="font-display text-lg font-bold text-emerald-700">&lt; 4%</span>
                    <span class="text-[10px] text-ink-600 block mt-0.5">Visitors stay & engage</span>
                  </div>
                  <div class="rounded-lg bg-cream-50 p-2.5 border border-ink-200/60">
                    <span class="text-[11px] text-ink-500 block font-medium">Monthly Retainer</span>
                    <span class="font-display text-lg font-bold text-emerald-700">₹0 / month</span>
                    <span class="text-[10px] text-ink-600 block mt-0.5">Free global edge hosting</span>
                  </div>
                </div>
              </div>

              <!-- Key Advantage Bullet List -->
              <div class="grid gap-2 sm:grid-cols-2 text-xs sm:text-sm text-ink-800 font-medium">
                <div class="flex items-center gap-2">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 font-bold text-xs">✓</span>
                  <span>Tested down to 320px screen width</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 font-bold text-xs">✓</span>
                  <span>Zero Swiggy / Practo / OTA commissions</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 font-bold text-xs">✓</span>
                  <span>Pre-baked JSON-LD schema for Google Local</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 font-bold text-xs">✓</span>
                  <span>Full source code handover on GitHub</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Live State Display: TRADITIONAL AGENCY (Hidden by default, toggled via JS) -->
        <div id="bench-traditional-view" class="bench-view hidden">
          <div class="grid gap-8 lg:grid-cols-12 items-center">
            <!-- Simulated Laggy Mobile Device Mockup (Left 5 Cols) -->
            <div class="lg:col-span-5 flex justify-center">
              <div class="relative w-full max-w-[280px] sm:max-w-[310px] rounded-[36px] border-[6px] border-ink-900 bg-ink-950 p-2 shadow-2xl">
                <!-- Device Speaker & Camera Notch -->
                <div class="absolute top-3 left-1/2 -translate-x-1/2 h-4 w-24 rounded-full bg-ink-900 flex items-center justify-center gap-2">
                  <div class="h-2 w-2 rounded-full bg-ink-800"></div>
                  <div class="h-1.5 w-8 rounded-full bg-ink-800"></div>
                </div>

                <!-- Screen Viewport with Loading Spinners & Broken Layout -->
                <div class="mt-6 rounded-[28px] bg-ink-50 p-4 text-ink-900 overflow-hidden border border-ink-200">
                  <!-- Simulated Browser Bar -->
                  <div class="flex items-center justify-between border-b border-ink-200 pb-2.5 mb-3 text-[11px] text-ink-500">
                    <span class="inline-flex items-center gap-1 font-mono text-ink-600 truncate">
                      agency-client-site.in
                    </span>
                    <span class="rounded bg-red-100 px-1.5 py-0.5 font-mono text-[10px] font-bold text-red-700 animate-pulse">4G · 6.8s Loading...</span>
                  </div>

                  <!-- Simulated Frozen Page Content -->
                  <div class="space-y-3 opacity-60">
                    <div class="flex items-center justify-center py-6">
                      <div class="h-8 w-8 animate-spin rounded-full border-4 border-red-300 border-t-red-600"></div>
                    </div>
                    <div class="rounded bg-red-100/70 p-2.5 text-center text-[10px] font-semibold text-red-800 border border-red-200">
                      Waiting for fonts.googleapis.com & 18 tracking scripts...
                    </div>
                    <div class="h-3 w-3/4 rounded bg-ink-300"></div>
                    <div class="h-3 w-1/2 rounded bg-ink-200"></div>
                    <!-- Layout Shift Warning -->
                    <div class="rounded-lg bg-amber-50 p-2 text-[10px] text-amber-800 border border-amber-200">
                      ⚠️ Cumulative Layout Shift: Content jumped while user tried to tap call button
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Diagnostics Metrics Breakdown (Right 7 Cols) -->
            <div class="lg:col-span-7 space-y-5">
              <div class="inline-flex items-center gap-2 rounded-md bg-red-100 px-3 py-1 text-xs font-bold text-red-900">
                <Icon name="close" class="h-4 w-4 text-red-600" />
                Tested on: ₹2.5L MacBook in Agency Office, Fails on Real Android
              </div>

              <h3 class="font-display text-2xl sm:text-3xl font-semibold text-ink-950">
                The Typical Agency Trap
              </h3>
              <p class="text-sm sm:text-base text-ink-700">
                Built on heavy WordPress themes with 35+ unmanaged plugins, designed on ultra-fast office WiFi. When an actual customer opens it on an Indian 4G connection, they stare at a blank white screen for 6 to 8 seconds.
              </p>

              <!-- Progress Comparison Meter -->
              <div class="rounded-xl border border-red-200 bg-white p-4 shadow-sm space-y-4">
                <div>
                  <div class="flex justify-between text-xs font-bold text-ink-800 mb-1">
                    <span>Page Load Speed to First Touch</span>
                    <span class="text-red-600 font-mono">6.8s (Painfully Slow)</span>
                  </div>
                  <div class="h-2.5 w-full rounded-full bg-ink-100 overflow-hidden">
                    <div class="h-full rounded-full bg-red-500 w-[92%] transition-all duration-500"></div>
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-3 border-t border-ink-100">
                  <div class="rounded-lg bg-red-50/50 p-2.5 border border-red-200/60">
                    <span class="text-[11px] text-ink-500 block font-medium">Page Payload</span>
                    <span class="font-display text-lg font-bold text-red-600">14.8 MB</span>
                    <span class="text-[10px] text-ink-600 block mt-0.5">Heavy JS & plugin bloat</span>
                  </div>
                  <div class="rounded-lg bg-red-50/50 p-2.5 border border-red-200/60">
                    <span class="text-[11px] text-ink-500 block font-medium">Visitor Drop-off</span>
                    <span class="font-display text-lg font-bold text-red-600">64% Left</span>
                    <span class="text-[10px] text-ink-600 block mt-0.5">Lost leads to competitors</span>
                  </div>
                  <div class="rounded-lg bg-red-50/50 p-2.5 border border-red-200/60">
                    <span class="text-[11px] text-ink-500 block font-medium">Maintenance Retainer</span>
                    <span class="font-display text-lg font-bold text-red-600">₹8,000 / mo</span>
                    <span class="text-[10px] text-ink-600 block mt-0.5">Hostage agency fee</span>
                  </div>
                </div>
              </div>

              <!-- Key Penalty Bullet List -->
              <div class="grid gap-2 sm:grid-cols-2 text-xs sm:text-sm text-ink-800 font-medium">
                <div class="flex items-center gap-2">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 font-bold text-xs">✕</span>
                  <span>Text cuts off on 360px Android screens</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 font-bold text-xs">✕</span>
                  <span>Pays 25% bleed to Swiggy / Practo</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 font-bold text-xs">✕</span>
                  <span>Zero schema markup, invisible to AI search</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 font-bold text-xs">✕</span>
                  <span>Agency holds domain & hosting hostage</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. The Origin Story: Why ATITTLE Exists -->
  <section class="bg-cream py-14 sm:py-20 border-b border-ink-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-12 items-center">
        <!-- Story Copy (Left 7 Cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-brand-700 border border-brand-200">
            Our Studio Story
          </div>
          <h2 class="font-display text-2xl sm:text-4xl font-semibold text-ink-950 leading-tight">
            Indian Businesses Deserve Better Than Disappearing Freelancers & Bloated ₹80,000 Themes.
          </h2>

          <div class="space-y-4 text-sm sm:text-base text-ink-700 leading-relaxed">
