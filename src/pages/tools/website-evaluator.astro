---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import { waLink } from "@/lib/contact-links";

const meta = {
  title: "AI Website Brand Alignment Evaluator | webjobs.site",
  description:
    "Evaluate whether your website reflects your genuine trade craft or looks like generic corporate slop. 100-point AI audit with visual score gauges and copy rewrites.",
};

const industries = [
  { value: "Dental & Healthcare Clinic", label: "Dental / Healthcare Clinic" },
  { value: "Luxury Residential Real Estate", label: "Luxury Real Estate Developer" },
  { value: "UPSC & Competitive Exam Coaching", label: "Coaching & Education Institute" },
  { value: "Fine Dining Restaurant & Bar", label: "Fine Dining & Hospitality" },
  { value: "High-End Architectural Studio", label: "Architecture & Interior Studio" },
  { value: "Modular Kitchen & Interior Design", label: "Modular Interior Design" },
  { value: "B2B Professional Services", label: "B2B / CA / Legal / Consulting" },
  { value: "Local Trade & Service Business", label: "Other Local Trade Service" },
];
---

<BaseLayout title={meta.title} description={meta.description}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden border-b border-ink-200/70 bg-gradient-to-b from-cream to-cream-50 py-12 sm:py-16">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-brand-700">
        <span class="inline-block h-2 w-2 rounded-full bg-brand-600 animate-pulse"></span>
        AI Engine &middot; Conversion CRO Auditor
      </div>

      <h1 class="font-serif mt-4 text-3xl font-semibold tracking-tight text-ink-950 sm:text-5xl lg:text-6xl">
        Does your website reflect your <span class="text-brand-600 italic">actual craft</span>?
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-base text-ink-700 sm:text-lg">
        Most Indian business websites look like copy-pasted corporate templates that repel real buyers. Run our 100-point AI audit to test 3-second clarity, local trust anchors, WhatsApp friction, and pricing transparency.
      </p>

      <!-- Quick sample presets -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-2 text-xs">
        <span class="font-medium text-ink-500">Try a sample business:</span>
        <button
          type="button"
          data-preset="clinic"
          class="rounded-full border border-ink-300 bg-cream px-3 py-1 font-medium text-ink-700 hover:border-brand-500 hover:text-brand-600 transition"
        >
          Generic Dental Clinic
        </button>
        <button
          type="button"
          data-preset="coaching"
          class="rounded-full border border-ink-300 bg-cream px-3 py-1 font-medium text-ink-700 hover:border-brand-500 hover:text-brand-600 transition"
        >
          Generic Coaching Centre
        </button>
        <button
          type="button"
          data-preset="realestate"
          class="rounded-full border border-ink-300 bg-cream px-3 py-1 font-medium text-ink-700 hover:border-brand-500 hover:text-brand-600 transition"
        >
          Well-Optimised Real Estate (95+ Benchmark)
        </button>
      </div>
    </div>
  </section>

  <!-- Evaluation Form Section -->
  <section class="py-10 sm:py-14">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <form id="evaluator-form" class="rounded-2xl border border-ink-200 bg-cream p-6 shadow-sm sm:p-8">
        <div class="grid gap-6 sm:grid-cols-2">
          <!-- Business Name -->
          <div>
            <label for="businessName" class="block text-sm font-semibold text-ink-900">
              Business Name <span class="text-brand-600">*</span>
            </label>
            <input
              type="text"
              id="businessName"
              name="businessName"
              required
              placeholder="e.g. Apex Dental Studio"
              class="mt-1.5 w-full rounded-lg border border-ink-300 bg-cream-50 px-3.5 py-2.5 text-sm text-ink-900 placeholder:text-ink-400 focus:border-brand-600 focus:bg-cream focus:outline-none focus:ring-2 focus:ring-brand-600/20"
            />
          </div>

          <!-- Category -->
          <div>
            <label for="category" class="block text-sm font-semibold text-ink-900">
              Industry / Trade <span class="text-brand-600">*</span>
            </label>
            <select
              id="category"
              name="category"
              required
              class="mt-1.5 w-full rounded-lg border border-ink-300 bg-cream-50 px-3.5 py-2.5 text-sm text-ink-900 focus:border-brand-600 focus:bg-cream focus:outline-none focus:ring-2 focus:ring-brand-600/20"
            >
              {industries.map((ind) => (
                <option value={ind.value}>{ind.label}</option>
              ))}
            </select>
          </div>

          <!-- City / Location -->
          <div>
            <label for="city" class="block text-sm font-semibold text-ink-900">
              City / Primary Location
            </label>
            <input
              type="text"
              id="city"
              name="city"
              placeholder="e.g. Kolkata, South Kolkata, Salt Lake"
              class="mt-1.5 w-full rounded-lg border border-ink-300 bg-cream-50 px-3.5 py-2.5 text-sm text-ink-900 placeholder:text-ink-400 focus:border-brand-600 focus:bg-cream focus:outline-none focus:ring-2 focus:ring-brand-600/20"
            />
          </div>

          <!-- Website URL -->
          <div>
            <label for="websiteUrl" class="block text-sm font-semibold text-ink-900">
              Current Website URL <span class="text-xs font-normal text-ink-500">(optional)</span>
            </label>
            <input
              type="url"
              id="websiteUrl"
              name="websiteUrl"
              placeholder="https://example.com"
              class="mt-1.5 w-full rounded-lg border border-ink-300 bg-cream-50 px-3.5 py-2.5 text-sm text-ink-900 placeholder:text-ink-400 focus:border-brand-600 focus:bg-cream focus:outline-none focus:ring-2 focus:ring-brand-600/20"
            />
          </div>
        </div>

        <!-- Copy / Hero Text Input -->
        <div class="mt-6">
          <div class="flex items-center justify-between">
            <label for="copyText" class="block text-sm font-semibold text-ink-900">
              Website Copy / Hero Headline & Pitch <span class="text-brand-600">*</span>
            </label>
            <span class="text-xs text-ink-500">Paste your homepage headline, subhead, services & CTA</span>
          </div>
          <textarea
            id="copyText"
            name="copyText"
            rows="5"
            required
            placeholder="e.g. Welcome to Apex Dental. We provide comprehensive dental care for all families. Call us today for appointments. Dedicated team of experienced doctors..."
            class="mt-1.5 w-full rounded-lg border border-ink-300 bg-cream-50 p-3.5 text-sm text-ink-900 placeholder:text-ink-400 focus:border-brand-600 focus:bg-cream focus:outline-none focus:ring-2 focus:ring-brand-600/20 font-mono"
          ></textarea>
        </div>

        <!-- Error box -->
        <div id="form-error" class="mt-4 hidden rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700"></div>

        <!-- Submit Button -->
        <div class="mt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <p class="text-xs text-ink-500">
            AI-powered &middot; Instant 5-pillar CRO scoring
          </p>

          <button
            type="submit"
            id="submit-btn"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-cream shadow-sm hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-600/30 transition disabled:opacity-50 cursor-pointer"
          >
            <span id="btn-icon">
              <Icon name="bolt" class="h-4 w-4" />
            </span>
            <span id="btn-text">Audit Website (100-Point Score)</span>
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- Results Section (Dynamic) -->
  <section id="results-container" class="hidden py-10 sm:py-16 bg-cream-100/50 border-t border-ink-200/80">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      
      <!-- Top Score Header Card -->
      <div id="score-hero-card" class="relative overflow-hidden rounded-3xl border border-ink-200 bg-cream p-6 sm:p-10 shadow-lg">
        
        <!-- Background glowing ambient circle -->
        <div id="glow-ambient" class="pointer-events-none absolute -right-20 -top-20 h-72 w-72 rounded-full blur-3xl opacity-20"></div>

        <div class="grid items-center gap-8 lg:grid-cols-12">
          
          <!-- Radial SVG Score Gauge (Wowowowo graphics) -->
          <div class="flex flex-col items-center justify-center text-center lg:col-span-5">
            <div class="relative flex items-center justify-center">
              <svg class="h-48 w-48 -rotate-90 transform" viewBox="0 0 160 160">
                <!-- Background track -->
                <circle
                  cx="80"
                  cy="80"
                  r="66"
                  stroke="currentColor"
                  stroke-width="12"
                  fill="transparent"
                  class="text-ink-100"
                />
                <!-- Animated score progress ring -->
                <circle
                  id="score-circle"
                  cx="80"
                  cy="80"
                  r="66"
                  stroke="currentColor"
                  stroke-width="12"
                  stroke-linecap="round"
                  fill="transparent"
                  stroke-dasharray="414.69"
                  stroke-dashoffset="414.69"
                  class="text-brand-600 transition-all duration-1000 ease-out"
                />
              </svg>

              <!-- Centered Score Number -->
              <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                <span id="score-display" class="font-serif text-5xl font-bold tracking-tight text-ink-950">0</span>
                <span class="text-xs uppercase font-medium tracking-widest text-ink-500">out of 100</span>
              </div>
            </div>

            <!-- Tier Badge -->
            <div class="mt-4 flex flex-col items-center gap-1.5">
              <span id="tier-badge" class="inline-flex items-center rounded-full px-4 py-1 text-xs font-bold uppercase tracking-wider">
                Analyzing...
              </span>
              <span id="engine-badge" class="text-[11px] text-ink-400 font-mono">
                Evaluated via AI
              </span>
            </div>
          </div>

          <!-- Executive Summary & Quick Stats -->
          <div class="lg:col-span-7">
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-brand-700">
              <Icon name="sparkle" class="h-3.5 w-3.5" />
              Executive CRO Diagnosis
            </div>
            
            <h2 id="result-business-name" class="font-serif mt-1 text-2xl font-semibold text-ink-950 sm:text-3xl">
              Brand Alignment Report
            </h2>
            
            <p id="result-summary" class="mt-3 text-sm sm:text-base leading-relaxed text-ink-700">
              Loading assessment...
            </p>

            <!-- Diagnostic Pills: Red Flags & Strengths counters -->
            <div class="mt-6 flex flex-wrap gap-3 text-xs">
              <div class="flex items-center gap-1.5 rounded-lg border border-red-200 bg-red-50/80 px-3 py-1.5 font-medium text-red-800">
                <span class="h-2 w-2 rounded-full bg-red-500"></span>
                <span id="flags-count">0</span> Red Flags Identified
              </div>
              <div class="flex items-center gap-1.5 rounded-lg border border-emerald-200 bg-emerald-50/80 px-3 py-1.5 font-medium text-emerald-800">
                <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                <span id="strengths-count">0</span> Craft Strengths
              </div>
              <div class="flex items-center gap-1.5 rounded-lg border border-amber-200 bg-amber-50/80 px-3 py-1.5 font-medium text-amber-800">
                <span class="h-2 w-2 rounded-full bg-amber-500"></span>
                <span id="trust-missing-count">0</span> Missing Trust Anchors
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- 5 Pillar Breakdown (Graphics Meters) -->
      <div class="mt-10">
        <h3 class="font-serif text-xl font-semibold text-ink-950">5-Pillar Conversion Breakdown</h3>
        <p class="mt-1 text-xs text-ink-600">Each pillar is scored out of 20 points based on our MSME CRO evaluation framework.</p>

        <div id="pillars-container" class="mt-6 grid gap-4 sm:grid-cols-1">
          <!-- Dynamically populated via JS -->
        </div>
      </div>

      <!-- Red Flags & Key Strengths Grid -->
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        <!-- Red Flags -->
        <div class="rounded-2xl border border-red-200/80 bg-red-50/40 p-6">
          <div class="flex items-center gap-2 text-sm font-bold text-red-900">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-red-100 text-red-700">!</span>
            Critical Conversion Red Flags
          </div>
          <p class="mt-1 text-xs text-red-700/80">These elements cause prospective clients to bounce or distrust your business.</p>
          <ul id="red-flags-list" class="mt-4 space-y-2.5 text-xs text-red-900">
            <!-- Populated via JS -->
          </ul>
        </div>

        <!-- Key Strengths -->
        <div class="rounded-2xl border border-emerald-200/80 bg-emerald-50/40 p-6">
          <div class="flex items-center gap-2 text-sm font-bold text-emerald-900">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">&check;</span>
            Authentic Craft Strengths
          </div>
          <p class="mt-1 text-xs text-emerald-700/80">Elements that successfully communicate high value and real capability.</p>
          <ul id="strengths-list" class="mt-4 space-y-2.5 text-xs text-emerald-900">
            <!-- Populated via JS -->
          </ul>
        </div>
      </div>

      <!-- Missing Trust Signals -->
      <div class="mt-6 rounded-2xl border border-amber-200/80 bg-amber-50/40 p-6">
        <div class="flex items-center gap-2 text-sm font-bold text-amber-900">
          <Icon name="shield" class="h-5 w-5 text-amber-600" />
          Missing Local Trust Anchors Checklist
        </div>
        <p class="mt-1 text-xs text-amber-800/80">High-converting Indian local business sites require these frictionless confidence builders:</p>
        <div id="missing-trust-grid" class="mt-4 flex flex-wrap gap-2">
          <!-- Populated via JS -->
        </div>
      </div>

      <!-- Ultra-Detailed Copy Rewrites Box -->
      <div class="mt-10 rounded-3xl border border-ink-200 bg-cream p-6 sm:p-8 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-ink-200 pb-4">
          <div>
            <h3 class="font-serif text-xl font-semibold text-ink-950">Ultra-Detailed Copy Rewrites</h3>
            <p class="text-xs text-ink-600">AI-engineered copy alternatives designed for immediate conversion uplift.</p>
          </div>
          <span class="inline-flex items-center rounded-full bg-brand-50 border border-brand-200 px-3 py-1 text-xs font-semibold text-brand-700">
            Before vs After
          </span>
        </div>

        <!-- Headline Rewrite Card -->
        <div class="mt-6 rounded-xl border border-ink-200 bg-cream-50/50 p-5">
          <h4 class="text-xs font-bold uppercase tracking-wider text-ink-500">Hero Headline Rewrite</h4>
          
          <div class="mt-3 grid gap-4 sm:grid-cols-2">
            <div class="rounded-lg border border-red-200 bg-red-50/60 p-3.5">
              <span class="text-[11px] font-bold uppercase text-red-700">Before (Generic)</span>
              <p id="headline-current" class="mt-1 text-xs text-red-900 font-medium italic line-through">
                "Welcome to our professional services."
              </p>
            </div>

            <div class="rounded-lg border border-emerald-200 bg-emerald-50/60 p-3.5">
              <span class="text-[11px] font-bold uppercase text-emerald-700">After (High-Conversion)</span>
              <p id="headline-proposed" class="mt-1 text-xs text-emerald-950 font-bold">
                "Specialized Root Canal & Smile Restorations in South Kolkata &middot; Painless Care Since 2012."
              </p>
            </div>
          </div>

          <div class="mt-3 text-xs text-ink-700">
            <span class="font-semibold text-ink-900">Why this works: </span>
            <span id="headline-rationale">Concrete trade naming anchors immediate trust within 3 seconds.</span>
          </div>
        </div>

        <!-- CTA Rewrite Card -->
        <div class="mt-4 rounded-xl border border-ink-200 bg-cream-50/50 p-5">
          <h4 class="text-xs font-bold uppercase tracking-wider text-ink-500">Primary Call-to-Action Rewrite</h4>
          
          <div class="mt-3 grid gap-4 sm:grid-cols-2">
            <div class="rounded-lg border border-red-200 bg-red-50/60 p-3.5">
              <span class="text-[11px] font-bold uppercase text-red-700">Before (High-Friction)</span>
              <p id="cta-current" class="mt-1 text-xs text-red-900 font-medium italic line-through">
                "Submit Inquiry"
              </p>
            </div>

            <div class="rounded-lg border border-emerald-200 bg-emerald-50/60 p-3.5">
              <span class="text-[11px] font-bold uppercase text-emerald-700">After (Low-Friction WhatsApp Action)</span>
              <p id="cta-proposed" class="mt-1 text-xs text-emerald-950 font-bold">
                "Chat on WhatsApp &middot; Average 15-Min Response"
              </p>
            </div>
          </div>

          <div class="mt-3 text-xs text-ink-700">
            <span class="font-semibold text-ink-900">Why this works: </span>
            <span id="cta-rationale">Eliminates form anxiety and connects to direct chat immediately.</span>
          </div>
        </div>

        <!-- Complete Audit Copy Box with 1-Click Clipboard -->
        <div class="mt-8 border-t border-ink-200 pt-6">
          <div class="flex items-center justify-between">
            <div>
              <h4 class="text-sm font-bold text-ink-900">Complete Markdown Audit Report</h4>
              <p class="text-xs text-ink-500">Full structured breakdown ready to paste into Notion, Slack, or email.</p>
            </div>
            <button
              type="button"
              id="copy-report-btn"
              class="inline-flex items-center gap-1.5 rounded-lg border border-ink-300 bg-cream px-3.5 py-1.5 text-xs font-semibold text-ink-800 hover:border-brand-500 hover:text-brand-600 transition shadow-sm cursor-pointer"
            >
              <svg id="copy-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="copy-text">Copy Full Report</span>
            </button>
          </div>

          <div class="relative mt-3">
            <pre
              id="full-report-pre"
              class="max-h-72 overflow-y-auto rounded-xl border border-ink-300 bg-ink-950 p-4 text-xs font-mono text-ink-200 leading-relaxed"
            ></pre>
          </div>
        </div>

      </div>

      <!-- Lead Engine End-to-End Integration Banner -->
      <div class="mt-10 rounded-3xl bg-gradient-to-br from-brand-600 to-brand-800 p-8 text-cream shadow-xl">
        <div class="grid items-center gap-6 lg:grid-cols-12">
          <div class="lg:col-span-8">
            <span class="inline-block rounded-full bg-cream/20 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-cream">
              End-to-End Handover & Redesign
            </span>
            <h3 class="font-serif mt-2 text-2xl font-bold text-cream sm:text-3xl">
              Want webjobs.site to engineer a site that scores 95+?
            </h3>
            <p class="mt-2 text-sm text-cream/90">
              We replace generic templates with bespoke, high-performance Astro codebases featuring real photography, transparent pricing, verified trust anchors, and sub-second load times.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row lg:flex-col gap-3 lg:col-span-4 lg:items-end">
            <a
              id="book-quote-cta"
              href="/contact?demo=evaluator#enquiry"
              class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-cream px-5 py-3 text-sm font-bold text-brand-700 shadow-md hover:bg-cream-50 transition"
              data-analytics-event="cta_click"
            >
              Request Custom Build Quote
              <Icon name="chevron-right" class="h-4 w-4" />
            </a>

            <a
              id="whatsapp-audit-cta"
              href={waLink("Hi webjobs.site team, I ran the Website Brand Alignment Evaluator and want to discuss redesigning our website.")}
              target="_blank"
              rel="noopener"
              class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-cream/30 bg-cream/10 px-5 py-3 text-sm font-semibold text-cream hover:bg-cream/20 transition"
              data-analytics-event="whatsapp_click"
            >
              <Icon name="whatsapp" class="h-4 w-4" />
              Discuss on WhatsApp
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<script>
  // Never let the mobile sticky action bar cover this form's own submit
  // button — the shared EnquiryForm component has this built in via
  // scripts/enquiry-form.ts, but that script isn't loaded on this page
  // since the evaluator uses its own form, not <EnquiryForm />.
  (() => {
    const stickyBar = document.querySelector<HTMLElement>("[data-mobile-sticky-bar]");
    const form = document.getElementById("evaluator-form");
    if (stickyBar && form && "IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          const visible = entries.some((e) => e.isIntersecting);
          stickyBar.classList.toggle("opacity-0", visible);
          stickyBar.classList.toggle("pointer-events-none", visible);
        },
        { threshold: 0.15 },
      );
      io.observe(form);
    }
  })();

  // Presets Data
  const PRESETS = {
    clinic: {
      businessName: "Dr. Roy Multi-Specialty Dental Care",
      category: "Dental & Healthcare Clinic",
      city: "Kolkata",
      websiteUrl: "https://roymultispecialty.com",
      copyText: `Welcome to Dr. Roy Dental Clinic.
We are the leading multi-specialty dental clinic delivering world-class dental care for the whole family. Our cutting-edge technology and experienced doctors ensure the highest quality treatment.
Services: General Dentistry, Cosmetic Smiles, Implants, Braces.
Why choose us? 100% satisfaction guaranteed, state-of-the-art facility, caring doctors.
Click here to submit an inquiry form or call our central line.`,
    },
    coaching: {
      businessName: "Lakshya IAS & WBCS Academy",
      category: "UPSC & Competitive Exam Coaching",
      city: "Salt Lake, Kolkata",
      websiteUrl: "https://lakshyacoaching.in",
      copyText: `Unlock Your Dreams with India's Premier Civil Service Coaching.
We provide end-to-end guidance for UPSC CSE and WBCS aspirants. Join our elite classroom batch and learn from top mentors.
Features: Comprehensive study material, mock test series, air-conditioned smart classrooms.
Fill out the registration form below to request a call back from our counselor.`,
    },
    realestate: {
      businessName: "The Manor &middot; South Kolkata Residences",
      category: "Luxury Residential Real Estate",
      city: "Ballygunge, Kolkata",
      websiteUrl: "https://themanorresidences.in",
      copyText: `The Manor &middot; Handcrafted 3 & 4 BHK Luxury Residences in Prime Ballygunge.
Only 18 bespoke private apartments featuring 11-foot finished ceilings, wrap-around balconies, VRV air conditioning, and private elevator access.
WB RERA Registration Number: WBRERA/P/KOL/2024/000842.
Pricing & Inventory:
- 3 BHK (2,450 sq ft): ₹3.85 Cr onwards
- 4 BHK (3,200 sq ft): ₹5.10 Cr onwards
Direct Developer Desk on WhatsApp: Immediate PDF floorplan & physical private viewing slot within 2 hours.`,
    },
  };

  // DOM Elements
  const form = document.getElementById("evaluator-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const btnText = document.getElementById("btn-text") as HTMLElement;
  const formError = document.getElementById("form-error") as HTMLElement;

  const resultsContainer = document.getElementById("results-container") as HTMLElement;
  const scoreDisplay = document.getElementById("score-display") as HTMLElement;
  const scoreCircle = document.getElementById("score-circle") as SVGCircleElement | null;
  const tierBadge = document.getElementById("tier-badge") as HTMLElement;
  const engineBadge = document.getElementById("engine-badge") as HTMLElement;
  const glowAmbient = document.getElementById("glow-ambient") as HTMLElement;

  const resultBusinessName = document.getElementById("result-business-name") as HTMLElement;
  const resultSummary = document.getElementById("result-summary") as HTMLElement;
  const flagsCount = document.getElementById("flags-count") as HTMLElement;
  const strengthsCount = document.getElementById("strengths-count") as HTMLElement;
  const trustMissingCount = document.getElementById("trust-missing-count") as HTMLElement;

  const pillarsContainer = document.getElementById("pillars-container") as HTMLElement;
  const redFlagsList = document.getElementById("red-flags-list") as HTMLElement;
  const strengthsList = document.getElementById("strengths-list") as HTMLElement;
  const missingTrustGrid = document.getElementById("missing-trust-grid") as HTMLElement;

  const headlineCurrent = document.getElementById("headline-current") as HTMLElement;
  const headlineProposed = document.getElementById("headline-proposed") as HTMLElement;
  const headlineRationale = document.getElementById("headline-rationale") as HTMLElement;

  const ctaCurrent = document.getElementById("cta-current") as HTMLElement;
  const ctaProposed = document.getElementById("cta-proposed") as HTMLElement;
  const ctaRationale = document.getElementById("cta-rationale") as HTMLElement;

  const fullReportPre = document.getElementById("full-report-pre") as HTMLElement;
  const copyReportBtn = document.getElementById("copy-report-btn") as HTMLButtonElement;
  const copyText = document.getElementById("copy-text") as HTMLElement;

  const bookQuoteCta = document.getElementById("book-quote-cta") as HTMLAnchorElement;
  const whatsappAuditCta = document.getElementById("whatsapp-audit-cta") as HTMLAnchorElement;

  let currentFullReport = "";

  // Presets click handlers
  document.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const presetKey = btn.getAttribute("data-preset") as keyof typeof PRESETS;
      const data = PRESETS[presetKey];
      if (!data) return;

      const nameInput = document.getElementById("businessName") as HTMLInputElement | null;
      if (nameInput) nameInput.value = data.businessName;
      const catSelect = document.getElementById("category") as HTMLSelectElement | null;
      if (catSelect) catSelect.value = data.category;
      const cityInput = document.getElementById("city") as HTMLInputElement | null;
      if (cityInput) cityInput.value = data.city;
      const urlInput = document.getElementById("websiteUrl") as HTMLInputElement | null;
      if (urlInput) urlInput.value = data.websiteUrl;
      const copyInput = document.getElementById("copyText") as HTMLTextAreaElement | null;
      if (copyInput) copyInput.value = data.copyText;

      form.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  // Clipboard copy handler
  copyReportBtn?.addEventListener("click", async () => {
    if (!currentFullReport) return;
    try {
      await navigator.clipboard.writeText(currentFullReport);
      copyText.textContent = "Copied to Clipboard!";
      setTimeout(() => {
        copyText.textContent = "Copy Full Report";
      }, 2500);
    } catch {
      copyText.textContent = "Failed to copy";
    }
  });

  // Animate circular radial gauge
  function setGaugeScore(score: number, tierColor: string) {
    if (!scoreCircle) return;
    const circumference = 2 * Math.PI * 66; // r=66 -> ~414.69
    const offset = circumference - (score / 100) * circumference;
    
    // Animate stroke
    scoreCircle.style.strokeDashoffset = `${offset}`;
    scoreCircle.style.stroke = tierColor;

    // Number count-up animation
    let current = 0;
    const step = Math.max(1, Math.floor(score / 40));
    const timer = setInterval(() => {
      current += step;
      if (current >= score) {
        current = score;
        clearInterval(timer);
      }
      scoreDisplay.textContent = current.toString();
    }, 20);
  }

  // Submit form handler
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    formError.classList.add("hidden");
    formError.textContent = "";

    const formData = new FormData(form);
    const payload = {
      businessName: formData.get("businessName")?.toString().trim(),
      category: formData.get("category")?.toString().trim(),
      city: formData.get("city")?.toString().trim(),
      websiteUrl: formData.get("websiteUrl")?.toString().trim(),
      copyText: formData.get("copyText")?.toString().trim(),
    };

    submitBtn.disabled = true;
    btnText.textContent = "Analyzing with AI CRO Engine...";

    try {
      const response = await fetch("/api/evaluate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const json = (await response.json()) as any;

      if (!response.ok || !json.ok) {
        throw new Error(json.error || "Evaluation failed. Please try again.");
      }

      const res = json.data;
      currentFullReport = res.detailedCopyReport;

      // Unhide results
      resultsContainer.classList.remove("hidden");
      resultsContainer.scrollIntoView({ behavior: "smooth", block: "start" });

      // Visuals
      const tierHex =
        res.totalScore >= 90
          ? "#059669"
          : res.totalScore >= 75
          ? "#0d9488"
          : res.totalScore >= 50
          ? "#d97706"
          : "#e11d48";

      setGaugeScore(res.totalScore, tierHex);

      // Glow color
      if (glowAmbient) {
        glowAmbient.style.backgroundColor = tierHex;
      }

      // Tier badge
      tierBadge.textContent = res.tier;
      tierBadge.style.backgroundColor = `${tierHex}15`;
      tierBadge.style.color = tierHex;
      tierBadge.style.borderColor = `${tierHex}40`;

      // Engine badge
      engineBadge.textContent =
        res.evaluatedVia === "groq-gpt-oss-120b"
          ? "Evaluated via AI Engine"
          : "Evaluated via Heuristic CRO Engine";

      // Business & summary
      resultBusinessName.textContent = `${res.businessName} &middot; Brand Alignment Score`;
      resultSummary.textContent = res.summary;

      flagsCount.textContent = (res.redFlags?.length || 0).toString();
      strengthsCount.textContent = (res.keyStrengths?.length || 0).toString();
      trustMissingCount.textContent = (res.missingTrustSignals?.length || 0).toString();

      // Render 5 Pillars
      const pillarKeys = [
        res.pillars.valueProposition,
        res.pillars.industryAlignment,
        res.pillars.trustSignals,
        res.pillars.pricingTransparency,
        res.pillars.mobileActionability,
      ];

      pillarsContainer.innerHTML = pillarKeys
        .map((p: any) => {
          const pct = Math.round((p.score / p.maxScore) * 100);
          const color = pct >= 80 ? "bg-emerald-600" : pct >= 65 ? "bg-teal-600" : pct >= 50 ? "bg-amber-500" : "bg-red-500";
          return `
            <div class="rounded-xl border border-ink-200 bg-cream p-4 shadow-sm">
              <div class="flex items-center justify-between">
                <span class="text-sm font-bold text-ink-900">${p.name}</span>
                <span class="text-xs font-bold text-ink-700">${p.score} / ${p.maxScore} pts</span>
              </div>
              <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-ink-100">
                <div class="h-full ${color} transition-all duration-700" style="width: ${pct}%"></div>
              </div>
              <div class="mt-2.5 grid gap-1 text-xs sm:grid-cols-2">
                <p class="text-ink-600"><strong class="text-ink-800">Assessment:</strong> ${p.assessment}</p>
                <p class="text-brand-700"><strong class="text-ink-800">Recommendation:</strong> ${p.recommendation}</p>
              </div>
            </div>
          `;
        })
        .join("");

      // Render Red flags
      redFlagsList.innerHTML = (res.redFlags || [])
        .map((flag: string) => `<li class="flex items-start gap-2"><span class="text-red-500 font-bold">&bull;</span><span>${flag}</span></li>`)
        .join("");

      // Render Strengths
      strengthsList.innerHTML = (res.keyStrengths || [])
        .map((str: string) => `<li class="flex items-start gap-2"><span class="text-emerald-500 font-bold">&check;</span><span>${str}</span></li>`)
        .join("");

      // Render Missing trust signals
      missingTrustGrid.innerHTML = (res.missingTrustSignals || [])
        .map(
          (sig: string) => `
            <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-300 bg-amber-100/70 px-3 py-1 text-xs font-semibold text-amber-900">
              <svg class="h-3 w-3 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
              ${sig}
            </span>
          `
        )
        .join("");

      // Headline Rewrite
      headlineCurrent.textContent = `"${res.headlineRewrite?.current || 'Welcome to our business'}"`;
      headlineProposed.textContent = `"${res.headlineRewrite?.proposed || ''}"`;
      headlineRationale.textContent = res.headlineRewrite?.rationale || "";

      // CTA Rewrite
      ctaCurrent.textContent = `"${res.ctaRewrite?.current || 'Submit'}"`;
      ctaProposed.textContent = `"${res.ctaRewrite?.proposed || ''}"`;
      ctaRationale.textContent = res.ctaRewrite?.rationale || "";

      // Full report
      fullReportPre.textContent = res.detailedCopyReport;

      // Update lead CTA deep links
      const quoteUrl = new URL("/contact", window.location.origin);
      quoteUrl.searchParams.set("demo", "evaluator");
      quoteUrl.searchParams.set("score", res.totalScore.toString());
      quoteUrl.searchParams.set("business", res.businessName);
      quoteUrl.hash = "enquiry";
      bookQuoteCta.href = quoteUrl.toString();

      const waMsg = encodeURIComponent(
        `Hi webjobs.site team, I ran the Website Brand Alignment Evaluator for "${res.businessName}" in "${res.city || 'India'}". Our score was ${res.totalScore}/100 (${res.tier}). We want to talk about redesigning our site.`
      );
      whatsappAuditCta.href = `https://wa.me/919830000000?text=${waMsg}`;

    } catch (err: any) {
      formError.textContent = err.message || "An unexpected error occurred.";
      formError.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
      btnText.textContent = "Audit Website (100-Point Score)";
    }
  });
</script>
