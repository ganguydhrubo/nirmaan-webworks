---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@config/site";
import { breadcrumbJsonLd } from "@/lib/seo";

export const prerender = true;

const meta = {
  title: "How to Host Your Website on GoDaddy (or Anywhere) | ATITTLE",
  description:
    "Step-by-step: upload the website you made with the ATITTLE Free AI Website Builder to GoDaddy cPanel hosting, Netlify, Cloudflare Pages or any web host, connect your domain and turn on HTTPS.",
};

const jsonLd = [
  breadcrumbJsonLd([
    { name: "Home", url: siteConfig.siteUrl },
    { name: "Free AI Website Builder", url: `${siteConfig.siteUrl}/free-website-builder` },
    { name: "Hosting guide", url: `${siteConfig.siteUrl}/free-website-builder/hosting-guide` },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "Upload your website to GoDaddy cPanel hosting",
    step: [
      "Download and extract your website ZIP",
      "Open cPanel from your GoDaddy hosting account",
      "Open File Manager and the public_html folder",
      "Upload the files and folders",
      "Point your domain to the hosting",
      "Turn on HTTPS (SSL)",
      "Test every page",
    ].map((name, i) => ({ "@type": "HowToStep", position: i + 1, name })),
  },
];
---

<BaseLayout title={meta.title} description={meta.description} jsonLd={jsonLd}>
  <div class="border-b border-ink-200 bg-cream py-12">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <a href="/free-website-builder" class="text-sm font-semibold text-brand-600 hover:underline">← Free AI Website Builder</a>
      <h1 class="mt-3 font-display text-4xl font-semibold text-ink-950 sm:text-5xl">Host your website anywhere</h1>
      <p class="mt-4 text-lg text-ink-700">
        The builder gives you a ZIP file with plain HTML and CSS. It works on any web host. Here's exactly how to put it online, starting with GoDaddy.
      </p>
    </div>
  </div>

  <article class="guide mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <aside class="note">
      <strong>What you need (bought separately, from any provider):</strong>
      <ul>
        <li><strong>Web hosting</strong>: the space where your files live. A basic shared/cPanel plan or a free static host is plenty.</li>
        <li><strong>A domain name</strong> (optional): your own address like <code>www.yourbusiness.com</code>.</li>
      </ul>
      ATITTLE doesn't sell, require or touch your hosting, domain or email. We never ask for your GoDaddy password.
    </aside>

    <h2 id="before">Before you upload</h2>
    <ol>
      <li>In the builder, click <strong>Download</strong> → <strong>Download website (.zip)</strong>.</li>
      <li>Find the ZIP in your Downloads folder and extract it (Windows: right-click → <em>Extract All</em>. Mac: double-click).</li>
      <li>Open the extracted folder and double-click <code>index.html</code>. Your site opens in your browser. Click through every page and fix anything in the builder first.</li>
    </ol>
    <p>The folder contains <code>index.html</code> (your home page), one <code>.html</code> file per extra page, and an <code>assets</code> folder with your styles and images. Keep this structure exactly as it is.</p>

    <h2 id="godaddy">Publish on GoDaddy (Web Hosting with cPanel)</h2>
    <p class="callout">
      This is for GoDaddy's <strong>Web Hosting</strong> (cPanel) plans. GoDaddy's separate <em>Websites + Marketing</em> builder can't host uploaded files. If that's what you have, you'll need a hosting plan, or use one of the free options further down.
    </p>
    <ol class="steps">
      <li>
        <strong>Open cPanel.</strong> Sign in to GoDaddy, go to <em>My Products</em>, find <em>Web Hosting</em>, select <em>Manage</em>, then open <em>cPanel Admin</em>.
      </li>
      <li>
        <strong>Open File Manager.</strong> In cPanel, under <em>Files</em>, click <em>File Manager</em>, then open the <code>public_html</code> folder. This is your main website's folder. (For an additional domain, open that domain's own folder instead; cPanel's <em>Domains</em> page shows which folder each domain uses.)
      </li>
      <li>
        <strong>Clear out placeholder files.</strong> If <code>public_html</code> already has a default page from GoDaddy (for example a "coming soon" <code>index.html</code> or <code>default.html</code>), delete or rename it so it doesn't replace your home page.
      </li>
      <li>
        <strong>Upload.</strong> The easiest way is to click <em>Upload</em> and upload the <strong>ZIP file</strong> itself, then go back to File Manager, right-click the ZIP and choose <em>Extract</em>. Check that <code>index.html</code> and the <code>assets</code> folder ended up <em>directly inside</em> <code>public_html</code>, not inside an extra sub-folder. If they're in a sub-folder, select its contents and <em>Move</em> them up into <code>public_html</code>. Then you can delete the ZIP.
      </li>
      <li>
        <strong>Point your domain.</strong> If you bought your domain in the same GoDaddy account as your hosting, it's usually connected already. If your domain is with another registrar, update its DNS or nameservers to the values shown in your GoDaddy hosting dashboard.
      </li>
      <li>
        <strong>Turn on HTTPS.</strong> In your GoDaddy hosting dashboard, open the SSL/security section and make sure your domain has an active SSL certificate (many plans include one that installs automatically; it can take a little while after a domain is connected). In cPanel, <em>SSL/TLS Status</em> shows whether it's active.
      </li>
      <li>
        <strong>Test.</strong> Open <code>https://yourdomain.com</code> in a private/incognito window, click every menu link and button, and check it on your phone.
      </li>
    </ol>

    <h2 id="free-hosts">Free and simple alternatives</h2>
    <p>For a small static website, these work well and have free plans (check each provider's current terms):</p>
    <ul>
      <li><strong>Netlify Drop</strong>: go to <code>app.netlify.com/drop</code> and drag your extracted website folder onto the page. You get a live link in seconds and can connect your own domain later.</li>
      <li><strong>Cloudflare Pages</strong>: in the Cloudflare dashboard, open <em>Workers &amp; Pages</em>, create a Pages project and choose <em>Upload assets</em>, then upload the folder.</li>
      <li><strong>Any cPanel host</strong> (Hostinger, Bluehost, BigRock and others): follow the same steps as GoDaddy above. The folder is usually <code>public_html</code>.</li>
    </ul>

    <h2 id="domain">Connecting a domain</h2>
    <p>Your host shows the exact DNS records or nameservers to use. You enter them at the company where you bought the domain. DNS changes usually take a few minutes, and occasionally up to 48 hours. HTTPS normally becomes available once the domain points at your host.</p>

    <h2 id="update">Updating your website later</h2>
    <ol>
      <li>Reopen your project in the builder (same browser and device, or import your project backup).</li>
      <li>Make your changes and download a new ZIP.</li>
      <li>Upload the new files over the old ones, replacing them.</li>
    </ol>

    <h2 id="troubleshooting">Troubleshooting</h2>
    <dl>
      <dt>I see a GoDaddy "coming soon" page or a list of files</dt>
      <dd><code>index.html</code> isn't directly in <code>public_html</code>, or an old default page is still there. Move your files up a level and remove the placeholder.</dd>
      <dt>The page loads but looks unstyled</dt>
      <dd>The <code>assets</code> folder is missing or in the wrong place. It must sit next to <code>index.html</code>.</dd>
      <dt>My images don't show</dt>
      <dd>Make sure <code>assets/images</code> was uploaded. File names are case-sensitive on most hosts, so upload the folder exactly as downloaded.</dd>
      <dt>The contact form doesn't send messages</dt>
      <dd>Static websites need a form service for forms. In the builder, paste a form service address (for example from Formspree or Web3Forms) into the contact section, then download and upload again. Without one, your site shows phone, email and WhatsApp links instead.</dd>
      <dt>The browser says "Not secure"</dt>
      <dd>SSL isn't active yet for your domain. Check your host's SSL settings and give it some time after connecting the domain.</dd>
    </dl>

    <aside class="note note-cta">
      <strong>Rather have it done for you?</strong> ATITTLE builds and hosts fast websites for Indian businesses.
      <a href="/contact">Talk to us</a> or <a href="/free-website-builder/app">go back to the builder</a>.
    </aside>
  </article>
</BaseLayout>

<style>
  .guide h2 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--color-ink-950);
    margin: 2.4rem 0 0.8rem;
    scroll-margin-top: 6rem;
  }
  .guide p,
  .guide li,
  .guide dd {
    color: var(--color-ink-700);
    line-height: 1.7;
  }
  .guide ol,
  .guide ul {
    padding-left: 1.3rem;
    display: grid;
    gap: 0.5rem;
  }
  .guide ol {
    list-style: decimal;
  }
  .guide ul {
    list-style: disc;
  }
  .guide .steps {
    gap: 1rem;
  }
  .guide .steps li::marker {
    font-weight: 700;
    color: var(--color-brand-600);
  }
  .guide code {
    background: var(--color-ink-100);
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 0.92em;
  }
  .guide .note {
    border: 1px solid var(--color-ink-200);
    background: var(--color-cream);
    border-radius: 14px;
    padding: 18px 20px;
    color: var(--color-ink-800);
  }
  .guide .note ul {
    margin: 0.6rem 0;
  }
  .guide .note-cta {
    margin-top: 2.5rem;
  }
  .guide .note a {
    color: var(--color-brand-600);
    font-weight: 600;
    text-decoration: underline;
  }
  .guide .callout {
    border-left: 4px solid var(--color-gold-400);
    background: var(--color-gold-50);
    padding: 12px 16px;
    border-radius: 0 10px 10px 0;
  }
  .guide dt {
    font-weight: 700;
    color: var(--color-ink-950);
    margin-top: 1.1rem;
  }
  .guide dd {
    margin: 0.3rem 0 0;
  }
</style>
