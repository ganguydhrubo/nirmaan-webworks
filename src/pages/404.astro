---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import { siteConfig } from "@config/site";

export const prerender = true;
---

<BaseLayout title="Page not found" description="The page you're looking for doesn't exist." noindex>
  <section class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-4 py-20 text-center sm:px-6">
    <p class="font-display text-6xl font-semibold text-brand-500">404</p>
    <h1 class="mt-4 font-display text-2xl font-semibold text-ink-950 sm:text-3xl">We couldn't find that page</h1>
    <p class="mt-3 max-w-md text-ink-600">The link may be outdated, or the page may have moved. Here are some places to go instead:</p>

    <div class="mt-8 grid w-full gap-3 sm:grid-cols-2">
      <a href="/" class="rounded-lg border border-ink-200 bg-white p-4 text-left hover:border-brand-500">
        <span class="font-semibold text-ink-950">Homepage</span>
        <p class="text-sm text-ink-500">Start from the beginning</p>
      </a>
      <a href="/industries" class="rounded-lg border border-ink-200 bg-white p-4 text-left hover:border-brand-500">
        <span class="font-semibold text-ink-950">Industries</span>
        <p class="text-sm text-ink-500">See what we build, by category</p>
      </a>
      <a href="/pricing" class="rounded-lg border border-ink-200 bg-white p-4 text-left hover:border-brand-500">
        <span class="font-semibold text-ink-950">Pricing</span>
        <p class="text-sm text-ink-500">Starting price ranges</p>
      </a>
      <a href="/contact" class="rounded-lg border border-ink-200 bg-white p-4 text-left hover:border-brand-500">
        <span class="font-semibold text-ink-950">Contact</span>
        <p class="text-sm text-ink-500">Get a free quote</p>
      </a>
    </div>

    <a href={`tel:${siteConfig.phoneE164}`} class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-ink-500 hover:text-brand-600">
      <Icon name="phone" class="h-4 w-4" /> Or just call us: {siteConfig.phoneDisplay}
    </a>
  </section>
</BaseLayout>
