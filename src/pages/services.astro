                    <div class="rounded-lg bg-ink-950 p-2 border border-ink-800">
                      <div class="text-[10px] text-ink-400 uppercase">Monthly Spend</div>
                      <div class="font-mono font-bold text-cream mt-0.5">₹12,450</div>
                    </div>
