---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import EnquiryForm from "@/components/sections/EnquiryForm.astro";
import AiConsultationBoard from "@/components/services/AiConsultationBoard.astro";
import { siteConfig } from "@config/site";
import { waLink } from "@/lib/contact-links";

export const prerender = true;

const meta = {
  title: "Beyond Websites — Digital Services for Growing Businesses | ATITTLE",
  description: "Websites are where we started. Explore our 7 specialized practices: Meta & Google Ads, SEO & AEO, SaaS development, system repairs, IoT hardware, and custom AI agents.",
};

const services = siteConfig.otherServices;

const startingPills = [
  "Starts from ₹499 (Ad Test) · Scale to ₹35,000+",
  "Starts from ₹799 (Schema Fix) · Scale to ₹35,000+",
  "Starts from ₹2,499 (MVP Spec) · Scale to ₹85,000+",
  "Starts from ₹499 (Single Bug Patch) · Scale to ₹30,000+",
  "Starts from ₹1,499 (Sensor Spec) · Scale to ₹65,000+",
  "Starts from ₹999 (Invoice Automation) · Scale to ₹40,000+",
  "Starts from ₹1,499 (WhatsApp Bot) · Scale to ₹50,000+",
];
---

<BaseLayout title={meta.title} description={meta.description}>
  <!-- Top Cinematic Dark Luxury Hero -->
  <section class="relative overflow-hidden bg-ink-950 py-16 sm:py-24 text-cream border-b border-ink-800">
    <!-- Ambient 3D Radial Glows -->
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="absolute -top-32 left-1/3 h-96 w-96 rounded-full bg-brand-500/15 blur-3xl"></div>
      <div class="absolute top-1/2 right-10 h-80 w-80 rounded-full bg-emerald-500/10 blur-3xl"></div>
      <div class="absolute inset-0 bg-[radial-gradient(#2a221b_1px,transparent_1px)] [background-size:28px_28px] opacity-30"></div>
    </div>

    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <!-- Live Discovery Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-gold-400/40 bg-gold-950/60 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-gold-300 mb-6 backdrop-blur">
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-400 animate-pulse" aria-hidden="true"></span>
          From ₹499 Micro Solutions to Scale Enterprise &middot; 7 Practices
        </div>

        <h1 class="font-display text-3xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-cream text-balance leading-[1.12]">
          Websites are where we started. <br />
          <span class="bg-gradient-to-r from-brand-400 via-gold-300 to-brand-300 bg-clip-text text-transparent italic">
            Here's everything else.
          </span>
        </h1>

        <p class="mt-5 text-base sm:text-lg text-ink-300 leading-relaxed max-w-2xl mx-auto">
          A high-converting website is the anchor. But when your business needs high-intent customers from ads, top citations on ChatGPT & Gemini, recurring subscription software, connected hardware, or a 24/7 AI employee — we engineer the complete system.
        </p>

        <!-- Sound Toolbar Affordance & Quick Scroller -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <div class="inline-flex items-center gap-3 rounded-full border border-ink-700 bg-ink-900/90 px-4 py-2 text-xs font-medium text-ink-300 shadow-sm backdrop-blur">
            <button
              type="button"
              class="services-sound-btn inline-flex items-center gap-1.5 font-semibold text-cream hover:text-brand-400 transition cursor-pointer"
              data-services-sound-btn
              aria-label="Toggle arrival sound effects"
              title="Toggle arrival sound effects"
            >
              <span class="services-sound-icon" data-services-sound-icon>🔊</span>
              <span class="services-sound-label" data-services-sound-label>Sound ON</span>
            </button>
            <span class="text-ink-600">•</span>
            <span class="text-ink-400">Interactive 3D Stages</span>
          </div>

          <a
            href="#ai-consultation-board"
            class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/40 bg-emerald-950/70 px-4 py-2 text-xs font-semibold text-emerald-300 hover:bg-emerald-900 transition"
          >
            <span>Try AI Digital Architect &darr;</span>
          </a>
        </div>

        <!-- Quick Jump Practice Strip (Sticky on Desktop) -->
        <div class="mt-10 flex flex-wrap items-center justify-center gap-2 pt-6 border-t border-ink-800/80 text-xs">
          <span class="text-ink-500 mr-1 hidden sm:inline">Jump to practice:</span>
          {services.map((s, idx) => (
            <a
              href={`#${s.id}`}
              class="rounded-lg border border-ink-800 bg-ink-900/60 px-2.5 py-1 text-ink-300 hover:border-brand-500 hover:text-white transition"
            >
              0{idx + 1} {s.name.split(" ")[0]}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- The 7 Cinematic Service Scenes with 3D Dolly Stages -->
  <section class="services-flow bg-ink-900 py-16 sm:py-24 text-cream" data-services-flow>
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 space-y-20 sm:space-y-32">
      {services.map((s, idx) => (
        <article
          id={s.id}
          class="service-scene group relative rounded-3xl border border-ink-800 bg-ink-950/90 p-6 sm:p-10 lg:p-12 transition-all duration-300 scroll-mt-24 shadow-2xl backdrop-blur"
          data-service-scene
          data-service-index={idx}
