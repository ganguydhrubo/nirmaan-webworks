                    </div>
                    <div class="rounded-xl bg-ink-950 p-3 border border-ink-800">
                      <div class="text-[10px] text-ink-400 uppercase">Active Subscriptions</div>
                      <div class="font-mono text-lg font-bold text-cream mt-0.5">412 SMBs</div>
