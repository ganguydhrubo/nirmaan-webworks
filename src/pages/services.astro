          <!-- Specular Glare Reflection Layer -->
          <div class="scene-glare pointer-events-none absolute inset-0 rounded-3xl opacity-0 transition-opacity duration-300" aria-hidden="true"></div>

          <!-- Top Chrome Header Bar -->
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink-800 pb-5 mb-8">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-950 border border-brand-500/40 text-sm font-mono font-bold text-brand-400">
                0{idx + 1}
