          <!-- Two-Column Cinematic Layout: Narrative (Left) + Interactive Visual 3D Stage (Right) -->
          <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] items-center">
            <!-- Left: SMB Narrative & Plain-English Takeaways -->
