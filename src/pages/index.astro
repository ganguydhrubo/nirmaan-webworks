---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/home/Hero.astro";
import CategoryBar from "@/components/sections/home/CategoryBar.astro";
import Problem from "@/components/sections/home/Problem.astro";
import WhatWeBuild from "@/components/sections/home/WhatWeBuild.astro";
import IndustryShowcase from "@/components/sections/home/IndustryShowcase.astro";
import WhyUs from "@/components/sections/home/WhyUs.astro";
import Process from "@/components/sections/home/Process.astro";
import PricingTeaser from "@/components/sections/home/PricingTeaser.astro";
import Proof from "@/components/sections/home/Proof.astro";
import FaqTeaser from "@/components/sections/home/FaqTeaser.astro";
import FinalCta from "@/components/sections/home/FinalCta.astro";
import { siteConfig } from "@config/site";

export const prerender = true;
---

<BaseLayout
  title={siteConfig.tagline}
  description={siteConfig.shortDescription}
>
  <Hero />
  <CategoryBar />
  <Problem />
  <WhatWeBuild />
  <IndustryShowcase />
  <WhyUs />
  <Process />
  <PricingTeaser />
  <Proof />
  <FaqTeaser />
  <FinalCta />
</BaseLayout>
