---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@config/site";

export const prerender = true;
---

<BaseLayout title={siteConfig.tagline} description={siteConfig.shortDescription}>
  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
    <h1 class="font-display text-4xl font-semibold text-ink-950">{siteConfig.tagline}</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-700">{siteConfig.shortDescription}</p>
  </section>
</BaseLayout>
