---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import { siteConfig } from "@config/site";
import { breadcrumbJsonLd } from "@/lib/seo";

export const prerender = true;

function formatInr(n: number): string {
  return `₹${n.toLocaleString("en-IN")}`;
}

const jsonLd = [
  breadcrumbJsonLd([
    { name: "Home", url: siteConfig.siteUrl },
    { name: "Pricing", url: `${siteConfig.siteUrl}/pricing` },
  ]),
];
---

<BaseLayout title="Website Pricing in INR — Transparent Packages | ATITTLE" description="Starter to custom website packages for Indian businesses, all priced in plain rupees. See exactly what's included, excluded, and what renewal actually costs." jsonLd={jsonLd}>
  <section class="bg-cream py-14 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-ink-950 sm:text-4xl">Pricing, in plain rupees</h1>
      <p class="mt-4 text-lg text-ink-700">Starting ranges below. Your exact quote is confirmed in writing before any work begins — no surprise line items.</p>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {siteConfig.priceRanges.map((tier) => (
          <div class:list={["min-w-0 flex flex-col rounded-2xl border p-6", tier.id === "business" ? "border-brand-500 ring-1 ring-brand-500 bg-brand-50/20" : tier.id === "micro-starter" ? "border-emerald-500 bg-emerald-50/20" : "border-ink-200"]}>
            {tier.id === "micro-starter" && <span class="mb-3 inline-block w-fit rounded-full bg-emerald-700 px-3 py-1 text-xs font-semibold text-cream">Retail & Local Shops</span>}
            {tier.id === "business" && <span class="mb-3 inline-block w-fit rounded-full bg-brand-600 px-3 py-1 text-xs font-semibold text-cream">Most chosen</span>}
            <h2 class="font-display text-lg font-semibold text-ink-950">{tier.name}</h2>
            <p class="mt-2 font-display text-2xl font-semibold text-ink-950">
              {formatInr(tier.priceMinInr)}<span class="text-base text-ink-500"> – {formatInr(tier.priceMaxInr)}</span>
            </p>
            <p class="mt-1 text-xs text-ink-500">{tier.indicativeTimelineWeeks[0]}–{tier.indicativeTimelineWeeks[1]} weeks</p>
            <p class="mt-3 text-sm text-ink-600">{tier.bestFor}</p>

            <div class="mt-6">
              <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Includes</p>
              <ul class="mt-2 space-y-2 text-sm text-ink-700">
                {tier.includes.map((item) => (
                  <li class="flex items-start gap-2"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-teal-600" /> {item}</li>
                ))}
              </ul>
            </div>
            <div class="mt-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-ink-500">Doesn't include</p>
              <ul class="mt-2 space-y-2 text-sm text-ink-500">
                {tier.excludes.map((item) => (
                  <li class="flex items-start gap-2"><Icon name="close" class="mt-0.5 h-4 w-4 shrink-0 text-ink-400" /> {item}</li>
                ))}
              </ul>
            </div>

            <a href={`/contact?package=${encodeURIComponent(tier.name)}`} class="mt-6 inline-flex items-center justify-center rounded-md bg-brand-600 px-5 py-3 font-semibold text-cream hover:bg-brand-700" data-analytics-event="cta_click">
              Get a quote for this
            </a>
          </div>
        ))}
      </div>

      <div class="mt-12 grid gap-6 rounded-xl border border-ink-200 bg-cream p-6 sm:p-8 md:grid-cols-3">
        <div class="min-w-0">
          <h3 class="font-semibold text-ink-950">GST</h3>
          <p class="mt-1 text-sm text-ink-600">{siteConfig.gstNote}</p>
        </div>
        <div class="min-w-0">
          <h3 class="font-semibold text-ink-950">Optional maintenance</h3>
          <p class="mt-1 text-sm text-ink-600">
            {formatInr(siteConfig.maintenanceMonthlyInr.min)}–{formatInr(siteConfig.maintenanceMonthlyInr.max)}/month for content updates and fixes — never required to keep your site running.
          </p>
        </div>
        <div class="min-w-0">
          <h3 class="font-semibold text-ink-950">Domain & hosting</h3>
          <p class="mt-1 text-sm text-ink-600">Domain registration (₹500–₹1,500/year, paid to the registrar) is separate. Hosting is typically included on a free tier suited to your traffic.</p>
        </div>
      </div>

      <div class="mt-12 text-center">
        <h2 class="font-display text-2xl font-semibold text-ink-950">Not sure which package fits?</h2>
        <p class="mt-2 text-ink-600">Tell us what you're building — we'll recommend one and quote it, free.</p>
        <a href="/contact" class="mt-5 inline-flex items-center gap-2 rounded-md bg-ink-950 px-6 py-3.5 font-semibold text-cream hover:bg-ink-800">Get a free quote</a>
      </div>
    </div>
  </section>
</BaseLayout>
