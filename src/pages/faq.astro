---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import { faqItems } from "@/content/faq";
import { faqJsonLd } from "@/lib/seo";

export const prerender = true;

const categories = [...new Set(faqItems.map((f) => f.category))];
const jsonLd = [faqJsonLd(faqItems.map((f) => ({ question: f.question, answer: f.answer })))];
---

<BaseLayout title="Frequently asked questions" description="Straight answers on pricing, timelines, ownership, hosting and support for a webjobs.site website project." jsonLd={jsonLd}>
  <section class="bg-cream py-14 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-ink-950 sm:text-4xl">Frequently asked questions</h1>
      <p class="mt-4 text-lg text-ink-700">The real questions, answered plainly — not marketing non-answers.</p>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      {categories.map((cat) => (
        <div class="mb-10">
          <h2 class="mb-4 font-display text-xl font-semibold text-ink-950">{cat}</h2>
          <div class="divide-y divide-ink-200 rounded-xl border border-ink-200 bg-cream">
            {faqItems.filter((f) => f.category === cat).map((f, i) => (
              <details class="group p-5 sm:p-6" open={i === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink-900 marker:content-none">
                  {f.question}
                  <Icon name="chevron-down" class="h-5 w-5 shrink-0 text-ink-400 transition-transform group-open:rotate-180" />
                </summary>
                <p class="mt-3 text-ink-600">{f.answer}</p>
              </details>
            ))}
          </div>
        </div>
      ))}

      <div class="mt-12 rounded-xl border border-ink-200 bg-ink-950 p-6 text-center sm:p-8">
        <h2 class="font-display text-xl font-semibold text-cream">Still have a question?</h2>
        <p class="mt-2 text-ink-300">Ask us directly — we reply within one business day.</p>
        <a href="/contact" class="mt-4 inline-flex items-center gap-2 rounded-md bg-brand-600 px-6 py-3 font-semibold text-cream hover:bg-brand-700">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
