---
/**
 * ATITTLE Brand Studio — Full-Screen Creative Visual Design Editor
 * Canva-grade, client-rendered Preact island.
 *
 * All design projects live privately in the visitor's browser (LocalStorage/IndexedDB).
 * Zero server uploads required.
 */
import StudioApp from "@/scripts/brand-studio/App";
import "@/styles/global.css";
import "@/styles/fonts.css";

export const prerender = true;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d0d11" />
    <title>ATITTLE Brand Studio — High-End Design & Visual Marketing Editor</title>
    <meta
      name="description"
      content="Create high-converting social media creatives, WhatsApp status deals, festival banners, and visiting cards with the ATITTLE Brand Studio."
    />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://atittle.com/free-brand-studio" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #0d0d11;
        color: #f5f5f7;
        font-family: "Manrope", ui-sans-serif, system-ui, -apple-system, sans-serif;
      }
      *, *::before, *::after {
        box-sizing: border-box;
      }
      noscript p {
        font-family: system-ui, sans-serif;
        max-width: 560px;
        margin: 15vh auto;
        padding: 20px;
        line-height: 1.6;
        color: #fbf6ee;
      }
    </style>
  </head>
  <body>
    <StudioApp client:only="preact" />
    <noscript>
      <p>
        ATITTLE Brand Studio requires JavaScript to run. Please enable JavaScript in your browser settings, or{" "}
        <a href="/free-brand-studio" style="color: #f59e0b; text-decoration: underline;">
          go back to the main studio overview
        </a>.
      </p>
    </noscript>
  </body>
</html>
