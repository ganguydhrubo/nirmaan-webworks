---
import StudioShell from '@/components/demos/StudioShell.astro';
import {Image} from 'astro:assets';
import celebration from '@/assets/demos/expansion/wedding-hero.jpg';
import portrait from '@/assets/demos/expansion/wedding-couple.jpg';
import detail from '@/assets/demos/expansion/wedding-detail.jpg';
import {stories} from '@/content/demos/saanjh-stories/stories';
import './theme.css';
export const prerender=true;
const images={celebration,portrait,detail};
---
<StudioShell slug="saanjh-stories" title="Saanjh Stories — Some days stay with you" description="A fictional Jaipur wedding photography studio. Explore an immersive editorial gallery, approach and sample coverage." theme="#241b1a" fonts="/fonts/demos/mogra-house/display.css" links={[{href:'#stories',label:'The stories'},{href:'#approach',label:'Our way'},{href:'#coverage',label:'The details'}]}>
<span slot="wordmark">saanjh<span>STORIES</span></span><span slot="nav-cta">Tell us your story ↗</span>
<section class="ss-hero"><Image src={celebration} alt="A joyful haldi celebration with flowers in the air; illustrative photograph" widths={[480,800,1280,1600]} sizes="100vw" width={1600} height={1067} loading="eager" fetchpriority="high" class="sd-hero-photo"/><div class="ss-hero-title"><p class="sd-eyebrow">Wedding stories, held a little closer.</p><h1><span class="sd-hero-line">Some days</span><span class="sd-hero-line"><em>stay with you.</em></span></h1><a href="#stories">Step into the stories <span aria-hidden="true">↓</span></a></div><div class="ss-caption"><span>JAIPUR & WHEREVER YOUR STORY GOES</span><span>FICTIONAL STUDIO / ILLUSTRATIVE PHOTOGRAPHY</span></div></section>
<section class="ss-intro sd-wrap sd-section" id="approach"><p class="sd-eyebrow">Saanjh / The hour between day and night</p><h2>A room full of people.<br/>A thousand little feelings.<br/><em>One day, entirely yours.</em></h2><p>A photography studio concept for celebrations that feel like the people at their heart. Present for the big moments. Attentive to everything in between.</p><span class="ss-flourish" aria-hidden="true">&</span></section>
<section id="stories" class="ss-stories"><div class="sd-wrap ss-story-heading"><p class="sd-eyebrow">The feeling of a day / An editorial moodboard</p><p>Three studies in celebration. Licensed photographs, not work or clients of this fictional studio.</p></div>{stories.map((s,i)=><article class:list={['ss-story','sd-story-step',{'ss-story-reverse':i===1,'ss-story-detail':i===2}]} id={s.id}><a href={images[s.image].src} data-gallery-open={i} class="ss-story-image" aria-label={`Open photograph: ${s.title}`}><Image src={images[s.image]} alt={s.caption} widths={[480,800,1280,1600]} sizes="(max-width: 760px) 100vw, 65vw" width={1280} loading="lazy" class="sd-scroll-image"/><span class="ss-expand" aria-hidden="true">View full frame ↗</span></a><div class="ss-story-copy"><p class="sd-eyebrow">{s.chapter}</p><h2>{s.title}</h2><p>{s.text}</p><p class="sd-note">{s.caption}</p></div></article>)}</section>
<dialog class="ss-lightbox sd-dialog" data-gallery-dialog aria-label="Editorial photograph gallery"><form method="dialog"><button class="sd-dialog-close">Close gallery ×</button></form><div data-gallery-stage></div><div class="ss-gallery-controls"><button type="button" data-gallery-prev aria-label="Previous photograph">← Previous</button><p data-gallery-count aria-live="polite"></p><button type="button" data-gallery-next aria-label="Next photograph">Next →</button></div><p class="sd-note">Illustrative photography. No real client work is represented.</p></dialog>
<section class="ss-way sd-wrap sd-section"><div><p class="sd-eyebrow">The way we see it</p><h2>Less performance.<br/><em>More presence.</em></h2></div><div><p>Make time for the portraits, then make room for the day. A conversation about the people, rituals and details that matter is the best place to begin.</p><div class="ss-principles">{[['Before','Listen to what matters. Map the events, the people and the moments you do not want to miss.'],['During','Work around the celebration. Keep portraits considered, family groups organised and the rest of the day open.'],['After','Edit for a coherent story. Agree delivery dates, image rights and album decisions in the written scope.']].map(([title,body])=><article class="sd-story-step"><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>
<section id="coverage" class="ss-coverage sd-wrap sd-section"><div class="sd-section-head"><div><p class="sd-eyebrow">Beautifully clear, from the beginning</p><h2>Every story<br/><em>has its own shape.</em></h2></div><p>Illustrative scopes to start a conversation. Final coverage depends on the event schedule, locations and deliverables.</p></div><div class="sd-grid">{[{title:'An intimate day',tag:'One event / up to 6 hours',body:'Photography for a smaller celebration, with time for the ceremony, portraits and the people closest to you.',deliver:'Sample scope: one photographer, edited digital gallery.'},{title:'The whole celebration',tag:'Two days / up to 8 hours each',body:'Space for the events around the ceremony, family stories and the quieter moments between celebrations.',deliver:'Sample scope: two photographers, edited digital gallery.'},{title:'Just the two of you',tag:'A portrait story / up to 2 hours',body:'A thoughtful location, a little time together and a set of portraits that feel like you.',deliver:'Sample scope: one photographer, one location, edited digital gallery.'}].map(c=><article><p class="sd-eyebrow">{c.tag}</p><h3>{c.title}</h3><p>{c.body}</p><details class="sd-detail"><summary>What to plan for</summary><p>{c.deliver} Travel, venue permissions, film and printed albums are quoted separately. This concept does not accept bookings.</p></details></article>)}</div><details class="sd-detail"><summary>What should we include in a first enquiry?</summary><p>Your dates, city, event list, approximate guest count and whether you are looking for photographs, films or both. Share only the details needed to discuss the scope.</p></details></section>
<span slot="closing">Let’s make room<br/><em>for your story.</em></span>
</StudioShell>
<script>
const gallery=document.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
if(gallery && typeof gallery.showModal==='function'){
const links=[...document.querySelectorAll<HTMLAnchorElement>('[data-gallery-open]')];let current=0;let opener:HTMLAnchorElement|undefined;
const show=(index:number)=>{current=(index+links.length)%links.length;const source=links[current]!.querySelector('img')!;const image=source.cloneNode(true) as HTMLImageElement;image.className='';image.loading='eager';image.sizes='90vw';gallery.querySelector('[data-gallery-stage]')!.replaceChildren(image);gallery.querySelector('[data-gallery-count]')!.textContent=`${current+1} / ${links.length} · ${source.alt}`;};
links.forEach((link,i)=>link.addEventListener('click',event=>{event.preventDefault();opener=link;show(i);gallery.showModal();}));gallery.querySelector('[data-gallery-prev]')!.addEventListener('click',()=>show(current-1));gallery.querySelector('[data-gallery-next]')!.addEventListener('click',()=>show(current+1));gallery.addEventListener('keydown',event=>{if(event.key==='ArrowLeft'){event.preventDefault();show(current-1);}if(event.key==='ArrowRight'){event.preventDefault();show(current+1);}});gallery.addEventListener('close',()=>opener?.focus());
}
</script>
