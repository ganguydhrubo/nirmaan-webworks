---
import DemoLayout from '@/layouts/DemoLayout.astro';
import { Picture } from 'astro:assets';
import photo from '@/assets/demos/kayal.jpg';
import { rooms, experiences } from '@/content/demos/kayal';
export const prerender = true;
---
<DemoLayout demoSlug="kayal-backwaters" title="Kayal Backwaters | A slower stay in Alleppey" description="Waterside cottages, Kerala cooking and unhurried days. Explore the fictional Kayal Backwaters resort in Alleppey." fontsHref="/fonts/demos/kayal-backwaters/fonts.css" themeColor="#0f2b23">
  <div class="kayal">
    <header class="resort-nav wrap">
      <a href="/demos/kayal-backwaters" class="wordmark" aria-label="Kayal Backwaters home"><svg viewBox="0 0 48 32" width="48" height="32" aria-hidden="true"><path d="M2 22q11-12 22 0t22 0M2 29q11-12 22 0t22 0" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="24" cy="9" r="6" fill="currentColor"/></svg>kayal<span>BACKWATERS · ALLEPPEY</span></a>
      <nav aria-label="Resort"><a href="#stay">Stay</a><a href="#experience">Experience</a><a href="#reach">Find us</a><a class="button" href="#dates">Plan your stay</a></nav>
    </header>
    <main>
      <section class="resort-hero">
        <div class="hero-copy wrap"><p class="eyebrow">A little closer to the water</p><h1>Let the backwaters<br />set your pace.</h1><p>Morning tea on the verandah. A canoe without an itinerary. Kerala cooking that keeps you at the table.</p><a href="#stay" class="text-link">Find your corner of Kayal ↓</a></div>
        <figure><Picture src={photo} formats={['avif','webp']} widths={[480,800,1200,1400]} sizes="100vw" alt="Palm-lined Kerala waterway beside waterside cottages" loading="eager" fetchpriority="high" /><figcaption>Setting inspiration · licensed Kerala photography, fictional property.</figcaption></figure>
        <div class="resort-note wrap"><span>ALLEPPEY, KERALA</span><span>Breakfast included · Direct enquiries</span><span>Unhurried, by design</span></div>
      </section>
      <section id="stay" class="wrap section"><div class="section-title"><p class="eyebrow">Room to settle in</p><h2>Three ways to stay<br />close to the water.</h2><p>Natural textures, reading lights where you need them, and a verandah for doing very little.</p></div>
        <div class="room-list">{rooms.map((room, i) => <article><span class="room-number">0{i+1}</span><div><h3>{room.name}</h3><p>{room.description}</p><p class="room-spec">{room.area} · Up to {room.guests} guests · {room.view}</p></div><div><p class="rate">₹{room.rate.toLocaleString('en-IN')}<small>/ night, indicative</small></p><a class="text-link" href="#dates">Explore this stay ↗</a></div></article>)}</div>
        <p class="fine">Sample rates for two adults; family rate for four. Breakfast included; applicable taxes extra. No availability or price is live in this demo.</p>
      </section>
      <section id="experience" class="experience"><div class="wrap section"><p class="eyebrow">A day without a checklist</p><h2>Leave a little space<br />for nothing at all.</h2><div class="itinerary">{experiences.map(e => <article><p class="eyebrow">{e.time} IST</p><h3>{e.name}</h3><p>{e.detail}</p></article>)}</div></div></section>
      <section class="wrap section story"><p class="eyebrow">The Kayal story</p><div><h2>A house by the water.<br />A table with room for you.</h2><p>Our fictional family-run retreat imagines a gentler kind of Kerala holiday: fewer plans, meals cooked to the season, and hosts who remember how you take your tea.</p><p>Enquire directly to discuss room layouts, food preferences and arrival transfers before deciding. A conversation should come before a booking.</p></div></section>
      <section id="dates" class="wrap section booking"><div><p class="eyebrow">Make room for a pause</p><h2>What would your<br />stay look like?</h2><p>Try the stay planner. It estimates room charges locally and does not reserve a room or send your details.</p></div><form data-stay-planner>
        <label>Room<select name="room">{rooms.map(r => <option value={r.rate}>{r.name}</option>)}</select></label>
        <div class="date-pair"><label>Arrival<input name="arrival" type="date" required /></label><label>Departure<input name="departure" type="date" required /></label></div>
        <button class="button" type="submit">Preview my stay</button><p data-stay-result role="status">Choose your dates to see an indicative room total.</p><noscript>This planner needs JavaScript. Room rates are listed above; this demo does not accept bookings.</noscript>
      </form></section>
      <section id="reach" class="wrap section practical"><div><p class="eyebrow">Before you arrive</p><h2>The useful details.</h2><p>Sample address: 18 Canal Road, Kainakary, Alappuzha, Kerala 688501. Fictional location; no guest services operate here.</p><p>For a real stay in this region, plan your arrival via Alappuzha railway station or Kochi airport and confirm your final transfer with your host.</p></div><div>{[
        ['When is check-in?', 'Sample house policy: check-in from 2:00 PM, check-out by 11:00 AM IST. Early arrivals would be subject to availability.'],
        ['Can children stay?', 'The family courtyard is designed for four guests. Waterside paths require adult supervision. Discuss accessibility and cot requirements before confirming a real booking.'],
        ['What about cancellations?', 'A real quote would state the cancellation deadline and refund terms before payment. This demo collects no payments and confirms no bookings.'],
        ['Can you accommodate food preferences?', 'The sample menu includes vegetarian choices. Allergy arrangements would need confirmation directly with a real kitchen.'],
      ].map(([q,a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div></section>
    </main><footer class="wrap section"><span class="wordmark">kayal</span><p>A fictional retreat. An example of what your resort’s website could be.</p><a class="text-link" href="/contact?category=Hotels%20%26%20Resorts&demo=kayal-backwaters">Build a website for your property ↗</a></footer>
  </div><script src="../../../scripts/demos/kayal-stay.ts"></script>
</DemoLayout>
<style>
.kayal{background:#f3f7f5;color:#0f2b23;font-family:Karla,Arial,sans-serif}.wrap{width:min(1180px,calc(100% - 40px));margin-inline:auto}.section{padding-block:80px}.wordmark{font:600 42px Cormorant,Georgia,serif;line-height:1;display:block}.wordmark svg{display:inline-block;margin-right:10px}.wordmark span{display:block;font:500 10px Karla,sans-serif;letter-spacing:.18em;margin:10px 0 0 58px}.resort-nav{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-block:24px}.resort-nav nav{display:flex;align-items:center;gap:22px}.resort-nav nav a{padding-block:12px;font-size:15px}.button{display:inline-flex;align-items:center;justify-content:center;background:#1c4d40;color:#fff;padding:14px 22px!important;border-radius:0;min-height:48px}.eyebrow{font-size:12px;letter-spacing:.17em;text-transform:uppercase;font-weight:700;margin-bottom:18px}h1,h2,h3{font-family:Cormorant,Georgia,serif;font-weight:500;letter-spacing:-.035em}h1{font-size:clamp(48px,7vw,88px);line-height:1.03}h2{font-size:clamp(36px,5vw,56px);line-height:1.08;margin-bottom:24px}h3{font-size:32px;line-height:1.15}p{line-height:1.7}a:hover{text-decoration:underline;text-underline-offset:5px}.hero-copy{padding-block:50px;max-width:1180px}.hero-copy>p:not(.eyebrow){max-width:430px;margin-block:22px}.text-link{display:inline-block;padding-block:12px;border-bottom:1px solid currentColor;font-weight:600}.resort-hero figure{position:relative}.resort-hero :global(img){width:100%;height:clamp(280px,40vw,520px);object-fit:cover}.resort-hero figcaption{font-size:11px;padding:8px 20px;background:#0f2b23;color:#fff}.resort-note{display:flex;gap:20px;justify-content:space-between;padding-block:22px;font-size:12px;letter-spacing:.05em;border-bottom:1px solid #94c2b3}.section-title{max-width:580px}.room-list{margin-top:40px}.room-list article{display:grid;grid-template-columns:55px 1fr 200px;gap:24px;border-top:1px solid #94c2b3;padding-block:30px}.room-list p{margin-top:14px;max-width:520px}.room-number{font:32px Cormorant,serif;color:#256554}.room-spec,.fine{font-size:13px}.rate{font-size:24px!important}.rate small{display:block;font-size:12px}.experience{background:#0f2b23;color:#f3f7f5}.experience h2,.experience h3{color:#f3f7f5}.itinerary{display:grid;grid-template-columns:repeat(3,1fr);gap:36px;margin-top:50px}.itinerary h3{margin-bottom:16px}.itinerary .eyebrow{color:#e4c896}.story,.booking,.practical{display:grid;grid-template-columns:1fr 1fr;gap:70px;border-bottom:1px solid #94c2b3}.story p{margin-bottom:20px}.booking form{background:#dcece6;padding:32px}.booking label{display:block;font-size:14px;font-weight:600}.booking input,.booking select{display:block;width:100%;min-width:0;background:#fff;border:1px solid #256554;padding:12px;margin:8px 0 20px;font-size:16px}.date-pair{display:grid;grid-template-columns:1fr 1fr;gap:15px}.booking [role=status]{margin-top:18px}details{border-bottom:1px solid #94c2b3;padding-block:16px}summary{cursor:pointer;min-height:44px;padding-top:10px;font-weight:600}details p{font-size:15px;margin-bottom:12px}footer{padding-bottom:60px!important}footer p{margin-block:20px}@media(min-width:900px){.hero-copy{position:relative}.hero-copy>p:not(.eyebrow){position:absolute;right:0;bottom:75px}}@media(max-width:700px){.section{padding-block:48px}.resort-nav{flex-wrap:wrap}.resort-nav nav{width:100%;gap:16px;justify-content:space-between}.resort-nav nav a{font-size:13px}.resort-note{flex-wrap:wrap;gap:8px}.room-list article{grid-template-columns:32px 1fr;gap:12px}.room-list article>div:last-child{grid-column:2}.itinerary,.story,.booking,.practical{grid-template-columns:1fr;gap:32px}.booking form{padding:20px}.date-pair{grid-template-columns:1fr;gap:0}}
</style>
