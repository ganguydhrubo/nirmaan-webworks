---
import DemoPhoto from "@/components/ui/DemoPhoto.astro";
import DemoLayout from "@/layouts/DemoLayout.astro";
import Header from "./_components/Header.astro";
import Footer from "./_components/Footer.astro";
import ArchDivider from "./_components/ArchDivider.astro";
import { menuCategories } from "@/content/demos/anaar-awadhi-table/menu";
import { waLink } from "@/lib/contact-links";
import { siteConfig } from "@config/site";

export const prerender = true;

const specials = [
  menuCategories.find((c) => c.id === "kebabs")!.items[0]!,
  menuCategories.find((c) => c.id === "biryani")!.items[0]!,
  menuCategories.find((c) => c.id === "curries")!.items[1]!,
];
---

<DemoLayout
  demoSlug="anaar-awadhi-table"
  title="Anaar — The Awadhi Table | Lucknow's kitchen, plated properly"
  description="Awadhi kebabs, dum biryani and Nawabi kormas in the heart of Lucknow. Reserve a table at Anaar — The Awadhi Table."
  fontsHref="/fonts/demos/anaar-awadhi-table/fonts.css"
  themeColor="#6f2224"
>
  <Header />

  <main class="bg-anaar-cream">
    <!-- Hero: typography + ornament led, deliberately photography-free -->
    <section class="relative overflow-hidden bg-anaar-900 py-20 sm:py-28">
      <div class="pointer-events-none absolute inset-0 opacity-[0.07]" aria-hidden="true" style="background-image: radial-gradient(circle at 20% 20%, var(--color-anaar-gold) 0, transparent 45%), radial-gradient(circle at 80% 60%, var(--color-anaar-gold) 0, transparent 40%);"></div>
      <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <svg viewBox="0 0 48 48" class="mx-auto mb-6 h-12 w-12 reveal" aria-hidden="true">
          <path d="M24 10c5 5 9 10 9 16a9 9 0 0 1-18 0c0-6 4-11 9-16Z" fill="var(--color-anaar-gold)"></path>
          <path d="M24 10c-1.5 1.5-2.7 3-3.7 4.5" stroke="var(--color-anaar-900)" stroke-width="0.5"></path>
        </svg>
        <p class="reveal min-w-0 font-['Lato'] text-xs font-semibold uppercase tracking-[0.3em] text-anaar-gold">Awadhi Cuisine · Lucknow</p>
        <h1 class="reveal min-w-0 mt-4 font-['Playfair_Display'] text-4xl font-bold leading-tight text-anaar-cream sm:text-5xl md:text-6xl">
          Lucknow's kitchen,<br /><em class="italic text-anaar-gold">plated properly.</em>
        </h1>
        <p class="reveal min-w-0 mx-auto mt-6 max-w-xl font-['Lato'] text-lg text-anaar-cream/80">
          Our Galouti Kebab is worked by hand through more than a dozen spices until it needs no teeth to enjoy — a recipe Lucknow has guarded for generations, and one we serve exactly as it should be.
        </p>
        <div class="reveal mt-10 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/demos/anaar-awadhi-table/reservations/" class="rounded-full bg-anaar-gold px-7 py-3.5 font-['Lato'] text-sm font-semibold tracking-wide text-anaar-900 hover:bg-anaar-gold/90">
            Reserve a Table
          </a>
          <a href="/demos/anaar-awadhi-table/menu/" class="rounded-full border border-anaar-gold/50 px-7 py-3.5 font-['Lato'] text-sm font-semibold tracking-wide text-anaar-cream hover:border-anaar-gold">
            View Full Menu
          </a>
        </div>
      </div>
      <ArchDivider class="absolute bottom-0 left-0 h-6 w-full text-anaar-cream" />
    </section>
    <DemoPhoto name="anaar" />

    <!-- Festive offer banner -->
    <section class="border-b border-anaar-300/40 bg-anaar-gold/10 py-3">
      <p class="mx-auto max-w-4xl px-4 text-center font-['Lato'] text-sm font-medium text-anaar-700 sm:px-6">
        Zaiqa-e-Awadh Food Festival — through the month, an extended tasting menu of Nawabi specials. Ask when you reserve.
      </p>
    </section>

    <!-- Chef's specials -->
    <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="reveal min-w-0 mx-auto max-w-xl text-center">
          <p class="font-['Lato'] text-xs font-semibold uppercase tracking-[0.25em] text-anaar-600">Chef's Specials</p>
          <h2 class="mt-3 font-['Playfair_Display'] text-3xl font-bold text-anaar-900 sm:text-4xl">Three dishes worth the trip</h2>
        </div>
        <div class="mt-12 grid gap-6 sm:grid-cols-3">
          {specials.map((item) => (
            <div class="reveal min-w-0 rounded-lg border border-anaar-300/50 bg-white p-6">
              <p class="font-['Playfair_Display'] text-xl font-semibold text-anaar-900">{item.name}</p>
              <p class="mt-2 text-sm text-anaar-700">{item.description}</p>
              <p class="mt-4 font-['Lato'] font-semibold text-anaar-600">₹{item.priceInr}</p>
            </div>
          ))}
        </div>
        <p class="reveal mt-8 text-center">
          <a href="/demos/anaar-awadhi-table/menu/" class="font-['Lato'] text-sm font-semibold text-anaar-600 hover:text-anaar-700">See the full menu →</a>
        </p>
      </div>
    </section>

    <!-- Story teaser -->
    <section class="bg-anaar-900 py-16 sm:py-20">
      <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
        <h2 class="font-['Playfair_Display'] text-2xl font-bold text-anaar-cream sm:text-3xl">A kitchen that still cooks the slow way</h2>
        <p class="mt-4 font-['Lato'] text-anaar-cream/75">
          Nihari that simmers overnight. Biryani sealed and steamed under dough, never rushed. At Anaar, we cook the way Lucknow's khansamas always have — because Awadhi food was never meant to be fast.
        </p>
        <a href="/demos/anaar-awadhi-table/our-story/" class="mt-6 inline-block font-['Lato'] text-sm font-semibold text-anaar-gold hover:underline">Read our story →</a>
      </div>
    </section>

    <!-- Location & timings -->
    <section class="py-16 sm:py-20">
      <div class="mx-auto grid max-w-5xl gap-8 px-4 sm:grid-cols-2 sm:px-6 lg:px-8">
        <div class="min-w-0 rounded-lg border border-anaar-300/50 bg-white p-6">
          <h3 class="font-['Playfair_Display'] text-lg font-semibold text-anaar-900">Find us</h3>
          <p class="mt-2 text-sm text-anaar-700">14 Hazratganj Crossing, Lucknow, Uttar Pradesh 226001</p>
          <div class="mt-4 aspect-[16/9] rounded-md border border-anaar-300/50 bg-anaar-50 flex items-center justify-center text-xs text-anaar-500">Map placeholder — demo only</div>
        </div>
        <div class="min-w-0 rounded-lg border border-anaar-300/50 bg-white p-6">
          <h3 class="font-['Playfair_Display'] text-lg font-semibold text-anaar-900">Timings</h3>
          <dl class="mt-2 space-y-1.5 text-sm text-anaar-700">
            <div class="flex justify-between"><dt>Mon – Fri</dt><dd>12:00 PM – 11:00 PM</dd></div>
            <div class="flex justify-between"><dt>Sat – Sun</dt><dd>12:00 PM – 11:30 PM</dd></div>
          </dl>
          <a
            href={waLink(siteConfig.whatsappMessageTemplates.demoGeneric("Anaar — The Awadhi Table"))}
            target="_blank" rel="noopener"
            class="mt-5 inline-block rounded-full bg-anaar-600 px-5 py-2.5 font-['Lato'] text-sm font-semibold text-white hover:bg-anaar-700"
            data-analytics-event="whatsapp_click" data-demo-slug="anaar-awadhi-table"
          >
            Ask us anything on WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</DemoLayout>
