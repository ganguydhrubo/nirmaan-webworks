---
import DemoLayout from "@/layouts/DemoLayout.astro";
import Header from "./_components/Header.astro";
import Footer from "./_components/Footer.astro";
import { menuCategories } from "@/content/demos/anaar-awadhi-table/menu";

export const prerender = true;
---

<DemoLayout
  demoSlug="anaar-awadhi-table"
  title="Full Menu | Anaar — The Awadhi Table"
  description="Kebabs, dum biryani, Nawabi kormas, breads and desserts — the full Awadhi menu at Anaar, Lucknow."
  fontsHref="/fonts/demos/anaar-awadhi-table/fonts.css"
  themeColor="#6f2224"
>
  <Header />

  <main class="bg-anaar-cream py-12 sm:py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <p class="font-['Lato'] text-xs font-semibold uppercase tracking-[0.25em] text-anaar-600">The Menu</p>
        <h1 class="mt-2 font-['Playfair_Display'] text-3xl font-bold text-anaar-900 sm:text-4xl">Every dish, plated properly</h1>
        <p class="mt-3 font-['Lato'] text-sm text-anaar-700">Prices in ₹. A 5% service charge and applicable GST apply.</p>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Menu categories">
          <button type="button" role="tab" data-menu-tab="all" aria-selected="true" class="rounded-full bg-anaar-600 px-4 py-2 font-['Lato'] text-sm font-medium text-white">All</button>
          {menuCategories.map((cat) => (
            <button type="button" role="tab" data-menu-tab={cat.id} aria-selected="false" class="rounded-full bg-white px-4 py-2 font-['Lato'] text-sm font-medium text-anaar-700 border border-anaar-300/50">
              {cat.label}
            </button>
          ))}
        </div>
        <label class="flex items-center gap-2 font-['Lato'] text-sm text-anaar-700">
          <input type="checkbox" data-veg-only class="h-4 w-4 rounded border-anaar-300 text-anaar-600" />
          Vegetarian only
        </label>
      </div>

      <div class="mt-10 space-y-12">
        {menuCategories.map((cat) => (
          <section data-menu-section={cat.id}>
            <h2 class="border-b border-anaar-gold/40 pb-2 font-['Playfair_Display'] text-xl font-semibold text-anaar-900">{cat.label}</h2>
            <ul class="mt-4 divide-y divide-anaar-300/30">
              {cat.items.map((item) => (
                <li data-menu-item data-veg={String(item.veg)} class="flex items-start justify-between gap-4 py-4">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2">
                      <span class:list={["inline-block h-2.5 w-2.5 shrink-0 rounded-sm border", item.veg ? "border-green-700 bg-green-700" : "border-red-700 bg-red-700"]} aria-hidden="true"></span>
                      <p class="font-['Lato'] font-semibold text-anaar-900">{item.name}</p>
                    </div>
                    <p class="mt-1 text-sm text-anaar-700">{item.description}</p>
                  </div>
                  <p class="shrink-0 font-['Lato'] font-semibold text-anaar-600">₹{item.priceInr}</p>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <div class="mt-16 rounded-lg border border-dashed border-anaar-300 bg-white p-6 text-center">
        <p class="font-['Lato'] text-sm text-anaar-500">
          Order Online (Zomato / Swiggy-style integration) — <strong>demo placeholder, not a real order.</strong> A live site would connect here to your actual ordering platform.
        </p>
        <button type="button" disabled class="mt-3 cursor-not-allowed rounded-full bg-anaar-300 px-6 py-2.5 font-['Lato'] text-sm font-semibold text-anaar-600" aria-disabled="true">
          Order Online
        </button>
      </div>
    </div>
  </main>

  <Footer />

  <script src="../../../scripts/demos/anaar-awadhi-table-menu-filter.ts"></script>
</DemoLayout>
