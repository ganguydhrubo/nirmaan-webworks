---
import ArchDivider from "./ArchDivider.astro";
---

<footer class="bg-anaar-900 pt-2 text-anaar-cream/70">
  <ArchDivider class="h-6 w-full text-anaar-700" />
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 sm:grid-cols-3 lg:px-8">
    <div class="min-w-0">
      <p class="font-['Playfair_Display'] text-lg font-bold text-anaar-cream">Anaar</p>
      <p class="mt-1 text-sm">The Awadhi Table</p>
      <p class="mt-4 text-sm">Lucknow's kitchen, plated properly.</p>
    </div>
    <div class="min-w-0">
      <p class="text-xs font-semibold uppercase tracking-wider text-anaar-gold">Visit</p>
      <p class="mt-2 text-sm">14 Hazratganj Crossing<br />Lucknow, Uttar Pradesh 226001</p>
      <p class="mt-3 text-sm">Open daily, 12:00 PM – 11:00 PM</p>
    </div>
    <div class="min-w-0">
      <p class="text-xs font-semibold uppercase tracking-wider text-anaar-gold">Elsewhere on this demo</p>
      <ul class="mt-2 space-y-1.5 text-sm">
        <li><a href="/demos/anaar-awadhi-table/menu/" class="hover:text-anaar-gold">Full Menu</a></li>
        <li><a href="/demos/anaar-awadhi-table/our-story/" class="hover:text-anaar-gold">Our Story</a></li>
        <li><a href="/demos/anaar-awadhi-table/reservations/" class="hover:text-anaar-gold">Reservations</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-anaar-700 px-4 py-4 text-center text-xs text-anaar-cream/50">
    Anaar — The Awadhi Table is a fictional restaurant built as a demo by atittle.com.
  </div>
</footer>
