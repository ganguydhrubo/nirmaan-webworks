---
import DemoLayout from '@/layouts/DemoLayout.astro';
import Header from './_components/Header.astro';
import Footer from './_components/Footer.astro';
export const prerender = true;
---
<DemoLayout demoSlug="anaar-awadhi-table" title="Plan your evening | Anaar, Lucknow" description="Explore the table reservation experience for Anaar, a fictional Awadhi restaurant in Lucknow. No real bookings are taken." fontsHref="/fonts/demos/anaar-awadhi-table/fonts.css" themeColor="#6f2224">
  <Header active="reservations" />
  <main class="bg-anaar-cream px-5 py-16 font-['Lato'] text-anaar-900">
    <div class="mx-auto grid max-w-5xl gap-12 md:grid-cols-2"><div><p class="text-sm uppercase tracking-widest">An evening at Anaar</p><h1 class="mt-5 font-['Playfair_Display'] text-4xl leading-tight">Come hungry.<br />Stay for the stories.</h1><p class="mt-6 leading-relaxed">A quiet table for two or a long dinner with the family. Plan an evening of slow-cooked Awadhi food.</p><h2 class="mt-10 font-['Playfair_Display'] text-2xl">Before you reserve</h2><ul class="mt-4 list-disc space-y-3 pl-5"><li>Sample dinner service: 7:00–11:00 PM IST.</li><li>For six or more guests, a real restaurant would arrange the table directly.</li><li>Allergies and accessibility requirements should be discussed before confirming a real booking.</li></ul><p class="mt-8 text-sm">Anaar is a fictional restaurant. This form previews a reservation summary on your device; it sends nothing and books no table.</p></div>
    <form data-reservation-form class="flex flex-col gap-5 border border-anaar-300 bg-white p-6 sm:p-8"><h2 class="font-['Playfair_Display'] text-2xl">Plan a table</h2><label class="flex flex-col gap-2">Date<input name="date" type="date" required class="min-w-0 rounded border border-anaar-500 p-3 text-base" /></label><label class="flex flex-col gap-2">Preferred time<select name="time" class="rounded border border-anaar-500 p-3 text-base"><option>7:00 PM</option><option>8:00 PM</option><option>9:00 PM</option></select></label><label class="flex flex-col gap-2">Guests<select name="guests" class="rounded border border-anaar-500 p-3 text-base">{[1,2,3,4,5,6].map(n => <option selected={n===2}>{n}</option>)}</select></label><button type="submit" class="rounded-full bg-anaar-600 px-6 py-3 font-bold text-white">Preview reservation</button><p data-reservation-result role="status" class="text-sm leading-relaxed">No personal details needed for this preview.</p><noscript>This preview needs JavaScript. No real reservations are accepted on the demo.</noscript><a href="/contact?category=Restaurants&demo=anaar-awadhi-table" class="py-3 font-bold underline">Want this for your restaurant?</a></form></div>
  </main><Footer /><script src="../../../scripts/demos/anaar-awadhi-table-reservation.ts"></script>
</DemoLayout>
