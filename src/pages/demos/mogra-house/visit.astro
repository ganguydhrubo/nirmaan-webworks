---
import DemoLayout from '@/layouts/DemoLayout.astro';
import Header from './_components/Header.astro';
import Footer from './_components/Footer.astro';
import {services,categories,inr,enquiry} from '@/content/demos/mogra-house/services';
import {siteConfig} from '@config/site';
import './_components/theme.css';
export const prerender = true;
---
<DemoLayout demoSlug="mogra-house" title="Build your visit — Time & price planner | Mogra House" description="Choose sample hair, colour, skin, body and nail services and see a live total and duration. No appointments are booked." fontsHref="/fonts/demos/mogra-house/fonts.css" themeColor="#f7ede7"><div class="mogra"><Header active="visit"/><main class="mh-wrap"><div class="mh-page-head"><p class="mh-kicker">An afternoon, made by you</p><h1>Leave a little<br/><em>room for yourself.</em></h1><p>Choose your services to see a sample visit. Everything stays on this page. No slot is held, no booking is made and no personal information is needed.</p></div><div class="mh-planner" data-mh-planner><div>{categories.map(c=><fieldset class="mh-select-group"><legend>{c}</legend>{services.filter(s=>s.category===c).map(s=><label class="mh-choice"><input type="checkbox" value={s.id} data-mh-service data-price={s.price} data-minutes={s.minutes} data-name={s.name}/><span>{s.name}<small>{s.minutes} minutes</small></span><span>{inr(s.price)}</span></label>)}</fieldset>)}</div><aside class="mh-summary"><p class="mh-kicker">Your little itinerary</p><h2>A moment<br/><em>in the making.</em></h2><div role="status" aria-live="polite"><ul class="mh-selected-list" data-mh-list></ul><dl><div><dt>Services selected</dt><dd data-mh-count>0</dd></div><div><dt>Sample total, from</dt><dd data-mh-total>₹0</dd></div><div><dt>Service time</dt><dd data-mh-time>0 minutes</dd></div><div><dt>With settling-in time</dt><dd data-mh-visit>—</dd></div></dl><p class="mh-note" data-mh-message>Choose a service to begin your sample visit.</p></div><button type="button" class="mh-clear" data-mh-clear>Clear selection</button><p class="mh-note">Fictional inclusive starting prices. Services are counted sequentially, plus 15 minutes per visit. Colour consultations and product testing may need a separate visit.</p><a class="mh-button" href={enquiry} data-analytics-event="cta_click" data-demo-slug="mogra-house">Enquire about a website ↗</a><p class="mh-note">This opens {siteConfig.businessName}’s real contact form about building a website for your business.</p><noscript><p>The live totals need JavaScript. Individual prices and durations remain visible in the menu.</p></noscript></aside></div></main><Footer/></div><script src="../../../scripts/demos/mogra-house-planner.ts"/></DemoLayout>
