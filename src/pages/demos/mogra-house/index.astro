---
import DemoLayout from '@/layouts/DemoLayout.astro';
import Header from './_components/Header.astro';
import Footer from './_components/Footer.astro';
import Flower from './_components/Flower.astro';
import {rituals,selectedServices,inr} from '@/content/demos/mogra-house/services';
import './_components/theme.css';
export const prerender = true;
---
<DemoLayout demoSlug="mogra-house" title="Mogra House — A little time, entirely yours | Pune" description="An imagined beauty house in Pune. Hair, colour, skin, body and nails, with considered rituals and a clear visit planner." fontsHref="/fonts/demos/mogra-house/fonts.css" themeColor="#d5c4e6"><div class="mogra"><Header/><main>
<section class="mh-hero"><p class="mh-kicker reveal">A fictional beauty house · Pune</p><h1 class="reveal">Come as you are.<br/><em>Leave as yourself.</em></h1><div class="mh-hero-bottom"><div class="reveal"><p>Good hair. A softer pace. A moment that belongs to nobody but you.</p><a class="mh-button" href="/demos/mogra-house/services">Find your little ritual ↗</a></div><Flower id="hero"/><div class="reveal"><p>A little time,<br/>entirely yours.</p><p class="mh-kicker" style="margin-top:25px">HAIR / SKIN / BODY<br/>AND A DEEP BREATH</p></div></div></section>
<section class="mh-wrap mh-section"><div class="mh-intro reveal"><p class="mh-kicker">Make yourself comfortable</p><h2>Some days call for a change.<br/>Some, just a <em>pause.</em></h2><p>Mogra House imagines a gentler kind of beauty appointment: thoughtful choices, clear prices and time to settle in. From an everyday haircut to an afternoon kept completely free.</p></div></section>
<div class="mh-ribbon"><span>Hair that feels like you</span><span aria-hidden="true">✳</span><span>Time without hurry</span><span aria-hidden="true">✳</span><span>Beauty, at your pace</span></div>
<section class="mh-wrap mh-section"><div class="mh-heading reveal"><div><p class="mh-kicker">A few lovely ways to spend an afternoon</p><h2>The house rituals.</h2></div><a class="mh-link" href="/demos/mogra-house/rituals">Meet all three ↗</a></div><div class="mh-ritual-grid">{rituals.map(r=><article class="mh-ritual reveal" style={`background:${r.colour}`}><Flower id={r.slug} colour={r.colour}/><p class="mh-kicker">{r.line}</p><h3><a href={`/demos/mogra-house/rituals/${r.slug}`}>{r.name}</a></h3><p>From {inr(selectedServices(r.serviceIds).reduce((sum,s)=>sum+s.price,0))} · {selectedServices(r.serviceIds).reduce((sum,s)=>sum+s.minutes,0)} minutes</p><a class="mh-link" href={`/demos/mogra-house/rituals/${r.slug}`}>Take a closer look ↗</a></article>)}</div><p class="mh-note" style="margin-top:25px">Fictional service combinations and inclusive sample prices. Durations exclude settling-in time.</p></section>
<section class="mh-plum mh-section"><div class="mh-wrap mh-house-grid"><div class="mh-house-art reveal"><Flower id="house" colour="#f7ede7"/></div><div class="reveal"><p class="mh-kicker">The mood of the house</p><h2>Less rush.<br/>More <em>room to be.</em></h2><p>A warm welcome, a proper conversation and permission to ask for a quiet appointment. Our imagined house is shaped around comfort, not a checklist of things to change about yourself.</p><a class="mh-link" href="/demos/mogra-house/house">Step inside the idea ↗</a></div></div></section>
<section class="mh-wrap mh-section mh-intro reveal"><p class="mh-kicker">A little planning, a lot more ease</p><h2>What does your<br/><em>afternoon look like?</em></h2><p>Choose a few services. See the sample time and total. Leave the rest of the day a little more open.</p><a class="mh-button" href="/demos/mogra-house/visit">Build your visit ↗</a></section>
</main><Footer/></div></DemoLayout>
