---
import StudioShell from '@/components/demos/StudioShell.astro';
import {Image} from 'astro:assets';
import car from '@/assets/demos/expansion/car-hero.jpg';
import {inspection,services} from '@/content/demos/torque-district/inspection';
import './theme.css';
export const prerender=true;
---
<StudioShell slug="torque-district" title="Torque District — Good machines. No guesswork." description="A Pune performance showroom and workshop concept with an interactive inspection explorer, sample specs and service planner." theme="#121719" fonts="/fonts/demos/aangan-form/fonts.css" links={[{href:'#machine',label:'The machine'},{href:'#inspection',label:'The inspection'},{href:'#workshop',label:'The workshop'}]}>
<span slot="wordmark">TORQUE<span>DISTRICT / PUNE</span></span><span slot="nav-cta">Start your enquiry ↗</span>
<section class="td-hero"><div class="td-hero-heading sd-wrap"><p class="sd-eyebrow">Independent motoring / Fictional showroom</p><h1><span class="sd-hero-line">DRIVEN BY</span><span class="sd-hero-line"><i>THE DETAILS.</i></span></h1><p>Good machines. No guesswork.<br/>For the road ahead, and everything beneath it.</p></div><div class="td-hero-image"><Image src={car} alt="Rear three-quarter view of a black sports car; illustrative photograph, not showroom inventory" widths={[480,800,1280,1600]} sizes="100vw" width={1600} loading="eager" fetchpriority="high" class="sd-hero-photo"/></div><div class="td-hero-bottom sd-wrap"><span>FEATURE STUDY / THE GRAND TOURER</span><a href="#inspection">Look a little closer <span aria-hidden="true">↓</span></a><span>01 / 03</span></div></section>
<section id="machine" class="sd-wrap sd-section td-machine"><div><p class="sd-eyebrow">01 / A machine, understood</p><h2>DESIRE MEETS<br/><span>THE DETAILS.</span></h2><p>Shape catches the eye. Clear information earns the next conversation. Explore a sample vehicle brief before opening the inspection.</p></div><div><p class="td-spec-note">FICTIONAL INVENTORY STUDY — ALL VALUES ILLUSTRATIVE</p><dl class="td-specs">{[['Vehicle class','Grand tourer'],['Model year','2021'],['Odometer','24,000 km'],['Transmission','Automatic'],['Fuel','Petrol'],['Ownership','Single owner'],['Sample asking price','₹48.5 lakh'],['Price excludes','Transfer, insurance & taxes']].map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><p class="sd-note">The photograph is illustrative and is not linked to these sample specifications or a vehicle for sale. No manufacturer affiliation is implied.</p></div></section>
<section id="inspection" class="td-inspection sd-wrap sd-section"><div class="sd-section-head"><div><p class="sd-eyebrow">02 / Know what you’re looking at</p><h2>NOTHING TO HIDE.<br/><span>PLENTY TO EXPLORE.</span></h2></div><p>Select a checkpoint. See what a useful inspection conversation could cover.</p></div><fieldset class="td-inspection-options"><legend>Explore inspection checkpoints</legend>{inspection.map((p,i)=><label><input type="radio" name="inspection" id={`td-${p.id}`} value={p.id} checked={i===0}/><span>{p.number} / {p.id==='body'?'Body & finish':p.id==='mechanical'?'Mechanical':'Cabin & controls'}</span></label>)}</fieldset><div class="td-inspection-grid"><div class="td-inspection-image"><Image src={car} alt="Illustrative sports car for the inspection walkthrough" widths={[480,800,1200]} sizes="(max-width:760px) 100vw, 55vw" width={1200} loading="lazy"/><div class="td-hotspots" aria-hidden="true"><span class="td-hotspot td-body">01</span><span class="td-hotspot td-mechanical">02</span><span class="td-hotspot td-cabin">03</span></div><span class="td-image-caption">ILLUSTRATIVE PHOTOGRAPH / CHECKPOINT LOCATIONS APPROXIMATE</span></div><div class="td-inspection-panels">{inspection.map(p=><article data-inspection={p.id}><span class="td-panel-number">{p.number}</span><h3>{p.title}</h3><p>{p.description}</p><ul>{p.checks.map(c=><li>{c}</li>)}</ul><p class="sd-note">Example checklist, not a completed inspection or condition guarantee.</p></article>)}</div></div></section>
<section class="td-process sd-wrap sd-section"><div><p class="sd-eyebrow">03 / From curiosity to confidence</p><h2>A CLEAR ROAD<br/><span>TO YOUR NEXT CAR.</span></h2></div><div>{[['01','READ THE RECORD.','Review the listed condition, service history, ownership documents and any exclusions before arranging a visit.'],['02','SEE IT FOR YOURSELF.','Agree a viewing and an independent inspection where appropriate. A photograph cannot replace checking a vehicle in person.'],['03','AGREE THE DETAILS.','Confirm the final price, transfer process, payment terms and delivery arrangements in writing.']].map(([n,title,body])=><article class="sd-story-step"><span>{n}</span><h3>{title}</h3><p>{body}</p></article>)}</div></section>
<section id="workshop" class="td-workshop sd-wrap sd-section"><div class="sd-section-head"><div><p class="sd-eyebrow">04 / The workshop</p><h2>KEEP THE GOOD<br/><span>THINGS RUNNING.</span></h2></div><p>Build a sample service brief. These are illustrative all-inclusive assessment prices; parts and repairs are separate.</p></div><div class="td-service-layout"><div>{services.map(s=><article class="td-service"><div><h3>{s.title}</h3><p>{s.scope}</p></div><div><b>₹{s.price.toLocaleString('en-IN')}</b><label hidden data-service-control><input type="checkbox" value={s.id} data-service-price={s.price}/> Add to brief</label></div></article>)}</div><aside data-service-summary hidden><p class="sd-eyebrow">Your service brief</p><p class="td-total" data-service-total aria-live="polite">₹0</p><p data-service-count>No services selected</p><p class="sd-note">Sample estimate only. No service slot is booked.</p><a class="sd-button" href="#visit">Discuss a workshop website ↗</a></aside></div></section>
<span slot="closing">GOOD MACHINES.<br/><span>BETTER QUESTIONS.</span></span>
</StudioShell>
<script>
const boxes=[...document.querySelectorAll<HTMLInputElement>('[data-service-price]')];const total=document.querySelector('[data-service-total]');
if(total){const update=()=>{const selected=boxes.filter(b=>b.checked);total.textContent=`₹${selected.reduce((sum,b)=>sum+Number(b.dataset.servicePrice),0).toLocaleString('en-IN')}`;document.querySelector('[data-service-count]')!.textContent=selected.length?`${selected.length} service${selected.length===1?'':'s'} in your sample brief`:'No services selected';};boxes.forEach(b=>b.addEventListener('change',update));document.querySelectorAll<HTMLElement>('[data-service-control]').forEach(c=>c.hidden=false);document.querySelector<HTMLElement>('[data-service-summary]')!.hidden=false;}
</script>
