---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DemoShowcase from "@/components/ui/DemoShowcase.astro";
import DemoDirectory from "@/components/ui/DemoDirectory.astro";
import { siteConfig } from "@config/site";
import { breadcrumbJsonLd } from "@/lib/seo";
export const prerender = true;

const jsonLd = [
  breadcrumbJsonLd([
    { name: "Home", url: siteConfig.siteUrl },
    { name: "Demo Websites", url: `${siteConfig.siteUrl}/demos` },
  ]),
];
---
<BaseLayout title="Live Demo Websites by Industry | ATITTLE" description={`${siteConfig.demoRegistry.length} full, working demo websites — one for each industry we build for. Every page, filter and form actually works.`} jsonLd={jsonLd}>
  <section class="bg-cream pb-16 pt-8 sm:pb-20 sm:pt-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-8 max-w-4xl sm:mb-8">
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-brand-600">The ATITTLE collection / {siteConfig.demoRegistry.length} live websites</p>
        <h1 class="font-display text-3xl font-semibold text-ink-950 sm:text-4xl">See the work, not a pitch</h1>
        <p class="mt-4 text-base text-ink-700">{siteConfig.demoRegistry.length} full demo websites, one per industry. Click through — every page, filter and form actually works.</p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <button
            type="button"
            class="inline-flex items-center gap-2.5 rounded-full bg-ink-950 px-5 py-2.5 text-sm font-semibold text-cream shadow-md transition duration-200 hover:bg-brand-600 cursor-pointer"
            data-open-theatre=""
            data-magnetic
          >
            <span class="relative flex h-2.5 w-2.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-400 opacity-75"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-brand-500"></span>
            </span>
            <span>Launch 3D Cinematic Theatre</span>
            <span aria-hidden="true">🎬</span>
          </button>
        </div>
      </div>
      <DemoShowcase id="demo-showcase" eager />
      <p class="mt-5 text-xs text-ink-500">These are demonstration sites built for fictional businesses, not real clients.</p>
      <div class="mt-10"><DemoDirectory /></div>
    </div>
  </section>
</BaseLayout>
