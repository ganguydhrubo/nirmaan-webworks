---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import { siteConfig } from "@config/site";

export const prerender = true;

const demoByIndustry = Object.fromEntries(siteConfig.demoRegistry.map((d) => [d.industrySlug, d]));
---

<BaseLayout title="Live demo websites" description={`${siteConfig.demoRegistry.length} full, working demo websites — one for each industry we build for. Every page, filter and form actually works.`}>
  <section class="bg-cream py-14 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="font-display text-3xl font-semibold text-ink-950 sm:text-4xl">See the work, not a pitch</h1>
      <p class="mt-4 text-lg text-ink-700">{siteConfig.demoRegistry.length} full demo websites, one per industry. Click through — every page, filter and form actually works.</p>
      <p class="mt-2 text-sm text-ink-500">These are demonstration sites built for fictional businesses, not real clients.</p>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {siteConfig.industryRegistry.map((industry) => {
          const demo = demoByIndustry[industry.slug];
          return (
            <a href={`/demos/${demo?.slug}`} class="group min-w-0 overflow-hidden rounded-xl border border-ink-200 bg-cream transition hover:border-brand-500">
              <div class="aspect-[4/3] overflow-hidden bg-ink-100">
                <img
                  src={`/images/demos/${demo?.slug}/card.jpg`}
                  alt={`Homepage preview of the ${demo?.businessName} demo, a ${industry.shortName.toLowerCase()} website`}
                  width="480" height="360" loading="lazy" decoding="async"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />
              </div>
              <div class="p-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">{industry.shortName}</p>
                <h2 class="mt-1 font-display text-lg font-semibold text-ink-950">{demo?.businessName}</h2>
                <p class="mt-1 text-sm text-ink-500">{demo?.tagline} — {demo?.city}</p>
                <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-brand-600">
                  Open live demo <Icon name="chevron-right" class="h-4 w-4" />
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
