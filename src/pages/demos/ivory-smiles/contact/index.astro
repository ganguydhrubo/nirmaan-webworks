---
import DemoLayout from "@/layouts/DemoLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import Header from "../_components/Header.astro";
import Footer from "../_components/Footer.astro";
import { siteConfig } from "@config/site";
import { waLink } from "@/lib/contact-links";

export const prerender = true;

const waMessage = siteConfig.whatsappMessageTemplates.demoGeneric("Ivory Smiles Dental Clinic");
---

<DemoLayout
  demoSlug="ivory-smiles"
  title="Book an Appointment — Ivory Smiles Dental Clinic"
  description="Book an appointment at Ivory Smiles Dental Clinic, Indore — location, hours and contact details."
  fontsHref="/fonts/demos/ivory-smiles/fonts.css"
  themeColor="#147d63"
>
  <div class="min-h-screen bg-ivory-50 font-['Mulish'] text-ivory-ink">
    <Header active="contact" />

    <section class="bg-white py-14 sm:py-16">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
        <h1 class="font-['Sora'] text-3xl font-bold text-ivory-ink sm:text-4xl">Book an appointment</h1>
        <p class="mt-3 text-ivory-ink/70">This is a demo site, so there's no live booking system here — every action below routes to the real atittle.com enquiry flow.</p>
      </div>
    </section>

    <section class="bg-ivory-50 py-14 sm:py-16">
      <div class="mx-auto grid max-w-4xl gap-8 px-4 sm:grid-cols-2 sm:px-6">
        <div class="min-w-0 rounded-2xl border border-ivory-100 bg-white p-6">
          <h2 class="font-['Sora'] text-lg font-bold text-ivory-ink">Clinic details</h2>
          <p class="mt-4 flex items-start gap-2 text-sm text-ivory-ink/70"><Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-ivory-500" /> 14 Race Course Road, Indore, Madhya Pradesh 452001</p>
          <p class="mt-3 flex items-start gap-2 text-sm text-ivory-ink/70"><Icon name="clock" class="mt-0.5 h-4 w-4 shrink-0 text-ivory-500" /> Mon–Sat: 9:30 AM–1:30 PM &amp; 4:30 PM–8:30 PM<br />Sunday: by appointment only</p>
          <p class="mt-3 flex items-start gap-2 text-sm text-ivory-ink/70"><Icon name="phone" class="mt-0.5 h-4 w-4 shrink-0 text-ivory-500" /> Demo clinic line — use the buttons on this page to reach atittle.com</p>
        </div>
        <div class="min-w-0 rounded-2xl border border-ivory-100 bg-white p-6 text-center">
          <h2 class="font-['Sora'] text-lg font-bold text-ivory-ink">Ready to book?</h2>
          <p class="mt-2 text-sm text-ivory-ink/70">Choose whichever's easiest for you.</p>
          <div class="mt-5 flex flex-col gap-3">
            <a href={waLink(waMessage)} target="_blank" rel="noopener" aria-label="WhatsApp us (opens WhatsApp)" class="inline-flex items-center justify-center gap-2 rounded-full bg-[#25D366] px-5 py-3 font-bold text-ink-950 hover:opacity-90" data-analytics-event="whatsapp_click" data-demo-slug="ivory-smiles">
              <Icon name="whatsapp" class="h-5 w-5" /> WhatsApp us
            </a>
            <a href={`/contact?category=Dental%20Clinics&demo=ivory-smiles`} class="inline-flex items-center justify-center gap-2 rounded-full bg-ivory-coral px-5 py-3 font-bold text-white hover:opacity-90" data-analytics-event="cta_click" data-demo-slug="ivory-smiles">
              <Icon name="calendar" class="h-5 w-5" /> Get a website like this
            </a>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</DemoLayout>
