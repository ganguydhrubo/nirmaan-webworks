---
import Icon from "@/components/ui/Icon.astro";

interface Props {
  active?: "home" | "treatments" | "dentist" | "contact";
}
const { active } = Astro.props;

const nav = [
  { href: "/demos/ivory-smiles/", label: "Home", key: "home" },
  { href: "/demos/ivory-smiles/treatments/", label: "Treatments", key: "treatments" },
  { href: "/demos/ivory-smiles/dentist/", label: "Our Dentists", key: "dentist" },
  { href: "/demos/ivory-smiles/contact/", label: "Contact", key: "contact" },
];
---

<header class="border-b border-ivory-100 bg-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href="/demos/ivory-smiles/" class="flex items-center gap-2.5">
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-ivory-500 text-white">
        <Icon name="tooth" class="h-5 w-5" />
      </span>
      <span class="font-['Sora'] text-lg font-bold text-ivory-ink">Ivory Smiles</span>
    </a>
    <nav aria-label="Primary" class="hidden gap-1 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={active === item.key ? "page" : undefined}
          class:list={["rounded-md px-3 py-2 text-sm font-semibold text-ivory-ink/80 hover:bg-ivory-50 hover:text-ivory-700", active === item.key && "bg-ivory-50 text-ivory-700"]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <a
      href="/demos/ivory-smiles/contact/"
      class="inline-flex items-center gap-1.5 rounded-full bg-ivory-coral px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:opacity-90"
    >
      <Icon name="calendar" class="h-4 w-4" /> Book Visit
    </a>
  </div>
  <nav aria-label="Primary mobile" class="flex gap-1 overflow-x-auto border-t border-ivory-100 px-4 py-2 md:hidden">
    {nav.map((item) => (
      <a
        href={item.href}
        aria-current={active === item.key ? "page" : undefined}
        class:list={["shrink-0 rounded-full px-3 py-1.5 text-xs font-semibold text-ivory-ink/70", active === item.key ? "bg-ivory-500 text-white" : "bg-ivory-50"]}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>
