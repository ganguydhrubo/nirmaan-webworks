---
import DemoLayout from "@/layouts/DemoLayout.astro";
import Icon from "@/components/ui/Icon.astro";
import Header from "../_components/Header.astro";
import Footer from "../_components/Footer.astro";

export const prerender = true;

const dentists = [
  {
    name: "Dr. Ananya Rathi",
    qualifications: "BDS, MDS (Prosthodontics)",
    experience: "11 years",
    focus: "Smile makeovers, crowns & bridges, dental implants",
    hours: "Mon, Wed, Fri: 9:30 AM–1:30 PM · Tue, Thu, Sat: 4:30 PM–8:30 PM",
  },
  {
    name: "Dr. Kunal Bhalerao",
    qualifications: "BDS, MDS (Orthodontics)",
    experience: "8 years",
    focus: "Braces & clear aligners for teens and adults",
    hours: "Tue, Thu, Sat: 9:30 AM–1:30 PM · Mon, Wed, Fri: 4:30 PM–8:30 PM",
  },
];

const galleryLabels = ["Reception & waiting area", "Consultation room", "Treatment room 1", "Sterilisation area", "Treatment room 2", "Digital X-ray room"];
---

<DemoLayout
  demoSlug="ivory-smiles"
  title="Our Dentists — Ivory Smiles Dental Clinic"
  description="Meet the dentists at Ivory Smiles Dental Clinic, Indore — qualifications, focus areas and consulting hours."
  fontsHref="/fonts/demos/ivory-smiles/fonts.css"
  themeColor="#147d63"
>
  <div class="min-h-screen bg-ivory-50 font-['Mulish'] text-ivory-ink">
    <Header active="dentist" />

    <section class="bg-white py-14 sm:py-16">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
        <h1 class="font-['Sora'] text-3xl font-bold text-ivory-ink sm:text-4xl">Meet the dentists</h1>
        <p class="mt-3 text-ivory-ink/70">Two dentists, two specialisations, one calm clinic.</p>
      </div>
    </section>

    <section class="bg-ivory-50 py-14 sm:py-16">
      <div class="mx-auto grid max-w-4xl gap-8 px-4 sm:grid-cols-2 sm:px-6">
        {dentists.map((d) => (
          <div class="min-w-0 rounded-2xl border border-ivory-100 bg-white p-6 text-center">
            <div class="mx-auto flex h-24 w-24 items-center justify-center rounded-full bg-ivory-500 text-white">
              <Icon name="tooth" class="h-10 w-10" />
            </div>
            <h2 class="mt-4 font-['Sora'] text-lg font-bold text-ivory-ink">{d.name}</h2>
            <p class="text-sm font-semibold text-ivory-700">{d.qualifications}</p>
            <p class="mt-1 text-xs text-ivory-ink/80">{d.experience} of practice</p>
            <p class="mt-3 text-sm text-ivory-ink/80">{d.focus}</p>
            <p class="mt-4 flex items-start justify-center gap-1.5 text-xs text-ivory-ink/80"><Icon name="clock" class="mt-0.5 h-3.5 w-3.5 shrink-0" /> {d.hours}</p>
          </div>
        ))}
      </div>
      <p class="mx-auto mt-6 max-w-4xl px-4 text-center text-xs text-ivory-ink/75 sm:px-6">Dentist avatars are illustrative — this is a demonstration site, not a real clinic.</p>
    </section>

    <section class="bg-white py-14 sm:py-16">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <h2 class="text-center font-['Sora'] text-2xl font-bold text-ivory-ink">Take a look around</h2>
        <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3">
          {galleryLabels.map((label, i) => (
            <div class:list={["flex aspect-square min-w-0 items-center justify-center rounded-2xl p-4 text-center text-sm font-semibold", i % 2 === 0 ? "bg-ivory-100 text-ivory-700" : "bg-ivory-500/10 text-ivory-600"]}>
              {label}
            </div>
          ))}
        </div>
      </div>
    </section>

    <Footer />
  </div>
</DemoLayout>
