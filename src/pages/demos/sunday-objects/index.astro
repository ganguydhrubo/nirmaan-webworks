---
import StudioShell from '@/components/demos/StudioShell.astro';
import {Image} from 'astro:assets';
import form from '@/assets/demos/expansion/ceramics-01.jpg';
import shell from '@/assets/demos/expansion/ceramics-02.jpg';
import texture from '@/assets/demos/expansion/ceramics-03.jpg';
import {products} from '@/content/demos/sunday-objects/products';
import './theme.css';
export const prerender=true;
const images={form,shell,texture};
---
<StudioShell slug="sunday-objects" title="Sunday Objects — Everyday things, a little less ordinary" description="A playful Kochi homewares boutique concept. Browse tactile ceramics, filter the edit and explore product quick views." theme="#efeee5" fonts="/fonts/demos/aangan-form/display.css" links={[{href:'#collection',label:'The objects'},{href:'#perspective',label:'Our point of view'},{href:'#visit',label:'Say hello'}]} ctaHref="#collection">
<span slot="wordmark">sunday<span class="so-wordmark-bottom">objects</span></span><span slot="nav-cta">Explore the edit ↗</span>
<section class="so-hero"><div class="so-hero-copy"><p class="sd-eyebrow">Good things for everyday living / Kochi</p><h1><span class="sd-hero-line">Life’s little</span><span class="sd-hero-line"><em>keep-forevers.</em></span></h1><p>Objects with a point of view.<br/>For the corners that make a home yours.</p><a class="sd-button" href="#collection">Meet your next favourite <span aria-hidden="true">↗</span></a><span class="so-hero-number">THE EVERYDAY EDIT — 01</span></div><div class="so-hero-image"><Image src={form} alt="Sculptural ceramic vase with a green branch on linen; illustrative product photography" widths={[480,800,1200]} sizes="(max-width:760px) 100vw, 50vw" width={1200} loading="eager" fetchpriority="high" class="sd-hero-photo"/><span class="so-seal">A LITTLE<br/>LESS<br/>ORDINARY.</span><a href="#product-soft-form" class="so-hero-product"><span>The soft form vase<br/><small>Illustrative piece / ₹1,800</small></span><span aria-hidden="true">↗</span></a></div></section>
<div class="so-ticker"><span>KEEP WHAT YOU LOVE.</span><span>USE IT EVERY DAY.</span><span>MAKE ROOM FOR A LITTLE JOY.</span></div>
<section class="sd-wrap sd-section" id="collection" data-products><div class="sd-section-head"><div><p class="sd-eyebrow">The everyday edit</p><h2>A few good things.</h2></div><p>A small catalogue of imagined homewares. Sample prices and specifications; photographs illustrate the mood and form.</p></div><div class="sd-filters" data-product-controls hidden aria-label="Product categories">{['All','Sculptural','Botanical'].map((f,i)=><button type="button" data-product-filter={f} aria-pressed={i===0?'true':'false'}>{f==='All'?'Everything':f}</button>)}</div><p class="sd-status" data-product-count aria-live="polite">3 objects in the edit</p><div class="so-products">{products.map((p,i)=><article id={`product-${p.id}`} data-product-card data-category={p.category}><div class="so-product-image"><Image src={images[p.image]} alt={`${p.name}; illustrative product photograph`} widths={[400,640,960]} sizes="(max-width:760px) 100vw, 30vw" width={960} loading="lazy"/><span class="so-product-index">0{i+1}</span><button type="button" hidden data-quick-view={p.id} aria-label={`Quick view ${p.name}`}>Take a closer look ↗</button></div><div class="so-product-title"><h3>{p.name}</h3><p>₹{p.price.toLocaleString('en-IN')}</p></div><p class="sd-note">{p.material}</p><details class="sd-detail" data-product-details><summary>Details & care</summary><div data-product-copy><p>{p.description}</p><p class="sd-note">{p.size}</p><h4>Care for your object</h4><p>{p.care}</p><a class="sd-button" href={`/contact?category=Retail%20%26%20Boutiques&demo=sunday-objects&message=${encodeURIComponent('I would like a catalogue website with product enquiries, like '+p.name+'.')}`}>Ask about this catalogue concept ↗</a><p class="sd-note">Demonstration catalogue. No products are for sale.</p></div></details></article>)}</div></section>
<dialog class="so-quick-view sd-dialog" data-product-dialog aria-labelledby="quick-view-title"><form method="dialog"><button class="sd-dialog-close">Close ×</button></form><div class="so-quick-grid"><div data-quick-image></div><div><p class="sd-eyebrow">A closer look / The everyday edit</p><h2 id="quick-view-title"></h2><p data-quick-price></p><div data-quick-copy></div></div></div></dialog>
<section class="so-perspective" id="perspective"><div class="so-perspective-image"><Image src={texture} alt="A textured ceramic vessel beside driftwood on linen" widths={[480,800,1200]} sizes="(max-width:760px) 100vw, 50vw" width={1200} loading="lazy" class="sd-scroll-image"/></div><div class="so-perspective-copy"><p class="sd-eyebrow">A point of view, not a perfect room</p><h2>A home takes<br/>shape <em>slowly.</em></h2><p>One useful object. One lovely oddity. One thing you brought home just because it made you smile.</p><p>Sunday Objects is an imagined neighbourhood shop for that kind of collecting. A small edit, chosen with care.</p></div></section>
<section class="sd-wrap sd-section so-story"><div><p class="sd-eyebrow">From a glance to a favourite</p><h2>LESS SCROLLING.<br/>MORE <em>FEELING.</em></h2></div><div>{[['01','Notice the shape.','A silhouette should earn its place. See the object on its own, then imagine it among the things you already live with.'],['02','Get to know it.','Size, finish, material and care should be as easy to find as the price. A considered purchase starts with clear information.'],['03','Make it personal.','Ask about a piece by name. In a real shop, availability, pickup and delivery would be confirmed in that conversation.']].map(([n,title,body])=><article class="sd-story-step"><span class="sd-eyebrow">{n}</span><h3>{title}</h3><p>{body}</p></article>)}</div></section>
<section class="so-faq sd-wrap"><details class="sd-detail"><summary>Can I buy these objects?</summary><p>This is a fictional catalogue showing how a local boutique could present products and receive enquiries. The objects, sample prices and dimensions are not a live retail offer.</p></details><details class="sd-detail"><summary>What would an enquiry-led catalogue include?</summary><p>Real product photography, current specifications, availability and clear collection or delivery details supplied by the shop. A named-product enquiry makes the first conversation easier.</p></details></section>
<span slot="closing">Something good<br/>starts with <em>hello.</em></span>
</StudioShell>
<script>
const catalogue=document.querySelector<HTMLElement>('[data-products]');const dialog=document.querySelector<HTMLDialogElement>('[data-product-dialog]');
if(catalogue){const cards=[...catalogue.querySelectorAll<HTMLElement>('[data-product-card]')];const filters=[...catalogue.querySelectorAll<HTMLButtonElement>('[data-product-filter]')];filters.forEach(button=>button.addEventListener('click',()=>{let count=0;cards.forEach(card=>{card.hidden=button.dataset.productFilter!=='All'&&card.dataset.category!==button.dataset.productFilter;if(!card.hidden)count++;});filters.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));catalogue.querySelector('[data-product-count]')!.textContent=`${count} object${count===1?'':'s'} in the edit`;}));catalogue.querySelector<HTMLElement>('[data-product-controls]')!.hidden=false;
if(dialog&&typeof dialog.showModal==='function'){let opener:HTMLButtonElement|undefined;catalogue.querySelectorAll<HTMLButtonElement>('[data-quick-view]').forEach(button=>{button.hidden=false;button.addEventListener('click',()=>{const card=button.closest('article')!;opener=button;dialog.querySelector('#quick-view-title')!.textContent=card.querySelector('h3')!.textContent;dialog.querySelector('[data-quick-price]')!.textContent=card.querySelector('.so-product-title p')!.textContent;const photo=card.querySelector('img')!.cloneNode(true) as HTMLImageElement;photo.sizes='(max-width:760px) 90vw, 40vw';dialog.querySelector('[data-quick-image]')!.replaceChildren(photo);dialog.querySelector('[data-quick-copy]')!.replaceChildren(card.querySelector('[data-product-copy]')!.cloneNode(true));dialog.showModal();});});dialog.addEventListener('close',()=>opener?.focus());}}
</script>
