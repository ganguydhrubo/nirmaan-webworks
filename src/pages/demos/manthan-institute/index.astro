---
import DemoPhoto from "@/components/ui/DemoPhoto.astro";
import DemoLayout from "@/layouts/DemoLayout.astro";
import SiteHeader from "./_shared/SiteHeader.astro";
import SiteFooter from "./_shared/SiteFooter.astro";
import Icon from "@/components/ui/Icon.astro";
import { courses } from "@/content/demos/manthan-institute/courses";
import { faculty } from "@/content/demos/manthan-institute/faculty";
import { waLink } from "@/lib/contact-links";
import { siteConfig } from "@config/site";

export const prerender = true;

const featuredCourses = courses.slice(0, 4);

const trustPoints = [
  { icon: "shield" as const, title: "Batch size capped at 40", body: "Small enough that faculty know every student by name, not roll number." },
  { icon: "clock" as const, title: "Sunday test & doubt day, every week", body: "Not an occasional mock test — a fixed weekly rhythm from day one." },
  { icon: "star" as const, title: "Faculty who only teach one subject", body: "Depth over breadth — every teacher has taught their subject for a decade or more." },
];
---

<DemoLayout
  demoSlug="manthan-institute"
  title="Manthan Institute of Competitive Studies — JEE & NEET Coaching, Kota"
  description="JEE and NEET coaching in Kota, Rajasthan with capped batch sizes, weekly test series and subject-specialist faculty. Two-year foundation and one-year target batches."
  fontsHref="/fonts/demos/manthan-institute/fonts.css"
  themeColor="#232a51"
>
  <div class="bg-white font-['Nunito'] text-manthan-900">
    <SiteHeader />

    <section class="border-b border-manthan-100 bg-manthan-50">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 md:items-center md:py-20 lg:px-8">
        <div class="min-w-0">
          <p class="mb-3 inline-flex items-center gap-2 rounded-full bg-manthan-900 px-3.5 py-1.5 text-sm font-semibold text-manthan-gold">
            <Icon name="map-pin" class="h-4 w-4" /> Talwandi, Kota, Rajasthan
          </p>
          <h1 class="font-['Domine'] text-4xl font-bold leading-[1.1] text-manthan-900 sm:text-5xl">Discipline, then results.</h1>
          <p class="mt-5 max-w-lg text-lg text-manthan-700">
            Two-year JEE and NEET foundation batches, one-year target batches, and a Class 9–10 foundation course — taught by faculty who specialise in one subject each, in batches capped at 40 students.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/demos/manthan-institute/courses" class="inline-flex items-center justify-center gap-2 rounded-md bg-manthan-600 px-6 py-3.5 font-bold text-white hover:bg-manthan-700">
              See all courses <Icon name="chevron-right" class="h-4 w-4" />
            </a>
            <a href="/demos/manthan-institute/admissions" class="inline-flex items-center justify-center gap-2 rounded-md border-2 border-manthan-600 px-6 py-3.5 font-bold text-manthan-700 hover:bg-manthan-100">
              Admission process & fees
            </a>
          </div>
        </div>
        <div class="min-w-0 rounded-2xl bg-manthan-900 p-8 text-manthan-100 shadow-xl">
          <p class="font-['Domine'] text-xl font-bold text-white">This week at Manthan</p>
          <ul class="mt-5 space-y-4 text-sm">
            <li class="flex items-start gap-3"><Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-manthan-gold" /> Weekly topic test — Physics (Rotational Motion), Sunday 9 AM</li>
            <li class="flex items-start gap-3"><Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-manthan-gold" /> Doubt-clearing — Organic Chemistry, Thursday 5 PM</li>
            <li class="flex items-start gap-3"><Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-manthan-gold" /> Parent progress calls — last Saturday of every month</li>
          </ul>
          <p class="mt-6 border-t border-manthan-700 pt-4 text-xs text-manthan-400">Illustrative weekly schedule — actual dates vary by batch.</p>
        </div>
      </div>
    </section>
    <DemoPhoto name="manthan" />

    <section class="py-14 sm:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-6 sm:grid-cols-3">
          {trustPoints.map((p) => (
            <div class="reveal min-w-0 rounded-xl border border-manthan-100 p-6">
              <div class="mb-3 inline-flex h-11 w-11 items-center justify-center rounded-lg bg-manthan-50 text-manthan-600">
                <Icon name={p.icon} class="h-5 w-5" />
              </div>
              <h3 class="font-['Domine'] font-bold text-manthan-900">{p.title}</h3>
              <p class="mt-1.5 text-sm text-manthan-600">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-manthan-50 py-14 sm:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="font-['Domine'] text-2xl font-bold text-manthan-900 sm:text-3xl">Courses</h2>
          <a href="/demos/manthan-institute/courses" class="text-sm font-bold text-manthan-700 hover:text-manthan-900">View all courses →</a>
        </div>
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {featuredCourses.map((c) => (
            <div class="reveal min-w-0 rounded-xl border border-manthan-100 bg-white p-6">
              <p class="text-xs font-bold uppercase tracking-wide text-manthan-500">{c.exam} · {c.durationLabel}</p>
              <h3 class="mt-1 font-['Domine'] text-lg font-bold text-manthan-900">{c.name}</h3>
              <p class="mt-1 text-sm text-manthan-600">{c.eligibility}</p>
              <p class="mt-3 font-['Domine'] text-xl font-bold text-manthan-900">₹{c.feeInr.toLocaleString("en-IN")}</p>
              <p class="text-xs text-manthan-500">{c.feeNote}</p>
              <a href="/demos/manthan-institute/courses" class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-manthan-600 hover:text-manthan-800">
                Details <Icon name="chevron-right" class="h-4 w-4" />
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-14 sm:py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <h2 class="font-['Domine'] text-2xl font-bold text-manthan-900 sm:text-3xl">Faculty</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {faculty.slice(0, 3).map((f) => (
            <div class="reveal min-w-0 rounded-xl border border-manthan-100 p-6 text-center">
              <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-manthan-600 font-['Domine'] text-lg font-bold text-white">{f.initials}</span>
              <h3 class="mt-3 font-['Domine'] font-bold text-manthan-900">{f.name}</h3>
              <p class="text-sm font-semibold text-manthan-500">{f.subject}</p>
              <p class="mt-2 text-xs text-manthan-600">{f.qualification} · {f.experienceYears} yrs</p>
            </div>
          ))}
        </div>
        <p class="mt-6 text-center">
          <a href="/demos/manthan-institute/faculty" class="text-sm font-bold text-manthan-700 hover:text-manthan-900">Meet the full faculty →</a>
        </p>
      </div>
    </section>

    <section class="bg-manthan-900 py-14 text-center sm:py-20">
      <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
        <h2 class="font-['Domine'] text-2xl font-bold text-white sm:text-3xl">Ready to talk about admission?</h2>
        <p class="mt-3 text-manthan-300">Tell us the exam and class — we'll recommend the right batch.</p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
          <a href={waLink(siteConfig.whatsappMessageTemplates.demoGeneric("Manthan Institute"))} target="_blank" rel="noopener" aria-label="Chat on WhatsApp (opens WhatsApp)" class="inline-flex items-center justify-center gap-2 rounded-md bg-[#25D366] px-6 py-3.5 font-bold text-ink-950 hover:opacity-90" data-analytics-event="whatsapp_click" data-demo-slug="manthan-institute">
            <Icon name="whatsapp" class="h-5 w-5" /> Chat on WhatsApp
          </a>
          <a href="/demos/manthan-institute/admissions" class="inline-flex items-center justify-center gap-2 rounded-md bg-manthan-gold px-6 py-3.5 font-bold text-manthan-900 hover:brightness-95">
            See admission process
          </a>
        </div>
      </div>
    </section>

    <SiteFooter />
  </div>
</DemoLayout>
