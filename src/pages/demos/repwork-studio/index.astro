---
import StudioShell from '@/components/demos/StudioShell.astro';
import { Image } from 'astro:assets';
import hero from '@/assets/demos/expansion/gym-hero.jpg';
import { classes } from '@/content/demos/repwork-studio/classes';
import './theme.css';
export const prerender = true;
---
<StudioShell slug="repwork-studio" title="Repwork — Show up. Find your strong." description="A Bengaluru training studio concept with a working class finder, clear memberships and a first-visit walkthrough." theme="#141714" fonts="/fonts/demos/aangan-form/display.css" links={[{href:'#training',label:'The training'},{href:'#schedule',label:'Timetable'},{href:'#membership',label:'Membership'}]}>
  <span slot="wordmark">REPWORK<span class="rw-logo-dot">/</span></span><span slot="nav-cta">Find your first class ↗</span>
  <section class="rw-hero"><Image src={hero} alt="Athlete lifting a barbell in a dark training space; illustrative studio photography" widths={[480,800,1280,1600]} sizes="100vw" width={1600} height={1085} loading="eager" fetchpriority="high" class="sd-hero-photo"/><div class="rw-hero-copy"><p class="sd-eyebrow">Strength. Sweat. A place to start.</p><h1><span class="sd-hero-line">SHOW UP.</span><span class="sd-hero-line">FIND YOUR</span><span class="sd-hero-line rw-lime">STRONG.</span></h1><p>Small-group training. Big-room energy.<br/>Your next rep starts right here.</p><a class="sd-button" href="#schedule">Find your session <span aria-hidden="true">↗</span></a></div><div class="rw-hero-caption sd-eyebrow"><span>Indiranagar, Bengaluru · Fictional studio</span><span>Every level has a starting line.</span></div></section>
  <div class="rw-strip" aria-label="Our training philosophy"><span>GOOD FORM.</span><span>GOOD ENERGY.</span><span>YOUR OWN PACE.</span></div>
  <section class="sd-wrap sd-section" id="training"><div class="sd-section-head"><div><p class="sd-eyebrow">01 / Find your format</p><h2>THREE WAYS<br/>TO <span>MOVE FORWARD.</span></h2></div><p>A stronger routine starts with something you want to come back to. Find the format that fits your day.</p></div><div class="rw-formats">{[{n:'01',name:'BUILD',tag:'Strength / 50 minutes',body:'Squat, hinge, push, pull. Coached sets, thoughtful progressions and time to get your technique right.'},{n:'02',name:'ENGINE',tag:'Conditioning / 45 minutes',body:'Intervals and team circuits with room to scale the effort. Bring your energy; work at your own pace.'},{n:'03',name:'RESET',tag:'Mobility / 40 minutes',body:'Slow down, explore your range and spend time with the movements that make the rest of your week feel better.'}].map(s=><article class="sd-story-step"><p class="sd-eyebrow">{s.n} / {s.tag}</p><h3>{s.name}</h3><p>{s.body}</p><a href="#schedule">See the timetable ↗</a></article>)}</div></section>
  <section class="rw-timetable sd-wrap sd-section" id="schedule" data-class-finder><div class="sd-section-head"><div><p class="sd-eyebrow">02 / Make room for yourself</p><h2>YOUR WEEK.<br/>YOUR WORK.</h2></div><p>Illustrative weekly timetable. Pick a day and a format to find your starting point.</p></div><div class="rw-controls" hidden data-class-controls><label>Day<select data-class-day aria-label="Filter classes by day"><option value="All">All days</option>{['Mon','Tue','Wed','Thu','Fri','Sat'].map(d=><option>{d}</option>)}</select></label><label>Training<select data-class-format aria-label="Filter classes by format"><option value="All">Every format</option>{['Strength','Conditioning','Mobility'].map(f=><option>{f}</option>)}</select></label><button type="button" data-class-reset>Reset filters</button></div><p class="sd-status" data-class-count aria-live="polite">8 sample sessions · Times in IST</p><div class="rw-sessions">{classes.map(c=><article data-class-row data-day={c.day} data-format={c.format}><p class="rw-session-time"><span>{c.day}</span>{c.time}</p><div><h3>{c.name}</h3><p>{c.level} · {c.minutes} min</p></div><span class="rw-tag">{c.format}</span><a href={`#session-${c.id}`} data-session-link>Explore session <span aria-hidden="true">↗</span></a><details id={`session-${c.id}`}><summary>Session details</summary><p>{c.format==='Strength'?'A technique-led warm-up, coached working sets and a calm finish.':c.format==='Mobility'?'A slower session with guided movement and time to explore your range.':'A progressive warm-up, timed intervals with scaling options and a cooldown.'} Arrive 10 minutes early, bring water and share any movement concerns with your coach.</p><a class="sd-button" href="#visit">Ask about a studio website ↗</a><p class="sd-note">Sample timetable; no class is reserved.</p></details></article>)}</div><p data-class-empty hidden>No sessions match. Try another day or reset the filters.</p></section>
  <section class="sd-wrap sd-section rw-start"><div><p class="sd-eyebrow">03 / The first session</p><h2>NO BEFORE.<br/>NO AFTER.<br/><span>JUST BEGIN.</span></h2><p>No transformation promises. A clear path from the front door to your first coached session.</p></div><div class="rw-first-steps">{[{n:'01',title:'Walk in as you are.',body:'Comfortable training clothes, a water bottle and ten minutes to settle in. You do not need to get fit before your first visit.'},{n:'02',title:'Find your version.',body:'Tell the coach it is your first class. The movement, load and pace can be adjusted around your experience.'},{n:'03',title:'Build a repeatable week.',body:'Try a format, notice how it fits your routine and leave recovery time. Consistency looks different for everyone.'}].map(s=><article class="sd-story-step"><b>{s.n}</b><h3>{s.title}</h3><p>{s.body}</p></article>)}</div></section>
  <section class="sd-wrap sd-section rw-membership" id="membership"><div class="sd-section-head"><div><p class="sd-eyebrow">04 / A routine that fits</p><h2>CHOOSE YOUR PACE.</h2></div><p>Sample all-inclusive prices for this fictional studio. No payment or real booking is taken.</p></div><div class="sd-grid">{[{name:'DROP IN',price:'₹600',term:'One session',items:'One coached class · Try any format · No ongoing commitment'},{name:'FIND YOUR RHYTHM',price:'₹3,200',term:'8 sessions / 30 days',items:'Any training format · 30-day validity · Unused sessions expire'},{name:'MAKE IT A HABIT',price:'₹4,800',term:'12 sessions / 30 days',items:'Any training format · 30-day validity · No automatic renewal'}].map(p=><article><p class="sd-eyebrow">{p.name}</p><h3>{p.price}</h3><p>{p.term}</p><p class="sd-note">{p.items}</p><a class="sd-button sd-outline" href="#visit">Explore this website concept ↗</a></article>)}</div></section>
  <span slot="closing">YOUR NEXT REP.<br/>YOUR NEXT CHAPTER.</span>
</StudioShell>
<script>
const finder=document.querySelector<HTMLElement>('[data-class-finder]');
if(finder){const day=finder.querySelector<HTMLSelectElement>('[data-class-day]')!;const format=finder.querySelector<HTMLSelectElement>('[data-class-format]')!;const rows=[...finder.querySelectorAll<HTMLElement>('[data-class-row]')];const update=()=>{let count=0;for(const row of rows){const show=(day.value==='All'||row.dataset.day===day.value)&&(format.value==='All'||row.dataset.format===format.value);row.hidden=!show;if(show)count++;}finder.querySelector('[data-class-count]')!.textContent=`${count} sample session${count===1?'':'s'} · Times in IST`;finder.querySelector<HTMLElement>('[data-class-empty]')!.hidden=count>0;};day.addEventListener('change',update);format.addEventListener('change',update);finder.querySelector('[data-class-reset]')!.addEventListener('click',()=>{day.value='All';format.value='All';update();});finder.querySelector<HTMLElement>('[data-class-controls]')!.hidden=false;finder.querySelectorAll<HTMLAnchorElement>('[data-session-link]').forEach(link=>link.addEventListener('click',()=>{const detail=document.getElementById(link.hash.slice(1)) as HTMLDetailsElement|null;if(detail)detail.open=true;}));}
</script>
