---
import DemoLayout from "@/layouts/DemoLayout.astro";
import { projects, getProjectBySlug } from "@/content/demos/shivalik-homes/projects";
import { waLink } from "@/lib/contact-links";

export const prerender = true;

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug!);
if (!project) throw new Error(`Unknown project slug "${slug}"`);

function formatInr(n: number): string {
  return `₹${(n / 100000).toFixed(1)} L`;
}

const waMsg = waLink(`Hi, I'm interested in ${project.name} by Shivalik Homes & Developers — could you share more details?`);
const contactHref = `/contact?category=Real%20Estate&demo=shivalik-homes&project=${encodeURIComponent(project.name)}`;

const roomColors = ["#a9812f33", "#63533f22", "#7c6a5233", "#4d413022", "#a9812f22", "#63533f33"];
---

<DemoLayout
  demoSlug="shivalik-homes"
  title={`${project.name} — Shivalik Homes & Developers`}
  description={`${project.name} in ${project.locality} — ${project.configLabel}, ${project.status.replace(/-/g, " ")}. Floor plans, amenities and EMI calculator.`}
  fontsHref="/fonts/demos/shivalik-homes/fonts.css"
  themeColor="#63533f"
>
  <div class="font-['Work_Sans'] min-h-screen bg-shivalik-50 text-shivalik-900">
    <header class="sticky top-9 z-40 border-b border-shivalik-300/40 bg-shivalik-50/95 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
        <a href="/demos/shivalik-homes" class="font-['Spectral'] text-lg font-semibold">Shivalik Homes</a>
        <a href="/demos/shivalik-homes/projects" class="text-sm font-medium hover:text-shivalik-brass">← All projects</a>
      </div>
    </header>

    <section class="border-b border-shivalik-300/40 bg-shivalik-100/60 py-12">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-widest text-shivalik-brass">{project.locality}</p>
        <h1 class="mt-2 font-['Spectral'] text-3xl font-semibold sm:text-4xl">{project.name}</h1>
        <p class="mt-4 max-w-2xl text-shivalik-700">{project.description}</p>
        <dl class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
          <div><dt class="text-xs uppercase text-shivalik-500">Configuration</dt><dd class="font-medium">{project.configLabel}</dd></div>
          <div><dt class="text-xs uppercase text-shivalik-500">Possession</dt><dd class="font-medium">{project.possessionDate}</dd></div>
          <div><dt class="text-xs uppercase text-shivalik-500">Total units</dt><dd class="font-medium">{project.totalUnits}</dd></div>
          <div><dt class="text-xs uppercase text-shivalik-500">Storeys</dt><dd class="font-medium">{project.storeys}</dd></div>
        </dl>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
      <h2 class="font-['Spectral'] text-2xl font-semibold">Floor plans</h2>
      <div class="mt-6 space-y-10">
        {project.unitTypes.map((unit) => (
          <div class="grid gap-6 rounded-xl border border-shivalik-300/50 bg-white p-6 sm:grid-cols-2">
            <div>
              <svg viewBox="0 0 100 100" role="img" aria-label={`Illustrative floor plan for the ${unit.config} unit`} class="w-full rounded-lg border border-shivalik-200 bg-shivalik-50">
                {unit.floorPlanRooms.map((room, i) => (
                  <g>
                    <rect x={room.x} y={room.y} width={room.w} height={room.h} fill={roomColors[i % roomColors.length]} stroke="var(--color-shivalik-500)" stroke-width="0.5" />
                    <text x={room.x + room.w / 2} y={room.y + room.h / 2} font-size="3.2" text-anchor="middle" fill="var(--color-shivalik-900)">{room.label}</text>
                  </g>
                ))}
              </svg>
              <p class="mt-2 text-xs text-shivalik-500">Illustrative layout, not to exact scale.</p>
            </div>
            <div>
              <h3 class="font-['Spectral'] text-xl font-semibold">{unit.config}</h3>
              <p class="mt-1 text-shivalik-600">{unit.areaSqft} sq. ft. carpet area</p>
              <p class="mt-3 text-2xl font-semibold text-shivalik-800">{formatInr(unit.priceMinInr)} – {formatInr(unit.priceMaxInr)}</p>
              <a href={contactHref} class="mt-5 inline-block rounded-md bg-shivalik-700 px-5 py-3 font-semibold text-shivalik-50 hover:bg-shivalik-900">Ask about {unit.config}</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="border-y border-shivalik-300/40 bg-shivalik-100/60 py-12">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <h2 class="font-['Spectral'] text-2xl font-semibold">EMI calculator</h2>
        <p class="mt-2 text-sm text-shivalik-600">Estimate your monthly payment. This is indicative only — your bank's actual offer may vary.</p>
        <form data-emi-calculator class="mt-6 grid gap-6 rounded-xl border border-shivalik-300/50 bg-white p-6 sm:grid-cols-2">
          <div>
            <div class="grid gap-4">
              <div>
                <label for="principal" class="mb-1 block text-sm font-medium">Loan amount (₹)</label>
                <input id="principal" name="principal" type="number" value={project.unitTypes[0]!.priceMinInr} min="100000" step="100000" class="w-full rounded-md border border-shivalik-300 px-3 py-2" />
              </div>
              <div>
                <label for="rate" class="mb-1 block text-sm font-medium">Interest rate (% per year)</label>
                <input id="rate" name="rate" type="number" value="8.5" min="1" max="20" step="0.1" class="w-full rounded-md border border-shivalik-300 px-3 py-2" />
              </div>
              <div>
                <label for="tenure" class="mb-1 block text-sm font-medium">Tenure (years)</label>
                <input id="tenure" name="tenure" type="number" value="20" min="1" max="30" step="1" class="w-full rounded-md border border-shivalik-300 px-3 py-2" />
              </div>
            </div>
          </div>
          <div class="flex flex-col justify-center rounded-lg bg-shivalik-100 p-6 text-center">
            <p class="text-xs uppercase tracking-wide text-shivalik-500">Estimated EMI</p>
            <p data-emi-result class="mt-1 font-['Spectral'] text-3xl font-semibold text-shivalik-800">—</p>
            <div class="mt-4 grid grid-cols-2 gap-4 text-sm">
              <div><p class="text-shivalik-500">Total payment</p><p data-emi-total class="font-medium">—</p></div>
              <div><p class="text-shivalik-500">Total interest</p><p data-emi-interest class="font-medium">—</p></div>
            </div>
          </div>
        </form>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-8 sm:grid-cols-2">
        <div>
          <h2 class="font-['Spectral'] text-xl font-semibold">Amenities</h2>
          <ul class="mt-4 space-y-2 text-shivalik-700">
            {project.amenities.map((a) => <li class="flex items-start gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-shivalik-brass"></span>{a}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="font-['Spectral'] text-xl font-semibold">Location advantages</h2>
          <ul class="mt-4 space-y-2 text-shivalik-700">
            {project.locationAdvantages.map((a) => <li class="flex items-start gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-shivalik-brass"></span>{a}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="border-t border-shivalik-300/40 bg-shivalik-100/60 py-12">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <h2 class="font-['Spectral'] text-xl font-semibold">Gallery & walkthrough</h2>
        <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {[1, 2, 3, 4].map((i) => (
            <div class="flex aspect-square items-center justify-center rounded-lg border border-dashed border-shivalik-300 bg-shivalik-50 text-xs text-shivalik-400">Gallery photo {i}</div>
          ))}
        </div>
        <div class="mt-4 flex aspect-video items-center justify-center rounded-lg border border-dashed border-shivalik-300 bg-shivalik-50 text-sm text-shivalik-400">
          Walkthrough video placeholder — added once site filming is complete
        </div>
        <p class="mt-2 text-xs text-shivalik-500">RERA: {project.reraNumber}</p>
      </div>
    </section>

    <section class="bg-shivalik-900 py-14 text-center text-shivalik-50">
      <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
        <h2 class="font-['Spectral'] text-2xl font-semibold text-white">Book a site visit to {project.name}</h2>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
          <a href={contactHref} class="rounded-md bg-shivalik-brass px-6 py-3.5 font-bold text-white hover:opacity-90">Book a site visit</a>
          <a href={waMsg} target="_blank" rel="noopener" aria-label="Ask on WhatsApp (opens WhatsApp)" class="rounded-md border border-shivalik-300 px-6 py-3.5 font-semibold hover:bg-shivalik-800">Ask on WhatsApp</a>
        </div>
      </div>
    </section>
  </div>

  <script src="../../../../scripts/demos/shivalik-homes-emi.ts"></script>
</DemoLayout>
