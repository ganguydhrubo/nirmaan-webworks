---
import DemoLayout from '@/layouts/DemoLayout.astro';
import { Picture } from 'astro:assets';
import photo from '@/assets/demos/sanjeevani.jpg';
import { doctors } from '@/content/demos/sanjeevani';
export const prerender = true;
---
<DemoLayout demoSlug="sanjeevani-clinic" title="Sanjeevani Clinic | Care close to home in Nagpur" description="Explore a fictional family clinic in Nagpur: specialities, doctor schedules, fees and a clear appointment planning flow." fontsHref="/fonts/demos/sanjeevani-clinic/fonts.css" themeColor="#22677a">
  <div class="clinic"><header class="clinic-header container"><a class="clinic-logo" href="/demos/sanjeevani-clinic"><svg viewBox="0 0 40 40" width="40" height="40" aria-hidden="true"><rect width="40" height="40" rx="12" fill="#22677a"/><path d="M17 9h6v8h8v6h-8v8h-6v-8H9v-6h8Z" fill="white"/></svg><span>Sanjeevani<small>MULTISPECIALTY CLINIC</small></span></a><nav aria-label="Clinic"><a href="#care">Our care</a><a href="#doctors">Doctors & timings</a><a href="#visit">Plan a visit</a></nav></header>
    <main><section class="clinic-hero container"><div><p class="eyebrow">Dharampeth · Nagpur</p><h1>A familiar place<br />to ask about<br /><span>your health.</span></h1><p>For your child’s first visit, your parents’ regular check-up and the questions you keep putting off. Start with a doctor who has time to listen.</p><a class="primary" href="#visit">Plan an appointment</a><a class="secondary" href="#doctors">See doctor timings</a><p class="fine">Fictional clinic demo. No medical advice or live appointments.</p></div><div class="hero-visual"><Picture src={photo} formats={['avif','webp']} widths={[480,800,1100]} sizes="(min-width: 800px) 45vw, 100vw" alt="A consultation desk with a stethoscope and an empty chair" loading="eager" fetchpriority="high" /><div class="hours"><strong>A little preparation helps.</strong><p>Bring past prescriptions and reports. Write down the questions you want to ask.</p></div></div></section>
    <section id="care" class="container section"><div class="intro"><p class="eyebrow">Care, without the runaround</p><h2>One neighbourhood.<br />Different stages of life.</h2></div><div class="care-list">{doctors.map((d,i) => <article><span>0{i+1}</span><div><h3>{d.specialty}</h3><p>{d.description}</p></div><a href="#doctors" aria-label={`Find the doctor for ${d.specialty}`}>Doctor & timings ↗</a></article>)}</div></section>
    <section id="doctors" class="doctors-section"><div class="container section"><p class="eyebrow">Know who you’ll meet</p><h2>A doctor, a time,<br />and a clear next step.</h2><p class="fine">All names, qualifications and schedules below are fictional sample content. Registration numbers must be verified before a real clinic launches.</p><label class="filter-label" for="specialty-filter">Show doctor schedule<select id="specialty-filter" data-doctor-filter><option value="all">All specialities</option>{doctors.map(d => <option value={d.specialty}>{d.specialty}</option>)}</select></label><p role="status" data-doctor-count>3 example doctor schedules</p>
      <div class="doctors">{doctors.map(d => <article data-specialty={d.specialty}><div class="initials" aria-hidden="true">{d.name.split(' ').slice(1).map(s => s[0]).join('')}</div><p class="eyebrow">{d.specialty}</p><h3>{d.name}</h3><p>{d.qualification}</p><dl><dt>Consultation days</dt><dd>{d.days}</dd><dt>Clinic hours (IST)</dt><dd>{d.time}</dd></dl><p class="fine">Registration: demonstration only; no registration claimed.</p><a href="#visit" class="secondary">Plan a consultation ↗</a></article>)}</div>
    </div></section>
    <section id="visit" class="container section visit"><div><p class="eyebrow">Your first visit</p><h2>Less uncertainty.<br />More time for care.</h2><ol><li>Choose a speciality and your preferred day.</li><li>A real clinic would confirm a slot by phone.</li><li>Arrive 10 minutes early with your reports.</li></ol><p>Sample consultation fee: ₹500 for family medicine; ₹700 for specialist consultations. Tests and procedures would be quoted separately.</p><p class="fine">Sample payment policy: UPI, card or cash. No cashless insurance arrangements are claimed. Ask a real practice for an itemised receipt.</p></div><div class="visit-panel"><h3>Try the appointment planner</h3><p>This preview stays on your device. Do not enter symptoms or personal information.</p><form data-clinic-planner><label for="visit-specialty">Speciality</label><select id="visit-specialty" name="specialty">{doctors.map(d => <option data-days={d.days} data-time={d.time}>{d.specialty}</option>)}</select><label for="visit-date">Preferred day</label><input id="visit-date" name="date" type="date" required /><button class="primary" type="submit">Preview next step</button><p data-clinic-result role="status">No appointment will be booked.</p><noscript>Doctor schedules are shown above. This interactive preview needs JavaScript.</noscript></form></div></section>
    <section class="container section questions"><div><p class="eyebrow">Before you set out</p><h2>Questions are welcome.</h2><p>Sample address: 24 West High Court Road, Dharampeth, Nagpur, Maharashtra 440010. This fictional practice has no operating location or patient phone line.</p><p class="emergency">This demo cannot provide urgent care. In an emergency, contact local emergency services or go to your nearest emergency department.</p></div><div>{[
      ['Do I need an appointment?', 'This demonstration does not take bookings. A real clinic would confirm appointment availability before asking you to travel.'],
      ['What should I bring?', 'For a real consultation, bring existing prescriptions, relevant reports and a list of current medicines. The clinician will decide what information is needed.'],
      ['Are online consultations available?', 'No online consultation service is provided by this demo. Availability and suitability would be discussed with a registered clinician.'],
      ['Will my information stay private?', 'This planner asks for no personal or health information and sends nothing. The agency’s separate website enquiry form has its own privacy notice.'],
    ].map(([q,a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div></section>
    </main><footer class="container section"><p class="clinic-logo">Sanjeevani</p><p>A fictional clinic with a practical website.</p><a href="/contact?category=Clinics&demo=sanjeevani-clinic" class="primary">Get a website for your clinic</a></footer>
  </div><script src="../../../scripts/demos/sanjeevani-planner.ts"></script>
</DemoLayout>
<style>
.clinic{font-family:'Source Sans 3',Arial,sans-serif;background:#fff;color:#102e37}.container{width:min(1180px,calc(100% - 40px));margin-inline:auto}.section{padding-block:80px}.clinic-header{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-block:25px}.clinic-logo{display:flex;align-items:center;gap:12px;font:600 25px Outfit,sans-serif}.clinic-logo small{display:block;font:600 10px 'Source Sans 3',sans-serif;letter-spacing:.13em;margin-top:4px}.clinic-header nav{display:flex;gap:25px;font-weight:600}.clinic-header nav a{padding-block:12px}.clinic-hero{display:grid;grid-template-columns:1.05fr 1fr;gap:60px;align-items:center;padding-block:50px 75px}h1,h2,h3{font-family:Outfit,sans-serif;font-weight:600;letter-spacing:-.04em}h1{font-size:clamp(42px,5.4vw,68px);line-height:1.06}h1 span{color:#22677a}h2{font-size:clamp(32px,4vw,48px);line-height:1.1;margin-bottom:24px}h3{font-size:24px;line-height:1.25;margin-bottom:12px}p{line-height:1.7;margin-bottom:18px}.eyebrow{text-transform:uppercase;letter-spacing:.15em;font-size:12px;font-weight:600;color:#22677a}.clinic-hero>div>p:not(.eyebrow){margin-top:24px;max-width:460px}.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;padding:14px 20px;min-height:48px;font-weight:600}.primary{background:#22677a;color:#fff;border-radius:6px}.secondary{color:#1b5160;text-decoration:underline;text-underline-offset:5px}.fine{font-size:13px!important;line-height:1.6!important}.hero-visual{position:relative;background:#dcebee;padding:20px 20px 0;border-radius:100px 12px 12px 12px}.hero-visual :global(img){width:100%;height:420px;object-fit:cover;border-radius:85px 6px 6px 6px}.hours{padding:22px}.hours p{margin:8px 0 0;font-size:14px}.care-list article{display:grid;grid-template-columns:50px 1fr 190px;gap:24px;padding-block:28px;border-top:1px solid #93c1cb}.care-list article>span{font:500 30px Outfit,sans-serif;color:#22677a}.care-list p{max-width:640px}.care-list a{align-self:center;padding:14px 0;font-weight:600}.doctors-section{background:#f1f7f8}.doctors{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.doctors article{background:#fff;padding:28px;border:1px solid #93c1cb;border-radius:10px}.initials{width:60px;height:60px;border-radius:50%;display:grid;place-items:center;background:#dcebee;color:#22677a;font:600 24px Outfit,sans-serif;margin-bottom:24px}dt{font-size:12px;margin-top:14px;color:#22677a}dd{font-weight:600;margin:4px 0 12px}.visit,.questions{display:grid;grid-template-columns:1fr 1fr;gap:70px}.visit ol{padding-left:22px;list-style:decimal;margin-block:24px}.visit li{padding:8px}.visit-panel{background:#dcebee;border-radius:12px;padding:32px}label{display:block;font-weight:600}select,input{display:block;width:100%;min-width:0;background:#fff;border:1px solid #22677a;padding:12px;font-size:16px;border-radius:5px;margin:8px 0 20px}.filter-label{max-width:320px;margin-top:30px}.emergency{border-left:3px solid #22677a;padding-left:20px;font-size:14px}details{border-bottom:1px solid #93c1cb;padding-block:12px}summary{min-height:44px;padding-top:10px;cursor:pointer;font-weight:600}details p{font-size:15px}.questions{border-top:1px solid #93c1cb}footer{border-top:1px solid #93c1cb}footer .primary{margin-top:10px}[role=status]{margin-top:16px;font-size:14px}@media(max-width:800px){.section{padding-block:48px}.clinic-header{flex-wrap:wrap}.clinic-header nav{gap:20px;font-size:14px}.clinic-hero,.visit,.questions{grid-template-columns:1fr;gap:30px}.clinic-hero{padding-top:28px}.hero-visual :global(img){height:300px}.doctors{grid-template-columns:1fr}.care-list article{grid-template-columns:32px 1fr;gap:12px}.care-list a{grid-column:2}.visit-panel{padding:24px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}}
</style>
