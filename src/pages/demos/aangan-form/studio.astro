---
import DemoLayout from '@/layouts/DemoLayout.astro';
import Header from './_components/Header.astro';
import Footer from './_components/Footer.astro';
import Space from './_components/Space.astro';
import './_components/theme.css';
export const prerender = true;
---
<DemoLayout demoSlug="aangan-form" title="The studio — Process & scope | Aangan / Form" description="The imagined studio's approach to briefing, design, materials and site coordination. Clear scope from the first conversation." fontsHref="/fonts/demos/aangan-form/fonts.css" themeColor="#eeece5"><div class="aangan"><Header active="studio"/><main class="af-wrap"><div class="af-page-head"><p class="af-mono">A fictional independent studio / Ahmedabad</p><h1>Fewer gestures.<br/>Better reasons.</h1><p>Aangan means courtyard: a place where daily life gathers. Form is the discipline that gives that life a setting. Together, a way of thinking about interiors.</p></div><section class="af-story"><div class="reveal"><h2>Make room<br/>for the ordinary.</h2><p>We imagine spaces that feel at home in their climate and in their owners’ routines. Honest materials. Storage where it belongs. Light that does some of the decorating.</p></div><Space id="studio" plan/></section><section class="af-section"><div class="af-section-head"><p class="af-mono">The working sequence</p><h2>Listen. Draw.<br/>Question. Refine.</h2></div><div class="af-process">{[['The brief','Start with who uses the space, how each day unfolds and what needs to change. Collect room dimensions, site constraints, reference images and a comfortable budget.'],['The concept','Compare zoning options and a material direction. Review furniture scale, circulation and storage together before choosing a preferred layout.'],['The detail','Develop joinery drawings, finishes and lighting intent. Separate design decisions from procurement so costs and responsibilities can be discussed clearly.'],['The handover','Review the proposed scope with the appointed contractor. In a real commission, site visits, procurement and snag reviews would be agreed separately in writing.']].map(([t,b])=><article class="reveal"><h3>{t}</h3><p>{b}</p></article>)}</div></section><section class="af-scope af-section" style="border-top:1px solid #282b2744"><div><h2>Design scope.</h2><ul><li>Measured brief and concept planning</li><li>Material palette and lighting intent</li><li>Furniture layouts and joinery design</li><li>Defined drawing and revision schedule</li></ul></div><div><h2>Discuss separately.</h2><ul><li>Structural engineering and statutory approvals</li><li>Construction and contractor appointment</li><li>Procurement, delivery and installation</li><li>Site supervision and travel frequency</li></ul><a class="af-link" href="/demos/aangan-form/plan">Understand the sample costs ↗</a></div></section></main><Footer/></div></DemoLayout>
