    highlightBadge: "Photography & Weddings",
  },
  {
    slug: "retail-d2c",
    category: "retail",
    startingPrice: "₹4,999",
    turnaround: "48 hours",
    bleedSource: "Shopify recurring rent (₹29,880/yr) + marketplace cuts (15%–28%)",
    keyCapabilities: ["Lightweight browsable product catalogue (zero JS needed)", "Quick-view modals with dimensions, materials & price", "Direct WhatsApp 1-tap ordering with zero monthly rent"],
    highlightBadge: "Local Boutiques & D2C",
  },
  {
    slug: "automotive",
    category: "lifestyle",
    startingPrice: "₹22,000",
    turnaround: "10–12 days",
    bleedSource: "CarDekho / OLX listing subscription costs & buyer distrust",
    keyCapabilities: ["Interactive 120-point vehicle inspection explorer", "Transparent asking price specs with exact inclusions", "Workshop service brief builder with upfront estimates"],
    highlightBadge: "Workshops & Dealers",
  },
  {
    slug: "diagnostics-labs",
    category: "healthcare",
    startingPrice: "₹20,000",
    turnaround: "10–12 days",
    bleedSource: "Aggregator middlemen taking cuts & lost report queries",
    keyCapabilities: ["Searchable 100+ diagnostic test directory with preparation", "Plain-language patient report explainer & normal ranges", "Sample collection journey & home-visit booking handoff"],
    highlightBadge: "Diagnostic Centers",
  },
];

// Merge with siteConfig.industryRegistry and siteConfig.demoRegistry
const fullIndustries = siteConfig.industryRegistry.map((ind) => {
  const meta = industryCards.find((c) => c.slug === ind.slug) || {
    slug: ind.slug,
    category: "services",
    startingPrice: "₹16,000",
    turnaround: "10 days",
    bleedSource: "Third-party platform dependency",
    keyCapabilities: ["Bespoke design", "Fast performance", "Direct enquiry"],
    highlightBadge: ind.shortName,
  };
  const demo = siteConfig.demoRegistry.find((d) => d.industrySlug === ind.slug)!;
  const content = industryContent[ind.slug];

  return {
    ...ind,
    ...meta,
    demo,
    content,
  };
});

// Spotlight items for the interactive top stage
const spotlightDemos = [
  {
    id: "kayal-backwaters",
    title: "Kayal Backwaters Resort",
    industry: "Hotels, Resorts & Homestays",
    city: "Alleppey, Kerala",
    heroText: "Direct guest booking engine saving 18%–22% OTA commissions on every single night.",
    videoSrc: "/videos/demos/kayal-backwaters.webm",
    posterSrc: "/images/demos/kayal-backwaters/thumb.webp",
    demoUrl: "/demos/kayal-backwaters",
    blueprintUrl: "/industries/hotels-resorts",
    statLabel: "Saved on 40 direct bookings",
    statValue: "₹1,42,000+",
    keyFeature: "Direct WhatsApp & Instant Booking Flow",
  },
  {
    id: "sanjeevani-clinic",
    title: "Sanjeevani Multispecialty Clinic",
    industry: "Healthcare Clinics",
    city: "Nagpur, Maharashtra",
    heroText: "Doctor OPD rosters and night-time appointment requests that land straight in the clinic diary.",
    videoSrc: "/videos/demos/sanjeevani-clinic.webm",
    posterSrc: "/images/demos/sanjeevani-clinic/thumb.webp",
    demoUrl: "/demos/sanjeevani-clinic",
    blueprintUrl: "/industries/healthcare-clinics",
    statLabel: "Booked outside clinic hours",
    statValue: "64% Enquiries",
    keyFeature: "Specialist Roster & Instant WhatsApp OPD",
  },
  {
    id: "anaar-awadhi-table",
    title: "Anaar — The Awadhi Table",
    industry: "Restaurants & Dining",
    city: "Lucknow, Uttar Pradesh",
    heroText: "A rich digital menu and direct table reservation engine with zero 30% aggregator food app cut.",
    videoSrc: "/videos/demos/anaar-awadhi-table.webm",
    posterSrc: "/images/demos/anaar-awadhi-table/thumb.webp",
    demoUrl: "/demos/anaar-awadhi-table",
    blueprintUrl: "/industries/restaurants-cafes",
    statLabel: "Aggregator commission cut saved",
    statValue: "Zero %",
    keyFeature: "Categorised Rupee Menu & Table Booking",
  },
  {
    id: "sunday-objects",
    title: "Sunday Objects",
    industry: "Retail & Boutiques",
    city: "Kochi, Kerala",
    heroText: "A lightning-fast WhatsApp catalog store launched in 48 hours with zero monthly Shopify rent.",
    videoSrc: "/videos/demos/sunday-objects.webm",
    posterSrc: "/images/demos/sunday-objects/thumb.webp",
    demoUrl: "/demos/sunday-objects",
    blueprintUrl: "/industries/retail-d2c",
    statLabel: "Annual platform rent saved",
    statValue: "₹29,880/yr",
    keyFeature: "₹4,999 One-Time Launch · 48h Turnaround",
  },
];

const aggregatorComparison = [
  {
    sector: "Hotels & Resorts",
    aggregator: "MakeMyTrip, Agoda, Booking.com",
    bleedCost: "18% – 22% per room night",
    ownedSolution: "Direct WhatsApp booking engine",
    savings: "₹1,40,000 – ₹4,20,000+",
  },
  {
    sector: "Restaurants & Cafes",
    aggregator: "Zomato, Swiggy",
    bleedCost: "25% – 32% per order + ad bids",
    ownedSolution: "Direct menu & table reservation",
    savings: "₹1,20,000 – ₹3,50,000+",
  },
  {
    sector: "Healthcare & Dental",
    aggregator: "Practo, Justdial",
    bleedCost: "₹250 – ₹500 per lead (shared)",
    ownedSolution: "Exclusive doctor OPD calendar",
    savings: "₹60,000 – ₹1,80,000+",
  },
  {
    sector: "Retail & Local Shops",
    aggregator: "Shopify + Marketplace cuts",
    bleedCost: "₹29,880/yr rent + 15%–28% cuts",
    ownedSolution: "₹4,999 one-time WhatsApp store",
    savings: "₹29,880+ saved annually",
  },
  {
    sector: "Real Estate & Builders",
    aggregator: "MagicBricks, 99acres",
    bleedCost: "₹15,000 – ₹35,000/month listing fees",
    ownedSolution: "RERA-verified floor plans portal",
    savings: "100% exclusive buyer leads",
  },
];

const defaultSpotlight = spotlightDemos[0]!;
const getShortTitle = (title: string) => title.split(" — ")[0]?.split(" ")[0] || title;
---

<BaseLayout
  title="Website Design by Industry — 15 Working Demos | ATITTLE"
  description="Explore 15 working website demos tailored for Indian clinics, hotels, retailers, coaching institutes, and restaurants. Watch live motion reels, see real pricing from ₹4,999, and stop bleeding margins to aggregators."
  jsonLd={jsonLd}
>
  <!-- Hero Section with Brand Cream Theme -->
  <section class="relative overflow-hidden bg-cream pt-12 pb-16 sm:pt-20 sm:pb-24 border-b border-ink-200">
    <!-- Ambient Warm Texture Glow -->
    <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 h-96 w-full max-w-7xl bg-gradient-to-b from-brand-100/40 via-amber-100/20 to-transparent blur-3xl" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 text-center">
      <!-- Live Status Pill -->
      <div class="inline-flex items-center gap-2 rounded-full border border-brand-300 bg-brand-50/90 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-700 shadow-sm backdrop-blur-sm">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-600"></span>
        </span>
        15 Working Demos · Real Indian Business Architecture
      </div>

      <!-- Main Headline -->
      <h1 class="mt-6 font-display text-3xl font-bold tracking-tight text-ink-950 sm:text-5xl lg:text-6xl max-w-4xl mx-auto leading-tight sm:leading-tight">
        15 Indian Industries.<br class="hidden sm:inline" />
        Zero Flat Mockups.<br class="hidden sm:inline" />
        <span class="text-brand-600">Every Single Demo Actually Works.</span>
      </h1>

      <!-- Subtitle -->
      <p class="mx-auto mt-5 max-w-2xl text-base sm:text-lg text-ink-700 leading-relaxed">
        Most agencies hand you photoshopped Figma screenshots. We engineer full, working websites with live room booking, doctor OPD rosters, floor plan calculators, Awadhi restaurant menus, and ₹4,999 WhatsApp storefronts.
      </p>

      <!-- Quick Proof Value Counters -->
      <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4 max-w-3xl mx-auto text-left">
        <div class="rounded-xl border border-ink-200 bg-white p-4 shadow-sm">
          <div class="font-display text-2xl font-bold text-ink-950">15 / 15</div>
          <p class="text-xs text-ink-600 font-medium mt-0.5">Live working demos</p>
        </div>
        <div class="rounded-xl border border-ink-200 bg-white p-4 shadow-sm">
          <div class="font-display text-2xl font-bold text-brand-600">0% Cut</div>
          <p class="text-xs text-ink-600 font-medium mt-0.5">Aggregator bleed stopped</p>
        </div>
        <div class="rounded-xl border border-ink-200 bg-white p-4 shadow-sm">
          <div class="font-display text-2xl font-bold text-ink-950">₹4,999+</div>
          <p class="text-xs text-ink-600 font-medium mt-0.5">Transparent rupee tiers</p>
        </div>
        <div class="rounded-xl border border-ink-200 bg-white p-4 shadow-sm">
          <div class="font-display text-2xl font-bold text-ink-950">48h – 14d</div>
          <p class="text-xs text-ink-600 font-medium mt-0.5">Guaranteed launch turn</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Cinematic Spotlight Stage (Flagship Motion Reels) -->
  <section class="bg-white py-14 sm:py-20 border-b border-ink-200">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-600">Interactive Dolly Reel</span>
          <h2 class="mt-1 font-display text-2xl font-bold text-ink-950 sm:text-3xl">Flagship Demos In Motion</h2>
          <p class="mt-2 text-sm text-ink-600 max-w-xl">
            Click a sector to switch the live interactive viewport. Every screen is recorded directly from the production build.
          </p>
        </div>
        <!-- Spotlight Selector Tabs with Scroller & Fade Mask -->
        <div class="scroller-mask relative max-w-full -mx-4 px-4 sm:mx-0 sm:px-0">
          <div class="flex items-center gap-2 overflow-x-auto sm:flex-wrap pb-2 sm:pb-0 scrollbar-none" id="spotlight-selector" role="tablist">
            {spotlightDemos.map((item, idx) => (
              <button
                type="button"
                role="tab"
                aria-selected={idx === 0 ? "true" : "false"}
                class={`spotlight-tab-btn shrink-0 rounded-lg px-3.5 py-2 text-xs font-semibold transition border ${
                  idx === 0
                    ? "bg-brand-600 text-white border-brand-600 shadow-sm"
                    : "bg-cream text-ink-700 border-ink-200 hover:border-brand-400 hover:text-ink-950"
                }`}
                data-spotlight-id={item.id}
              >
                {getShortTitle(item.title)}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Spotlight Showcase Box -->
      <div class="mt-8 rounded-2xl border border-ink-200 bg-cream p-4 sm:p-8 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <!-- Device Viewport Frame -->
          <div class="lg:col-span-7">
            <div class="device-frame overflow-hidden rounded-xl border border-ink-300 bg-ink-950 shadow-2xl">
              <!-- Window Chrome -->
              <div class="flex items-center justify-between border-b border-white/10 bg-ink-900/90 px-4 py-2.5 backdrop-blur-sm">
                <div class="flex items-center gap-1.5">
                  <span class="h-3 w-3 rounded-full bg-[#ff5f56]/90 inline-block"></span>
                  <span class="h-3 w-3 rounded-full bg-[#ffbd2e]/90 inline-block"></span>
                  <span class="h-3 w-3 rounded-full bg-[#27c93f]/90 inline-block"></span>
                </div>
                <div class="flex items-center gap-2 rounded-md bg-white/5 px-3 py-1 text-[11px] text-ink-300 font-mono tracking-tight">
                  <span class="text-emerald-400">https://</span><span id="spotlight-chrome-url">atittle.com/demos/kayal-backwaters</span>
                </div>
                <div class="flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-wider text-emerald-400">
                  <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span>60 FPS</span>
                </div>
              </div>

              <!-- Cinematic Video Container -->
              <div class="relative aspect-[16/10] w-full bg-ink-950 overflow-hidden group">
                <img
                  id="spotlight-poster"
                  src={defaultSpotlight.posterSrc}
                  alt={defaultSpotlight.title}
                  class="absolute inset-0 h-full w-full object-cover transition-opacity duration-300"
                  loading="eager"
                  width="720"
                  height="450"
                />
                <video
                  id="spotlight-video"
                  src={defaultSpotlight.videoSrc}
                  muted
                  loop
                  playsinline
                  autoplay
                  class="absolute inset-0 h-full w-full object-cover"
                ></video>

                <!-- Glossy Sheen Sweep -->
                <div class="spotlight-sheen pointer-events-none" aria-hidden="true"></div>

                <!-- Floating Feature Callout Overlay -->
                <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between rounded-lg bg-ink-950/85 px-3 py-2 text-xs text-white backdrop-blur-md border border-white/10">
                  <div class="flex items-center gap-2 truncate">
                    <span class="h-2 w-2 rounded-full bg-brand-400"></span>
                    <span id="spotlight-key-feature" class="font-medium truncate">{defaultSpotlight.keyFeature}</span>
                  </div>
                  <a
                    id="spotlight-open-link"
                    href={defaultSpotlight.demoUrl}
                    class="ml-2 inline-flex items-center gap-1 shrink-0 rounded bg-brand-600 px-2.5 py-1 text-[11px] font-semibold text-white hover:bg-brand-500 transition"
                  >
                    Open Live Demo ↗
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Spotlight Details & Impact Copy -->
          <div class="lg:col-span-5 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2">
                <span id="spotlight-city" class="rounded-full bg-ink-200/80 px-2.5 py-1 text-xs font-medium text-ink-800">
                  {defaultSpotlight.city}
                </span>
                <span id="spotlight-industry" class="rounded-full bg-brand-100 text-brand-800 px-2.5 py-1 text-xs font-semibold">
                  {defaultSpotlight.industry}
                </span>
              </div>

              <h3 id="spotlight-title" class="mt-4 font-display text-2xl font-bold text-ink-950 leading-tight">
                {defaultSpotlight.title}
              </h3>

              <p id="spotlight-hero-text" class="mt-3 text-sm sm:text-base text-ink-700 leading-relaxed">
                {defaultSpotlight.heroText}
              </p>

              <!-- Tangible Metric Badge -->
              <div class="mt-6 rounded-xl border border-brand-200 bg-white p-4 shadow-sm">
                <p id="spotlight-stat-label" class="text-xs font-semibold uppercase tracking-wider text-brand-600">
                  {defaultSpotlight.statLabel}
                </p>
                <div id="spotlight-stat-value" class="mt-1 font-display text-3xl font-bold text-ink-950">
                  {defaultSpotlight.statValue}
                </div>
                <p class="mt-1 text-xs text-ink-500">Calculated on realistic average order/booking volume</p>
              </div>
            </div>

            <div class="mt-8 flex flex-col sm:flex-row gap-3">
              <a
                id="spotlight-primary-cta"
                href={defaultSpotlight.demoUrl}
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-700 transition"
              >
                Test Full Working Demo <Icon name="external" class="h-4 w-4" />
              </a>
              <a
                id="spotlight-blueprint-cta"
                href={defaultSpotlight.blueprintUrl}
                class="inline-flex items-center justify-center gap-2 rounded-lg border border-ink-300 bg-white px-5 py-3 text-sm font-semibold text-ink-800 hover:border-brand-500 transition"
              >
                View Architecture Blueprint <Icon name="chevron-right" class="h-4 w-4" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Complete 15 Industry Grid with Interactive Filtering -->
  <section class="bg-cream py-16 sm:py-24" id="all-industries">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-widest text-brand-600">Complete Industry Directory</span>
        <h2 class="mt-2 font-display text-3xl font-bold text-ink-950 sm:text-4xl">
          15 Tailored Business Categories
        </h2>
        <p class="mt-3 text-base text-ink-700">
          Filter by sector to see exact pricing, aggregator replacement models, and live motion reels.
        </p>
      </div>

      <!-- Filter Tabs Bar with Scroller & Fade Mask -->
      <div class="scroller-mask relative mt-8 max-w-full -mx-4 px-4 sm:mx-0 sm:px-0">
        <div class="flex items-center gap-2 overflow-x-auto sm:flex-wrap sm:justify-center pb-2 sm:pb-0 scrollbar-none" id="industry-filter-bar" role="tablist">
          <button
            type="button"
            class="filter-btn active shrink-0 rounded-full px-4 py-2 text-xs sm:text-sm font-semibold transition border border-brand-600 bg-brand-600 text-white shadow-sm"
            data-filter="all"
          >
            All Industries (15)
          </button>
          <button
            type="button"
            class="filter-btn shrink-0 rounded-full px-4 py-2 text-xs sm:text-sm font-semibold transition border border-ink-300 bg-white text-ink-700 hover:border-brand-500 hover:text-ink-950"
            data-filter="healthcare"
          >
            Healthcare & Clinics (3)
          </button>
          <button
            type="button"
            class="filter-btn shrink-0 rounded-full px-4 py-2 text-xs sm:text-sm font-semibold transition border border-ink-300 bg-white text-ink-700 hover:border-brand-500 hover:text-ink-950"
            data-filter="hospitality"
          >
            Stays & Dining (2)
          </button>
          <button
            type="button"
            class="filter-btn shrink-0 rounded-full px-4 py-2 text-xs sm:text-sm font-semibold transition border border-ink-300 bg-white text-ink-700 hover:border-brand-500 hover:text-ink-950"
            data-filter="retail"
          >
            Retail & Boutiques (2)
          </button>
          <button
            type="button"
            class="filter-btn shrink-0 rounded-full px-4 py-2 text-xs sm:text-sm font-semibold transition border border-ink-300 bg-white text-ink-700 hover:border-brand-500 hover:text-ink-950"
            data-filter="spaces"
          >
            Real Estate & Spaces (2)
          </button>
