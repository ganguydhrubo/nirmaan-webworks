<style>
  /* Horizontal Tab Scroller Edge Fade Mask */
  @media (max-width: 640px) {
    .scroller-mask {
      mask-image: linear-gradient(to right, transparent, black 16px, black calc(100% - 16px), transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, black 16px, black calc(100% - 16px), transparent);
    }
    .scrollbar-none {
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .scrollbar-none::-webkit-scrollbar {
      display: none;
    }
  }

  /* Spotlight Video Sheen Animation */
  .spotlight-sheen {
    position: absolute;
    top: 0;
    left: -100%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.25),
      transparent
    );
    transform: skewX(-25deg);
    animation: spotlight-sweep 6s infinite ease-in-out;
  }

  @keyframes spotlight-sweep {
    0%, 70% {
      left: -100%;
    }
    100% {
      left: 200%;
    }
  }

  /* Card Sheen on Hover */
  .card-sheen {
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.3),
      transparent
    );
    transform: skewX(-25deg);
    transition: none;
  }

  .industry-card:hover .card-sheen {
    animation: card-sweep 0.75s ease-out forwards;
  }

  @keyframes card-sweep {
    0% {
      left: -100%;
    }
    100% {
      left: 200%;
    }
  }

  /* Smooth card filter transition */
  .industry-card {
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .industry-card.is-hidden {
    display: none !important;
  }

  /* Reduced Motion Compliance */
  @media (prefers-reduced-motion: reduce) {
    .spotlight-sheen,
    .card-sheen,
    .industry-card {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  // Data for the interactive spotlight stage
  const spotlightData = [
    {
      id: "kayal-backwaters",
      title: "Kayal Backwaters Resort",
      industry: "Hotels, Resorts & Homestays",
      city: "Alleppey, Kerala",
      heroText: "Direct guest booking engine saving 18%–22% OTA commissions on every single night.",
      videoSrc: "/videos/demos/kayal-backwaters.webm",
      posterSrc: "/images/demos/kayal-backwaters/thumb.webp",
      demoUrl: "/demos/kayal-backwaters",
      blueprintUrl: "/industries/hotels-resorts",
      statLabel: "Saved on 40 direct bookings",
      statValue: "₹1,42,000+",
      keyFeature: "Direct WhatsApp & Instant Booking Flow",
      chromeUrl: "atittle.com/demos/kayal-backwaters",
    },
    {
      id: "sanjeevani-clinic",
      title: "Sanjeevani Multispecialty Clinic",
      industry: "Healthcare Clinics",
      city: "Nagpur, Maharashtra",
      heroText: "Doctor OPD rosters and night-time appointment requests that land straight in the clinic diary.",
      videoSrc: "/videos/demos/sanjeevani-clinic.webm",
      posterSrc: "/images/demos/sanjeevani-clinic/thumb.webp",
      demoUrl: "/demos/sanjeevani-clinic",
      blueprintUrl: "/industries/healthcare-clinics",
      statLabel: "Booked outside clinic hours",
      statValue: "64% Enquiries",
      keyFeature: "Specialist Roster & Instant WhatsApp OPD",
      chromeUrl: "atittle.com/demos/sanjeevani-clinic",
    },
    {
      id: "anaar-awadhi-table",
      title: "Anaar — The Awadhi Table",
      industry: "Restaurants & Dining",
      city: "Lucknow, Uttar Pradesh",
      heroText: "A rich digital menu and direct table reservation engine with zero 30% aggregator food app cut.",
      videoSrc: "/videos/demos/anaar-awadhi-table.webm",
      posterSrc: "/images/demos/anaar-awadhi-table/thumb.webp",
      demoUrl: "/demos/anaar-awadhi-table",
      blueprintUrl: "/industries/restaurants-cafes",
      statLabel: "Aggregator commission cut saved",
      statValue: "Zero %",
      keyFeature: "Categorised Rupee Menu & Table Booking",
      chromeUrl: "atittle.com/demos/anaar-awadhi-table",
    },
    {
      id: "sunday-objects",
      title: "Sunday Objects",
      industry: "Retail & Boutiques",
      city: "Kochi, Kerala",
      heroText: "A lightning-fast WhatsApp catalog store launched in 48 hours with zero monthly Shopify rent.",
      videoSrc: "/videos/demos/sunday-objects.webm",
      posterSrc: "/images/demos/sunday-objects/thumb.webp",
      demoUrl: "/demos/sunday-objects",
      blueprintUrl: "/industries/retail-d2c",
      statLabel: "Annual platform rent saved",
      statValue: "₹29,880/yr",
      keyFeature: "₹4,999 One-Time Launch · 48h Turnaround",
      chromeUrl: "atittle.com/demos/sunday-objects",
    },
  ];

  function initIndustriesPage() {
    // 1. Spotlight interactive switcher
    const spotlightButtons = document.querySelectorAll<HTMLButtonElement>(".spotlight-tab-btn");
    const spotlightVideo = document.getElementById("spotlight-video") as HTMLVideoElement | null;
    const spotlightPoster = document.getElementById("spotlight-poster") as HTMLImageElement | null;
    const spotlightTitle = document.getElementById("spotlight-title");
    const spotlightCity = document.getElementById("spotlight-city");
    const spotlightIndustry = document.getElementById("spotlight-industry");
    const spotlightHeroText = document.getElementById("spotlight-hero-text");
    const spotlightStatLabel = document.getElementById("spotlight-stat-label");
    const spotlightStatValue = document.getElementById("spotlight-stat-value");
    const spotlightKeyFeature = document.getElementById("spotlight-key-feature");
    const spotlightChromeUrl = document.getElementById("spotlight-chrome-url");
    const spotlightOpenLink = document.getElementById("spotlight-open-link") as HTMLAnchorElement | null;
    const spotlightPrimaryCta = document.getElementById("spotlight-primary-cta") as HTMLAnchorElement | null;
    const spotlightBlueprintCta = document.getElementById("spotlight-blueprint-cta") as HTMLAnchorElement | null;

    spotlightButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-spotlight-id");
        const data = spotlightData.find((d) => d.id === id);
        if (!data) return;

        // Update active tab styles
        spotlightButtons.forEach((b) => {
          b.setAttribute("aria-selected", "false");
          b.className = "spotlight-tab-btn rounded-lg px-3.5 py-2 text-xs font-semibold transition border bg-cream text-ink-700 border-ink-200 hover:border-brand-400 hover:text-ink-950";
        });
        btn.setAttribute("aria-selected", "true");
        btn.className = "spotlight-tab-btn rounded-lg px-3.5 py-2 text-xs font-semibold transition border bg-brand-600 text-white border-brand-600 shadow-sm";

        // Update Spotlight DOM
        if (spotlightPoster) spotlightPoster.src = data.posterSrc;
        if (spotlightVideo) {
          spotlightVideo.src = data.videoSrc;
          spotlightVideo.play().catch(() => {});
        }
        if (spotlightTitle) spotlightTitle.textContent = data.title;
        if (spotlightCity) spotlightCity.textContent = data.city;
        if (spotlightIndustry) spotlightIndustry.textContent = data.industry;
        if (spotlightHeroText) spotlightHeroText.textContent = data.heroText;
        if (spotlightStatLabel) spotlightStatLabel.textContent = data.statLabel;
        if (spotlightStatValue) spotlightStatValue.textContent = data.statValue;
        if (spotlightKeyFeature) spotlightKeyFeature.textContent = data.keyFeature;
        if (spotlightChromeUrl) spotlightChromeUrl.textContent = data.chromeUrl;
        if (spotlightOpenLink) spotlightOpenLink.href = data.demoUrl;
        if (spotlightPrimaryCta) spotlightPrimaryCta.href = data.demoUrl;
        if (spotlightBlueprintCta) spotlightBlueprintCta.href = data.blueprintUrl;
      });
    });

    // 2. Category Filter Tabs
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".industry-card");

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.getAttribute("data-filter") || "all";

        // Update button active state
        filterButtons.forEach((b) => {
          b.classList.remove("active", "bg-brand-600", "text-white", "border-brand-600");
          b.classList.add("bg-white", "text-ink-700", "border-ink-300");
        });
        btn.classList.add("active", "bg-brand-600", "text-white", "border-brand-600");
        btn.classList.remove("bg-white", "text-ink-700", "border-ink-300");

        // Filter cards
        cards.forEach((card) => {
          const category = card.getAttribute("data-category");
          if (filter === "all" || category === filter) {
            card.classList.remove("is-hidden");
          } else {
            card.classList.add("is-hidden");
          }
        });
      });
    });

    // 3. Looping Motion Reels for Grid Cards
    const isTouch = window.matchMedia("(hover: none)").matches;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!prefersReducedMotion) {
      cards.forEach((card) => {
        const video = card.querySelector<HTMLVideoElement>("[data-demo-video]");
        if (!video) return;

        const playVideo = () => {
          video.currentTime = 0;
          video.play().catch(() => {});
        };

        const pauseVideo = () => {
          video.pause();
          video.currentTime = 0;
        };

        if (isTouch) {
          // On mobile, autoplay when card scrolls into center view
          video.preload = "metadata";
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  video.style.opacity = "1";
                  playVideo();
                } else {
                  video.style.opacity = "0";
                  pauseVideo();
                }
              });
            },
            { threshold: 0.55 }
          );
          observer.observe(card);
        } else {
          // Desktop: hover activate
          card.addEventListener("mouseenter", playVideo);
          card.addEventListener("mouseleave", pauseVideo);
        }
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initIndustriesPage);
  } else {
    initIndustriesPage();
  }
  document.addEventListener("astro:page-load", initIndustriesPage);
</script>
