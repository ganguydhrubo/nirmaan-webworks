    category: "healthcare",
    startingPrice: "₹18,000",
    turnaround: "10–12 days",
    bleedSource: "Patient pricing anxiety & hidden charges leading to lost calls",
    keyCapabilities: ["Transparent treatment catalogue with rupee ranges", "Named dentist credentials & anxiety-reducing clinic tour", "Integrated appointment booking & financing guidance"],
    highlightBadge: "Dental Practices",
  },
  {
    slug: "restaurants-cafes",
    category: "hospitality",
    startingPrice: "₹12,000",
    turnaround: "7–10 days",
    bleedSource: "Zomato & Swiggy (25%–32% order commission + ad fees)",
    keyCapabilities: ["Full categorised rupee menu — never a blurry PDF", "Direct table reservation form straight to WhatsApp", "Google Maps dining schema & high-res food visualizer"],
    highlightBadge: "Dining & Cafés",
  },
  {
    slug: "jewellery",
    category: "retail",
    startingPrice: "₹24,000",
    turnaround: "12–14 days",
    bleedSource: "Lost Instagram DM conversations & zero catalog structure",
    keyCapabilities: ["Collection filters by category, budget & carat", "Detailed product pages with weight, purity & care notes", "Personal WhatsApp enquiry handoff for showroom visits"],
    highlightBadge: "Luxury Retail",
  },
  {
    slug: "interior-design",
    category: "spaces",
    startingPrice: "₹18,000",
    turnaround: "10–12 days",
    bleedSource: "Unqualified bargain enquiries with no scope or floor area",
    keyCapabilities: ["Deep project case studies with brief, plan & execution", "Residential vs commercial project categorization", "Upfront budget planner with explicit scope boundaries"],
    highlightBadge: "Architecture & Studios",
  },
  {
    slug: "salon-spa",
    category: "lifestyle",
    startingPrice: "₹12,000",
    turnaround: "7–10 days",
    bleedSource: "Urban Company aggregator cuts & endless DM scheduling back-and-forth",
    keyCapabilities: ["Complete service menu with clear duration & rupee pricing", "Interactive visit planner combining hair, skin & rituals", "One-tap appointment slot booking to WhatsApp"],
    highlightBadge: "Beauty & Wellness",
  },
  {
    slug: "professional-services",
    category: "services",
    startingPrice: "₹18,000",
    turnaround: "10–12 days",
    bleedSource: "Commoditization on freelance platforms & generic agency templates",
    keyCapabilities: ["Interactive client brief builder for qualified inbound", "Clear practice area scope with deliverable boundaries", "Editorial thought leadership & case study architecture"],
    highlightBadge: "Consulting & Legal",
  },
  {
    slug: "fitness-studios",
    category: "lifestyle",
    startingPrice: "₹12,000",
    turnaround: "7–10 days",
    bleedSource: "Aggregator fitness passes taking 30%+ cut on walk-in members",
    keyCapabilities: ["Interactive weekly class timetable with format filters", "First-visit walkthrough: equipment, arrival & coaching notes", "Transparent rupee membership plans with zero hidden fees"],
    highlightBadge: "Gyms & Studios",
  },
  {
    slug: "events-photography",
    category: "lifestyle",
    startingPrice: "₹16,000",
