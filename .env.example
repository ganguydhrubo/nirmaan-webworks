# Copy this file to .env for local dev (Astro) and to .dev.vars for `wrangler dev`.
# In production, set every secret with `wrangler secret put <NAME>` — never in wrangler.jsonc.
# Non-secret business facts (name, phone, WhatsApp number, address, pricing) live in
# config/site.ts, NOT here — this file only holds environment-specific values and secrets.

# --- Email (Resend) -----------------------------------------------------
# Required in production. Build/API will fail loudly if missing when EMAIL_PROVIDER=resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_PROVIDER=resend
# resend | smtp | none  (none disables sending but still persists leads — dev/test only)

# --- Cloudflare Turnstile ------------------------------------------------
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- AI (optional, OFF by default; see ARCHITECTURE.md Section 9) -------
AI_PROVIDER=none
# gemini | groq | none
GROQ_API_KEY=
GEMINI_API_KEY=

# --- AI Website Builder (/free-website-builder) ---------------------------
# Providers are tried in this order; any without a key is skipped. If one is
# rate-limited, down, slow or returns unusable output, the next one answers.
# Keys: GROQ_API_KEY and GEMINI_API_KEY above, plus:
OPENROUTER_API_KEY=
BUILDER_AI_PROVIDERS=groq,gemini,openrouter
# Optional model overrides (defaults shown):
# BUILDER_GROQ_MODEL=openai/gpt-oss-120b
# BUILDER_GEMINI_MODEL=gemini-flash-latest
# BUILDER_OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# Free-usage limits (AI requests per UTC day):
BUILDER_AI_DAILY_LIMIT_PER_IP=5
BUILDER_AI_DAILY_LIMIT_GLOBAL=60

# --- Rate limiting (non-secret, but environment-tunable) -----------------
ENQUIRY_RATE_LIMIT_PER_IP_PER_HOUR=5
ENQUIRY_RATE_LIMIT_PER_PHONE_PER_DAY=3
ENQUIRY_RATE_LIMIT_GLOBAL_PER_HOUR=40
RESEND_DAILY_CAP=100

# --- Misc ------------------------------------------------------------------
PUBLIC_SITE_URL=https://atittle.com
IP_HASH_SALT=change-me-to-a-random-32-byte-hex-string-per-environment
